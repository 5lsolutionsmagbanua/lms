<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const usernameFullEl = document.querySelector(".username-full");
    const usernameInitialsEl = document.querySelector(".username-initials");

    try {
      const response = await fetch("/topbar/api/user");

      // Session is gone (logged out, expired, or destroyed on another
      // device) — send the browser straight to login instead of
      // leaving a dead/stale page rendered on screen.
      if (response.status === 401) {
        window.location.href = "/login";
        return;
      }

      if (!response.ok) {
        setUsername("Guest");
        return;
      }

      const user = await response.json();

      console.log("User Object:", user);

      const username =
        user.full_name ||
        user.name ||
        user.username ||
        `${user.first_name || ""} ${user.last_name || ""}`.trim() ||
        "Guest";

      setUsername(username);
    } catch (err) {
      console.error("Error fetching user:", err);
      setUsername("Guest");
    }

    function setUsername(fullName) {
      const initials = fullName
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .map((word) => word[0])
        .slice(0, 2)
        .join("")
        .toUpperCase();

      if (usernameFullEl) usernameFullEl.textContent = fullName;
      if (usernameInitialsEl) usernameInitialsEl.textContent = initials || "?";
    }
  });
</script>
