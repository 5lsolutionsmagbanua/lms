<script>
  function previewDriverPhoto(event) {
    const reader = new FileReader();

    reader.onload = function () {
      document.getElementById("driverPreview").src = reader.result;
    };

    reader.readAsDataURL(event.target.files[0]);
  }
</script>

<script>
  document.querySelectorAll('[data-bs-toggle="collapse"]').forEach((item) => {
    item.addEventListener("click", function () {
      localStorage.setItem("openMenu", this.getAttribute("href"));
    });
  });
  document.addEventListener("DOMContentLoaded", function () {
    const openMenu = localStorage.getItem("openMenu");

    if (openMenu) {
      const menu = document.querySelector(openMenu);

      if (menu) {
        menu.classList.add("show");
      }
    }
  });

  $("#stockStatusTabs .nav-link").on("click", function () {
    $("#stockStatusTabs .nav-link").removeClass("active");

    $(this).addClass("active");

    const status = $(this).data("status");

    // Example
    loadStocks(status);
  });
</script>

<script>
  (function () {
    try {
      var stored = localStorage.getItem("theme");
      var theme =
        stored ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.setAttribute("data-theme", theme);
    } catch (e) {
      /* localStorage blocked (private mode, etc.) — fall back to light */
    }
  })();
</script>

