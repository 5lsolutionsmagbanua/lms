<!DOCTYPE html>
<html lang="en">
<style>
  /* Additive styles for the new module monitoring tiles.
     Add these alongside your existing metric-card / panel / activity-item CSS. */
  .module-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem;
    border-radius: 0.6rem;
    background: var(--bs-tertiary-bg, #f8f9fa);
    color: inherit;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .module-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
  .module-tile-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.95rem;
  }
  .module-tile-value {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .module-tile-label {
    font-size: 0.8rem;
    color: var(--bs-secondary-color, #6c757d);
  }
  .module-tile-alert {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border-radius: 1rem;
    background: #dc3545;
    color: #fff;
  }
  .chart-column {
    height: calc(var(--bar-height, 0) * 1%);
  }
</style>

  <head>
    <%- include('../components/header.ejs') %>
  </head>
