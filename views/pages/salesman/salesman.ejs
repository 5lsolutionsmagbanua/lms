<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Panel -->
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-briefcase"></i>
            <span style="font-weight: 700; color: #000">
              Salesman Management
            </span>
          </h2>
          <p class="text-muted mb-0">
            Manage salesman assignments and records.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Sync
          </button>

          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addSalesmanModal"
          >
            <i class="bi bi-plus-circle"></i> Add Salesman
          </button>

          <button class="btn btn-sm btn-success">
            <i class="bi bi-upload"></i> Upload Excel
          </button>

          <button class="btn btn-sm btn-dark">
            <i class="bi bi-download"></i> Download Excel
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search salesman..."
          data-table-search="salesmanTable"
        />
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="salesmanTable"
          data-searchable-table
        >
          <thead class="table-dark">
            <tr>
              <th>Employee ID</th>
              <th>Full Name</th>
              <th>Salesman ID</th>
              <th>Created At</th>
              <th>Created By</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">EMP-0001</td>
              <td>Juan Dela Cruz</td>
              <td>SAL-0001</td>
              <td>May 25, 2026</td>
              <td>Admin</td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">EMP-0002</td>
              <td>Maria Santos</td>
              <td>SAL-0002</td>
              <td>May 24, 2026</td>
              <td>Admin</td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">EMP-0003</td>
              <td>Mark Cruz</td>
              <td>SAL-0003</td>
              <td>May 23, 2026</td>
              <td>Admin</td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
