<!-- =====================================================
ADD DRIVER MODAL
===================================================== -->
<div class="modal fade" id="addDriverModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-person-plus"></i> Add Driver
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12"><h6>Personal Information</h6></div>

          <div class="col-md-3">
            <label>Select User *</label>
            <select class="form-select" id="add_user_id">
              <option value="">Select Driver from Users</option>
            </select>
          </div>

          <div class="col-md-3">
            <label>Mobile</label>
            <input class="form-control" id="add_mobile_number" />
          </div>

          <div class="col-md-3">
            <label>Date Hired</label>
            <input type="date" class="form-control" id="add_date_hired" />
          </div>

          <div class="col-12">
            <label>Address</label>
            <textarea class="form-control" id="add_address"></textarea>
          </div>

          <div class="col-12"><h6>License</h6></div>

          <div class="col-md-4">
            <label>License No</label>
            <input class="form-control" id="add_license_number" />
          </div>

          <div class="col-md-4">
            <label>License Type</label>
            <select class="form-select" id="add_license_type">
              <option value="Professional">Professional</option>
              <option value="Non-Professional">Non-Professional</option>
            </select>
          </div>

          <div class="col-md-4">
            <label>Expiry</label>
            <input type="date" class="form-control" id="add_license_expiry" />
          </div>

          <div class="col-12"><h6>Status</h6></div>

          <div class="col-md-4">
            <label>Attendance</label>
            <select class="form-select" id="add_attendance_status">
              <option value="Present">Present</option>
              <option value="Absent">Absent</option>
              <option value="Rest Day">Rest Day</option>
              <option value="Leave">Leave</option>
            </select>
          </div>

          <div class="col-md-4">
            <label>Availability</label>
            <select class="form-select" id="add_availability_status" disabled>
              <option value="Available" selected>Available</option>
            </select>
            <div class="form-text">New drivers always start as Available.</div>
          </div>

          <div class="col-md-4">
            <label>Status</label>
            <select class="form-select" id="add_is_active">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>

          <div class="col-12"><h6>Emergency Contact</h6></div>

          <div class="col-md-6">
            <input
              class="form-control"
              id="add_emergency_contact_name"
              placeholder="Contact Name"
            />
          </div>

          <div class="col-md-6">
            <input
              class="form-control"
              id="add_emergency_contact_number"
              placeholder="Contact Number"
            />
          </div>

          <div class="col-12">
            <textarea
              class="form-control"
              id="add_remarks"
              placeholder="Remarks"
            ></textarea>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary" id="saveDriverBtn">Save</button>
      </div>
    </div>
  </div>
</div>

