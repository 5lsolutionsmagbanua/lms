<!-- =====================================================
BULK UPLOAD DRIVERS MODAL
===================================================== -->
<div class="modal fade" id="bulkUploadDriverModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-cloud-upload"></i> Bulk Upload Drivers
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div
          class="d-flex align-items-start gap-3 p-3 mb-3 rounded bg-light border"
        >
          <i class="bi bi-file-earmark-spreadsheet fs-3 text-primary"></i>
          <div class="flex-grow-1">
            <div class="fw-semibold">Start from the template</div>
            <p class="text-muted small mb-2">
              Download the Excel template, fill in one row per driver, then
              upload it below. Required columns are marked with an asterisk.
            </p>
            <button
              class="btn btn-outline-primary btn-sm"
              id="downloadDriverTemplateBtn"
              type="button"
            >
              <i class="bi bi-download"></i> Download Template
            </button>
          </div>
        </div>

        <label class="form-label">Upload Completed File</label>
        <input
          type="file"
          class="form-control"
          id="bulkUploadDriverFile"
          accept=".xlsx,.xls"
        />
        <div class="form-text">Accepted formats: .xlsx, .xls</div>

        <div id="bulkUploadDriverReport" class="mt-3 d-none">
          <div id="bulkUploadDriverSummary"></div>
          <div id="bulkUploadDriverErrors" class="small text-danger"></div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button class="btn btn-primary" id="bulkUploadDriverSubmitBtn">
          <i class="bi bi-cloud-upload"></i> Upload File
        </button>
      </div>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 p-4 border-bottom"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-person-vcard"></i>
            Driver Management
          </h2>

          <p class="text-muted mb-0">
            Manage drivers, attendance, availability, and dispatch assignments
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button
            class="btn btn-outline-secondary rounded-pill fw-semibold"
            id="printDriverBtn"
            type="button"
          >
            <i class="bi bi-printer"></i> Print
          </button>

          <button
            class="btn btn-outline-success rounded-pill fw-semibold"
            id="exportDriverExcelBtn"
            type="button"
          >
            <i class="bi bi-file-earmark-excel"></i> Export Excel
          </button>

          <button
            class="btn btn-outline-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#bulkUploadDriverModal"
            type="button"
          >
            <i class="bi bi-cloud-upload"></i> Bulk Upload
          </button>

          <button
            class="btn btn-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#addDriverModal"
          >
            <i class="bi bi-plus-circle"></i>
            Add Driver
          </button>
        </div>
      </div>

      <!-- SEARCH / ENTRIES PER PAGE -->
      <div class="row px-3 pt-3 g-2 align-items-center justify-content-between">
        <div class="col-md-4">
          <input
            type="search"
            class="form-control form-control-sm"
            id="driverSearch"
            placeholder="Search driver..."
          />
        </div>

        <div class="col-md-auto ms-auto">
          <div class="d-flex align-items-center gap-2">
            <label for="driverEntriesPerPage" class="small text-muted mb-0">
              Show
            </label>
            <select
              class="form-select form-select-sm"
              id="driverEntriesPerPage"
              style="width: auto"
            >
              <option value="4" selected>4</option>
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
            <span class="small text-muted">entries</span>
          </div>
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-responsive px-3 pb-2 pt-2">
        <table class="table align-middle table-hover" id="driverTable">
          <thead>
            <tr>
              <th>Driver ID</th>
              <th>Name</th>
              <th>Mobile</th>
              <th>License No.</th>
              <th>License Expiry</th>

              <th>Attendance</th>
              <th>Availability</th>

              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody id="driverTableBody"></tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div
        class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 pb-3"
      >
        <div id="driverPaginationInfo" class="small text-muted"></div>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="driverPagination"></ul>
        </nav>
      </div>
    </section>
  </div>
</main>
