<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  /* ============================================================
     DRIVER REGISTRATION PAGE SCRIPT

     CHANGES IN THIS PASS
     ------------------------------------------------------------
     1. Pagination added to the driver table, matching the User
        Roles module: page/limit/search state, limit defaults to
        4, entries-per-page selector, prev/next + numbered pages.

     2. Fixed-height table. Fewer than `limit` rows (including the
        1-driver case) are padded with invisible filler rows so the
        table never resizes as data/pages change — same
        fillerRow() approach as the Roles module.

     3. Print and Export to Excel added, mirroring the Roles
        module's implementation (`/driverRegistration/export-excel`
        for the download, a formatted print window for print).

     4. Bulk Upload added: a modal with a "Download Template"
        button (hits `/driverRegistration/download-template`) plus
        a file upload that posts to
        `/driverRegistration/bulk-upload` and shows a report panel.

     5. Delete action removed entirely — the Actions column now
        only has View and Edit. The Swal confirm-delete dialog and
        its click handler are gone.

     6. Every server response — success or error — now goes through
        the shared `toast()` helper, including the "Not Allowed"
        system-managed-status warning, which used to be a full
        blocking Swal modal.
     ============================================================ */

  // Statuses that can only be set by the shipment dispatch flow,
  // never manually from this screen.
  const SYSTEM_MANAGED_STATUSES = [
    "Assigned",
    "Driving",
    "Delivering",
    "Returning",
  ];

  $(function () {
    console.log("✅ Driver module loaded");

    // =====================================================
    // STATE
    // =====================================================
    const state = (window.__driversState = { page: 1, limit: 4, search: "" });

    init();

    function init() {
      loadDrivers();
      loadDriverUserOptions();
      bindEvents();
    }

    // =====================================================
    // 🔥 SWEETALERT HELPER (every response renders as a toast)
    // =====================================================
    function toast(icon, title) {
      Swal.fire({
        toast: true,
        position: "top-end",
        icon: icon,
        title: title,
        showConfirmButton: false,
        timer: 2000,
        timerProgressBar: true,
      });
    }

    // =====================================================
    // LOAD USERS (for driver dropdown) — Driver role only,
    // excluding users already linked to a driver record.
    // =====================================================
    function loadDriverUserOptions() {
      console.log(
        "[driverRegistration] Loading users + existing drivers for dropdown...",
      );

      $.when(
        $.get("/users/get-users"),
        // Fetch every driver record (not just the current page) so
        // the assigned-user filter below is accurate regardless of
        // pagination state.
        $.get("/driverRegistration/get-drivers", { page: 1, limit: 100000 }),
      )
        .done(function (usersRes, driversRes) {
          const users = usersRes[0] || [];
          const drivers = normalize(driversRes[0]);

          // user_ids already linked to a driver record — these
          // users must NOT appear as selectable in the dropdown.
          const assignedUserIds = new Set(
            drivers
              .map((d) => d.user_id)
              .filter((id) => id !== null && id !== undefined)
              .map((id) => String(id)),
          );

          console.log(
            `[driverRegistration] -> ${assignedUserIds.size} user(s) already linked to a driver record:`,
            [...assignedUserIds],
          );

          // Only show users whose assigned role is "Driver".
          const driverRoleUsers = users.filter(
            (u) => (u.role_name || "").trim().toLowerCase() === "driver",
          );

          // Exclude users who already have a driver record.
          const availableDriverUsers = driverRoleUsers.filter(
            (u) => !assignedUserIds.has(String(u.id)),
          );

          console.log(
            `[driverRegistration] -> ${availableDriverUsers.length} available driver-role user(s) ` +
              `(filtered out ${driverRoleUsers.length - availableDriverUsers.length} already-assigned, ` +
              `out of ${driverRoleUsers.length} driver-role users / ${users.length} total users)`,
          );

          let options = `<option value="">Select Driver from Users</option>`;

          if (!availableDriverUsers.length) {
            console.warn(
              "[driverRegistration] No available (unassigned) driver-role users found.",
            );
            options = `<option value="">No available driver users</option>`;
          }

          availableDriverUsers.forEach((u) => {
            const fullName = [u.first_name, u.last_name]
              .filter(Boolean)
              .join(" ");

            options += `
          <option
            value="${u.id}"
            data-first-name="${u.first_name || ""}"
            data-middle-name="${u.middle_name || ""}"
            data-last-name="${u.last_name || ""}"
          >
            ${fullName}${u.email ? " (" + u.email + ")" : ""}
          </option>
        `;
          });

          $("#add_user_id").html(options);
        })
        .fail(function (xhr) {
          console.error(
            "[driverRegistration] Failed to load users/drivers for dropdown",
            xhr,
          );
        });
    }

    // =====================================================
    // HELPERS
    // =====================================================
    function formatDate(date) {
      if (!date) return "-";
      const d = new Date(date);
      if (isNaN(d)) return "-";
      return d.toLocaleDateString();
    }

    function formatDateInput(date) {
      if (!date) return "";
      const d = new Date(date);
      if (isNaN(d)) return "";
      return d.toISOString().split("T")[0];
    }

    function fullName(d) {
      return (
        [d.first_name, d.middle_name, d.last_name]
          .filter(Boolean)
          .join(" ")
          .replace(/\s+/g, " ")
          .trim() || "-"
      );
    }

    function driverCode(d) {
      return d.driver_code || `DRV-${d.id}`;
    }

    function normalize(res) {
      return (
        res?.data || res?.rows || res?.result || (Array.isArray(res) ? res : [])
      );
    }

    // Returns true (and shows a toast warning) if the given
    // availability status is not allowed to be set manually.
    function isSystemManagedStatus(status, { warn = true } = {}) {
      const blocked = SYSTEM_MANAGED_STATUSES.includes(status);

      if (blocked && warn) {
        console.warn(
          `[driverRegistration] Blocked manual status selection: "${status}"`,
        );
        toast(
          "warning",
          `"${status}" is set automatically when a shipment is assigned — it can't be chosen manually.`,
        );
      }

      return blocked;
    }

    // Blank, invisible row matching the live column count (9), used
    // to pad the table so its height never shifts between a single
    // row and a full page.
    function fillerRow() {
      return `
        <tr>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
        </tr>
      `;
    }

    // =====================================================
    // LOAD DRIVERS (paginated + searchable)
    // =====================================================
    function loadDrivers() {
      console.log(
        `[driverRegistration] Loading drivers (page ${state.page}, limit ${state.limit}, search "${state.search}")...`,
      );

      $.ajax({
        url: "/driverRegistration/get-drivers",
        method: "GET",
        data: { page: state.page, limit: state.limit, search: state.search },
        success: function (res) {
          const drivers = normalize(res);
          console.log(
            `[driverRegistration] -> ${drivers.length} driver(s) loaded`,
          );
          renderDrivers(drivers);
          renderDriverPagination(
            res.pagination || {
              page: 1,
              limit: state.limit,
              total: drivers.length,
              totalPages: 1,
            },
          );
        },
        error: function (xhr) {
          console.error("[driverRegistration] Failed to load drivers", xhr);
          toast("error", "Failed to load drivers");
        },
      });
    }

    // =====================================================
    // RENDER TABLE
    // =====================================================
    function renderDrivers(drivers) {
      const target = state.limit;
      let html = "";

      if (!drivers.length) {
        html += `
          <tr>
            <td colspan="9" class="text-center text-muted py-4">
              <i class="bi bi-inbox fs-4 d-block mb-1"></i>
              No drivers found
            </td>
          </tr>
        `;
        for (let i = 1; i < target; i++) html += fillerRow();
        $("#driverTableBody").html(html);
        return;
      }

      drivers.forEach((d) => {
        html += `
          <tr>
            <td>${driverCode(d)}</td>
            <td>${fullName(d)}</td>
            <td>${d.mobile_number || "-"}</td>
            <td>${d.license_number || "-"}</td>
            <td>${formatDate(d.license_expiry)}</td>

            <td><span class="badge bg-${getAttendanceColor(d.attendance_status)}">${d.attendance_status || "Present"}</span></td>
            <td><span class="badge bg-${getAvailabilityColor(d.availability_status)}">${d.availability_status || "Available"}</span></td>

            <td>
              <span class="badge bg-${d.is_active == 1 ? "success" : "danger"}">
                ${d.is_active == 1 ? "Active" : "Inactive"}
              </span>
            </td>

            <td class="text-end">
              <button class="btn btn-info btn-sm viewDriverBtn" data-id="${d.id}" title="View">
                <i class="bi bi-eye"></i>
              </button>

              <button class="btn btn-warning btn-sm editDriverBtn" data-id="${d.id}" title="Edit">
                <i class="bi bi-pencil"></i>
              </button>
            </td>
          </tr>
        `;
      });

      for (let i = drivers.length; i < target; i++) html += fillerRow();

      $("#driverTableBody").html(html);
    }

    function renderDriverPagination(pagination) {
      const { page, totalPages, total, limit } = pagination;

      if (!total) {
        $("#driverPaginationInfo").text("No entries");
        $("#driverPagination").html("");
        return;
      }

      const start = (page - 1) * limit + 1;
      const end = Math.min(page * limit, total);
      $("#driverPaginationInfo").text(
        `Showing ${start}-${end} of ${total} entries`,
      );

      let html = "";
      html += `<li class="page-item ${page <= 1 ? "disabled" : ""}">
                <button class="page-link" data-page="${page - 1}">Prev</button>
              </li>`;

      const windowSize = 5;
      let startPage = Math.max(1, page - Math.floor(windowSize / 2));
      let endPage = Math.min(totalPages, startPage + windowSize - 1);
      startPage = Math.max(1, endPage - windowSize + 1);

      if (startPage > 1) {
        html += `<li class="page-item"><button class="page-link" data-page="1">1</button></li>`;
        if (startPage > 2)
          html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
      }

      for (let p = startPage; p <= endPage; p++) {
        html += `<li class="page-item ${p === page ? "active" : ""}">
                  <button class="page-link" data-page="${p}">${p}</button>
                </li>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1)
          html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
        html += `<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`;
      }

      html += `<li class="page-item ${page >= totalPages ? "disabled" : ""}">
                <button class="page-link" data-page="${page + 1}">Next</button>
              </li>`;

      $("#driverPagination").html(html);
    }

    // =====================================================
    // ADD DRIVER
    // =====================================================
    function resetAddDriverForm() {
      $("#addDriverModal").find("input, textarea").val("");
      $("#addDriverModal").find("select").prop("selectedIndex", 0);
    }

    $(document).on("click", "#saveDriverBtn", function (e) {
      e.preventDefault();

      const $selectedUser = $("#add_user_id option:selected");

      // NOTE: name fields are no longer free text — they come from the
      // selected user record (created via User Management), pulled off
      // the option's data attributes.
      const payload = {
        user_id: $("#add_user_id").val(),
        first_name: $selectedUser.data("first-name") || "",
        middle_name: $selectedUser.data("middle-name") || "",
        last_name: $selectedUser.data("last-name") || "",
        mobile_number: $("#add_mobile_number").val().trim(),
        date_hired: $("#add_date_hired").val() || null,
        address: $("#add_address").val().trim(),
        license_number: $("#add_license_number").val().trim(),
        license_type: $("#add_license_type").val(),
        license_expiry: $("#add_license_expiry").val() || null,
        attendance_status: $("#add_attendance_status").val(),
        is_active: $("#add_is_active").val(),
        emergency_contact_name: $("#add_emergency_contact_name").val().trim(),
        emergency_contact_number: $("#add_emergency_contact_number")
          .val()
          .trim(),
        remarks: $("#add_remarks").val().trim(),
      };

      // ================= VALIDATION =================
      if (!$("#add_user_id").val()) {
        console.warn("[driverRegistration] Add rejected: no user selected");
        return toast("warning", "Please select a driver from the user list.");
      }

      if (!payload.mobile_number) {
        console.warn("[driverRegistration] Add rejected: no mobile number");
        return toast("warning", "Mobile number is required.");
      }

      if (!payload.license_number) {
        console.warn("[driverRegistration] Add rejected: no license number");
        return toast("warning", "License number is required.");
      }

      if (!payload.license_type) {
        console.warn("[driverRegistration] Add rejected: no license type");
        return toast("warning", "License type is required.");
      }

      console.log("========== ADD DRIVER PAYLOAD ==========");
      console.log(payload);
      console.log("=========================================");

      $.ajax({
        url: "/driverRegistration",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),

        beforeSend: function () {
          console.log("[driverRegistration] Sending add-driver request...");
          $("#saveDriverBtn")
            .prop("disabled", true)
            .html(
              '<span class="spinner-border spinner-border-sm"></span> Saving...',
            );
        },

        success: function (res) {
          console.log("[driverRegistration] Driver added:", res);

          $("#addDriverModal").modal("hide");
          resetAddDriverForm();

          window.__driversState.page = 1;
          loadDrivers();
          // Refresh the user dropdown so the just-registered user
          // immediately disappears from the "available" list.
          loadDriverUserOptions();

          toast("success", res.message || "Driver added successfully");
        },

        error: function (err) {
          console.error("[driverRegistration] Add driver failed", err);

          const message = err.responseJSON?.message || "Failed to add driver";

          // Duplicate-user case: the server rejected because this
          // user already has a driver record (race condition, or a
          // stale dropdown that hadn't refreshed yet).
          if (err.status === 400 && /already registered/i.test(message)) {
            console.warn(
              "[driverRegistration] Duplicate driver-user rejected by server — refreshing dropdown",
            );
            loadDriverUserOptions();
          }

          toast("error", message);
        },

        complete: function () {
          $("#saveDriverBtn").prop("disabled", false).html("Save");
        },
      });
    });

    // =====================================================
    // PRINT
    // =====================================================
    function printDrivers() {
      $.ajax({
        url: "/driverRegistration/get-drivers",
        method: "GET",
        data: { page: 1, limit: 100000, search: state.search },

        success: function (res) {
          renderDriverPrintReport(normalize(res), res.pagination?.total ?? normalize(res).length);
        },

        error: function () {
          toast("error", "Failed to prepare the report.");
        },
      });
    }

    function renderDriverPrintReport(data, total) {
      let rows = "";
      data.forEach((d, i) => {
        rows += `
          <tr class="${i % 2 === 0 ? "even" : ""}">
            <td>${driverCode(d)}</td>
            <td>${fullName(d)}</td>
            <td>${d.mobile_number || "-"}</td>
            <td>${d.license_number || "-"}</td>
            <td>${formatDate(d.license_expiry)}</td>
            <td>${d.attendance_status || "Present"}</td>
            <td>${d.availability_status || "Available"}</td>
            <td>${d.is_active == 1 ? "Active" : "Inactive"}</td>
          </tr>
        `;
      });

      const printWindow = window.open("", "_blank", "width=1100,height=700");

      printWindow.document.write(`
        <html>
        <head>
          <title>Driver Registration Report</title>
          <style>
            * { box-sizing: border-box; }
            body { font-family: 'Segoe UI', Arial, sans-serif; padding: 32px; color: #1f2937; }
            .report-header {
              display: flex; justify-content: space-between; align-items: center;
              border-bottom: 3px solid #2563eb; padding-bottom: 12px; margin-bottom: 4px;
            }
            .report-header h1 { font-size: 22px; margin: 0; color: #1e3a8a; }
            .report-header .badge {
              background: #2563eb; color: #fff; padding: 6px 14px;
              border-radius: 999px; font-size: 12px; font-weight: bold;
            }
            .meta { display: flex; justify-content: space-between; color: #6b7280; font-size: 12px; margin: 8px 0 20px; }
            table { width: 100%; border-collapse: collapse; font-size: 12px; }
            thead th { background: #2563eb; color: #fff; text-align: left; padding: 10px 8px; }
            tbody td { padding: 8px; border-bottom: 1px solid #e5e7eb; }
            tbody tr.even { background: #f3f4f6; }
            .report-footer { margin-top: 24px; text-align: right; font-size: 11px; color: #9ca3af; }
            @media print { body { padding: 12px; } }
          </style>
        </head>
        <body>
          <div class="report-header">
            <h1>Driver Registration Report</h1>
            <span class="badge">${total} Total Driver${total === 1 ? "" : "s"}</span>
          </div>
          <div class="meta">
            <span>Generated on ${new Date().toLocaleString()}</span>
            ${state.search ? `<span>Filtered by: "${escapeHtml(state.search)}"</span>` : ""}
          </div>
          <table>
            <thead>
              <tr>
                <th>Driver Code</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>License No.</th>
                <th>License Expiry</th>
                <th>Attendance</th>
                <th>Availability</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
          <div class="report-footer">LMS &mdash; Driver Management</div>
        </body>
        </html>
      `);

      printWindow.document.close();

      printWindow.onload = function () {
        printWindow.focus();
        setTimeout(function () {
          printWindow.print();
          printWindow.onafterprint = function () {
            printWindow.close();
          };
        }, 400);
      };
    }

    function escapeHtml(str) {
      return $("<div>")
        .text(str == null ? "" : str)
        .html();
    }

    // =====================================================
    // EXPORT EXCEL
    // =====================================================
    function exportDriverExcel() {
      const params = new URLSearchParams();
      if (state.search) params.set("search", state.search);
      window.location.href = `/driverRegistration/export-excel?${params.toString()}`;
    }

    // =====================================================
    // BULK UPLOAD
    // =====================================================
    function submitBulkUpload() {
      const fileInput = document.getElementById("bulkUploadDriverFile");
      const file = fileInput.files[0];

      if (!file) {
        toast("warning", "Please choose a file to upload.");
        return;
      }

      const formData = new FormData();
      formData.append("file", file);

      const $btn = $("#bulkUploadDriverSubmitBtn");
      $btn
        .prop("disabled", true)
        .html(
          '<span class="spinner-border spinner-border-sm"></span> Uploading...',
        );

      $.ajax({
        url: "/driverRegistration/bulk-upload",
        method: "POST",
        data: formData,
        processData: false,
        contentType: false,

        success: function (res) {
          showBulkReport(res.report, res.message);
          window.__driversState.page = 1;
          loadDrivers();
          loadDriverUserOptions();
        },

        error: function (err) {
          const res = err.responseJSON;
          if (res && res.report) {
            showBulkReport(res.report, res.message);
          } else {
            toast("error", res?.message || "Bulk upload failed.");
          }
        },

        complete: function () {
          $btn
            .prop("disabled", false)
            .html('<i class="bi bi-cloud-upload"></i> Upload File');
        },
      });
    }

    function showBulkReport(report, message) {
      $("#bulkUploadDriverReport").removeClass("d-none");

      const summaryColor = report.failed > 0 ? "text-warning" : "text-success";
      $("#bulkUploadDriverSummary")
        .removeClass()
        .addClass(`fw-bold mb-2 ${summaryColor}`)
        .text(message || `${report.success} of ${report.total} imported.`);

      if (report.errors && report.errors.length > 0) {
        let list = "<ul class='ps-3 mb-0'>";
        report.errors.forEach((e) => {
          list += `<li>Row ${e.row}: ${escapeHtml(e.message)}</li>`;
        });
        list += "</ul>";
        $("#bulkUploadDriverErrors").html(list);
      } else {
        $("#bulkUploadDriverErrors").html("");
      }

      toast(
        report.failed > 0 ? "warning" : "success",
        message || `${report.success} of ${report.total} imported.`,
      );
    }

    // =====================================================
    // EVENTS
    // =====================================================
    function bindEvents() {
      // ================= SEARCH / PAGE SIZE =================
      let searchTimer = null;
      $("#driverSearch").on("input", function () {
        const val = $(this).val();
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.search = val.trim();
          state.page = 1;
          loadDrivers();
        }, 400);
      });

      $("#driverEntriesPerPage").on("change", function () {
        state.limit = parseInt($(this).val(), 10);
        state.page = 1;
        loadDrivers();
      });

      $(document).on("click", "#driverPagination .page-link", function () {
        const p = parseInt($(this).data("page"), 10);
        if (!p || p < 1) return;
        state.page = p;
        loadDrivers();
      });

      // ================= PRINT / EXPORT / BULK UPLOAD =================
      $("#printDriverBtn").click(function () {
        printDrivers();
      });

      $("#exportDriverExcelBtn").click(function () {
        exportDriverExcel();
      });

      $("#downloadDriverTemplateBtn").click(function () {
        window.location.href = "/driverRegistration/download-template";
      });

      $("#bulkUploadDriverSubmitBtn").click(function () {
        submitBulkUpload();
      });

      $("#bulkUploadDriverModal").on("hidden.bs.modal", function () {
        $("#bulkUploadDriverFile").val("");
        $("#bulkUploadDriverReport").addClass("d-none");
      });

      // ================= VIEW =================
      $(document).on("click", ".viewDriverBtn", function () {
        const id = $(this).data("id");

        console.log(`[driverRegistration] Viewing driver ${id}`);

        $.get(`/driverRegistration/${id}`, function (d) {
          $("#view_driver_id").text(d.id);
          $("#view_driver_code").text(driverCode(d));
          $("#view_full_name").text(fullName(d));
          $("#view_mobile").text(d.mobile_number || "-");
          $("#view_address").text(d.address || "-");

          $("#view_date_hired").text(formatDate(d.date_hired));
          $("#view_license_number").text(d.license_number || "-");
          $("#view_license_type").text(d.license_type || "-");
          $("#view_license_expiry").text(formatDate(d.license_expiry));

          $("#view_attendance_status").html(
            `<span class="badge bg-${getAttendanceColor(d.attendance_status)}">${d.attendance_status || "Present"}</span>`,
          );

          $("#view_availability_status").html(
            `<span class="badge bg-${getAvailabilityColor(d.availability_status)}">${d.availability_status || "Available"}</span>`,
          );

          $("#view_status").html(
            `<span class="badge bg-${d.is_active == 1 ? "success" : "danger"}">${d.is_active == 1 ? "Active" : "Inactive"}</span>`,
          );

          $("#view_emergency_contact_name").text(
            d.emergency_contact_name || "-",
          );
          $("#view_emergency_contact_number").text(
            d.emergency_contact_number || "-",
          );
          $("#view_remarks").text(d.remarks || "-");

          $("#viewDriverModal").modal("show");
        }).fail(function (xhr) {
          console.error(
            `[driverRegistration] Failed to load driver ${id}`,
            xhr,
          );
          toast("error", "Failed to load driver details");
        });
      });

      // ================= EDIT =================
      $(document).on("click", ".editDriverBtn", function () {
        const id = $(this).data("id");

        console.log(`[driverRegistration] Opening edit form for driver ${id}`);

        $.get(`/driverRegistration/${id}`, function (d) {
          $("#edit_driver_id").val(d.id);

          $("#edit_first_name").val(d.first_name || "");
          $("#edit_middle_name").val(d.middle_name || "");
          $("#edit_last_name").val(d.last_name || "");

          $("#edit_mobile_number").val(d.mobile_number || "");
          $("#edit_address").val(d.address || "");

          $("#edit_license_number").val(d.license_number || "");
          $("#edit_license_type").val(d.license_type || "");

          $("#edit_license_expiry").val(formatDateInput(d.license_expiry));
          $("#edit_date_hired").val(formatDateInput(d.date_hired));

          $("#edit_attendance_status").val(d.attendance_status || "Present");

          // Availability status: if the driver is currently in a
          // system-managed state (Assigned/Driving/etc.) because a
          // shipment is active, show it as read-only context rather
          // than an editable field — the admin shouldn't be able to
          // pick it themselves. In every other case, the dropdown
          // reflects/edits the value normally.
          const currentAvailability = d.availability_status || "Available";
          $("#edit_availability_status").val(currentAvailability);

          if (SYSTEM_MANAGED_STATUSES.includes(currentAvailability)) {
            console.log(
              `[driverRegistration] Driver ${id} is currently "${currentAvailability}" (shipment-managed) — disabling manual edit of this field.`,
            );
            $("#edit_availability_status")
              .prop("disabled", true)
              .attr(
                "title",
                "This driver is on an active shipment. Status will revert automatically when it's completed or cancelled.",
              );
          } else {
            $("#edit_availability_status")
              .prop("disabled", false)
              .removeAttr("title");
          }

          $("#edit_is_active").val(String(d.is_active ?? 1));

          $("#edit_emergency_contact_name").val(d.emergency_contact_name || "");
          $("#edit_emergency_contact_number").val(
            d.emergency_contact_number || "",
          );
          $("#edit_remarks").val(d.remarks || "");

          $("#editDriverModal").modal("show");
        }).fail(function (xhr) {
          console.error(
            `[driverRegistration] Failed to load driver ${id} for edit`,
            xhr,
          );
          toast("error", "Failed to load driver details");
        });
      });

      // ================= UPDATE =================
      $(document).on("click", "#updateDriverBtn", function () {
        const id = $("#edit_driver_id").val();
        const availability_status = $("#edit_availability_status").val();

        // Client-side guard, mirrors the server-side check in
        // driverRegistration.routes.js. If the field is disabled
        // (system-managed) its value is still submitted as-is, so
        // this only fires if someone re-enables/tampers with it.
        if (isSystemManagedStatus(availability_status)) {
          return;
        }

        const payload = {
          first_name: $("#edit_first_name").val(),
          middle_name: $("#edit_middle_name").val(),
          last_name: $("#edit_last_name").val(),
          mobile_number: $("#edit_mobile_number").val(),
          address: $("#edit_address").val(),

          license_number: $("#edit_license_number").val(),
          license_type: $("#edit_license_type").val(),

          license_expiry: $("#edit_license_expiry").val() || null,
          date_hired: $("#edit_date_hired").val() || null,

          attendance_status: $("#edit_attendance_status").val(),
          availability_status: availability_status,
          is_active: $("#edit_is_active").val(),

          emergency_contact_name: $("#edit_emergency_contact_name").val(),
          emergency_contact_number: $("#edit_emergency_contact_number").val(),
          remarks: $("#edit_remarks").val(),
        };

        console.log("========== UPDATE DRIVER PAYLOAD ==========");
        console.log({ id, ...payload });
        console.log("============================================");

        $.ajax({
          url: `/driverRegistration/${id}`,
          method: "PUT",
          contentType: "application/json",
          data: JSON.stringify(payload),

          beforeSend: function () {
            console.log(`[driverRegistration] Updating driver ${id}...`);
            $("#updateDriverBtn")
              .prop("disabled", true)
              .html(
                '<span class="spinner-border spinner-border-sm"></span> Updating...',
              );
          },

          success: function (res) {
            console.log(`[driverRegistration] Driver ${id} updated:`, res);

            $("#editDriverModal").modal("hide");
            loadDrivers();
            toast("success", res.message || "Driver updated successfully");
          },

          error: function (xhr) {
            console.error(
              `[driverRegistration] Update failed for driver ${id}`,
              xhr,
            );
            toast("error", xhr.responseJSON?.message || "Update failed");
          },

          complete: function () {
            $("#updateDriverBtn").prop("disabled", false).html("Update");
          },
        });
      });

      // Guard rail: warn immediately if someone manually selects a
      // system-managed status in the edit dropdown, before they
      // even hit "Update".
      $(document).on("change", "#edit_availability_status", function () {
        const value = $(this).val();
        if (isSystemManagedStatus(value)) {
          // Revert selection back to "Available" so the form can't
          // be submitted in a blocked state.
          $(this).val("Available");
        }
      });
    }

    // =====================================================
    // COLORS
    // =====================================================
    function getAttendanceColor(s) {
      return (
        {
          Present: "success",
          Absent: "danger",
          "Rest Day": "secondary",
          Leave: "warning",
        }[s] || "light"
      );
    }

    function getAvailabilityColor(s) {
      return (
        {
          Available: "primary",
          Assigned: "info",
          Driving: "warning",
          Delivering: "success",
          Returning: "secondary",
          "On Break": "dark",
          Unavailable: "danger",
        }[s] || "light"
      );
    }
  });
</script>