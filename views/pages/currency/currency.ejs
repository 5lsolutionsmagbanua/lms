<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Panel -->
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-cash-coin"></i>
            <span style="font-weight: 700; color: #000">
              Currency Management
            </span>
          </h2>

          <p class="text-muted mb-0">
            Manage available currencies and currency signs.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Sync
          </button>

          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addCurrencyModal"
          >
            <i class="bi bi-plus-circle"></i> Add Currency
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search currency..."
          data-table-search="currencyTable"
        />
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="currencyTable"
          data-searchable-table
        >
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Sign</th>
              <th>Created At</th>
              <th>Created By</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>Philippine Peso</td>
              <td>₱</td>
              <td>May 25, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>US Dollar</td>
              <td>$</td>
              <td>May 24, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>Euro</td>
              <td>€</td>
              <td>May 23, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>Japanese Yen</td>
              <td>¥</td>
              <td>May 22, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>British Pound</td>
              <td>£</td>
              <td>May 21, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
