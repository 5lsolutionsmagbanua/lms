<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-clock-history"></i>

            <span style="font-weight: 700; color: #000">
              Sales Order Activity
            </span>
          </h2>

          <p class="text-muted mb-0">
            Monitor all sales order actions and user activity logs.
          </p>
        </div>

        <!-- ACTION BUTTON -->
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search sales order activity..."
          data-table-search="salesOrderActivityTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="salesOrderActivityTable"
          data-searchable-table
        >
          <thead class="table-dark text-white">
            <tr>
              <th>ID</th>
              <th>Date Time</th>
              <th>Action</th>
              <th>Full Name</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>May 29, 2026 08:15 AM</td>
              <td>Created Sales Order SO-26-01-001</td>
              <td>Juan Dela Cruz</td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>May 29, 2026 09:00 AM</td>
              <td>Updated Order Quantity</td>
              <td>Maria Santos</td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>May 29, 2026 09:45 AM</td>
              <td>Approved Sales Order</td>
              <td>Admin User</td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>May 29, 2026 10:30 AM</td>
              <td>Exported Sales Order PDF</td>
              <td>Mark Cruz</td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>May 29, 2026 11:20 AM</td>
              <td>Deleted Product Item from Order</td>
              <td>Anna Reyes</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
