<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-box-arrow-in-down"></i>
            <span style="font-weight: 700; color: #000">
              Receiving Management
            </span>
          </h2>

          <p class="text-muted mb-0">
            Manage receiving records, delivery receipts, and inbound shipments.
          </p>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="d-flex flex-wrap gap-2">
          <!-- SYNC -->
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

          <!-- BATCH EXPORT -->
          <button class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel"></i>
            Batch Export Excel
          </button>

          <!-- DATE RANGE -->
          <button
            class="btn btn-sm btn-warning"
            data-bs-toggle="modal"
            data-bs-target="#receivingDateRangeModal"
          >
            <i class="bi bi-calendar-range"></i>
            Select Date Range
          </button>

          <!-- ADD RECEIVE -->
          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addReceivingModal"
          >
            <i class="bi bi-plus-circle"></i>
            Add Receive Order Request
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search receiving records..."
          data-table-search="receivingTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="receivingTable"
          data-searchable-table
        >
          <thead class="table-dark text-white">
            <tr>
              <th>ID</th>
              <th>Reference</th>
              <th>Vendor Name</th>
              <th>Inbound Carrier</th>
              <th>DR Invoice</th>
              <th>DR Invoice Date</th>
              <th>Shipped Via</th>
              <th>RR No.</th>
              <th>Receive Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>REF-2026-0001</td>
              <td>ABC Trading Corp</td>
              <td>LBC Express</td>
              <td>DR-10001</td>
              <td>May 28, 2026</td>
              <td>Truck Delivery</td>
              <td>RR-2026-0001</td>
              <td>May 29, 2026</td>

              <td class="text-end">
                <!-- VIEW -->
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewReceivingModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <!-- EXPORT -->
                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportReceivingModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>REF-2026-0002</td>
              <td>Global Supply Inc</td>
              <td>J&T Express</td>
              <td>DR-10002</td>
              <td>May 27, 2026</td>
              <td>Air Cargo</td>
              <td>RR-2026-0002</td>
              <td>May 28, 2026</td>

              <td class="text-end">
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewReceivingModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportReceivingModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<!-- ================================================= -->
<!-- DATE RANGE MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="receivingDateRangeModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-calendar-range"></i>
          Select Date Range
        </h5>

        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label"> From Start Date </label>

          <input type="date" class="form-control" />
        </div>

        <div class="mb-3">
          <label class="form-label"> To End Date </label>

          <input type="date" class="form-control" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-primary">
          <i class="bi bi-search"></i>
          Fetch
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================= -->
<!-- VIEW RECEIVING MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="viewReceivingModal">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title">
          <i class="bi bi-eye"></i>
          Receiving Details
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead class="table-dark">
              <tr>
                <th>Order ID</th>
                <th>Product Code</th>
                <th>Product Description</th>
                <th>Branch Name</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Unit Cost</th>
                <th>Total Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>SO-26-01-003</td>
                <td>PRD-1001</td>
                <td>Wireless Barcode Scanner</td>
                <td>Quezon City Branch</td>
                <td>10</td>
                <td>PCS</td>
                <td>₱5,500</td>
                <td>₱55,000</td>

                <td>
                  <span class="badge text-bg-success"> Received </span>
                </td>
              </tr>

              <tr>
                <td>SO-26-01-004</td>
                <td>PRD-1002</td>
                <td>Shipping Box Large</td>
                <td>Manila Branch</td>
                <td>50</td>
                <td>BOX</td>
                <td>₱120</td>
                <td>₱6,000</td>

                <td>
                  <span class="badge text-bg-warning"> Partial </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================================================= -->
<!-- EXPORT MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="exportReceivingModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-box-arrow-up"></i>
          Ready to Export
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label"> Employee Right </label>

          <input
            type="text"
            class="form-control"
            placeholder="Enter employee name"
          />
        </div>

        <div class="mb-3">
          <label class="form-label"> Show Order ID </label>

          <input type="text" class="form-control" value="SO-26-01-003" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i>
          Export Excel
        </button>

        <button class="btn btn-danger">
          <i class="bi bi-file-earmark-pdf"></i>
          Export PDF
        </button>
      </div>
    </div>
  </div>
</div>
