<main class="dashboard-content min-vh-100">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="panel">
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-3"
      >
        <div>
          <h1 class="h4 mb-0">Driver Requests</h1>
          <p class="text-muted mb-0 small">
            View driver requests and manage their status
          </p>
        </div>
        <div class="d-flex gap-2">
          <button
            id="approveSelectedBtn"
            type="button"
            class="btn btn-success"
            disabled
          >
            <i class="bi bi-clipboard-check"></i>
            Approve Selected
            <span id="approveSelectedCount" class="badge bg-light text-success ms-1 d-none">0</span>
          </button>
          <button
            id="printSummaryBtn"
            type="button"
            class="btn btn-outline-success"
          >
            <i class="bi bi-printer"></i> Print Summary
          </button>
          <button id="refreshBtn" type="button" class="btn btn-outline-primary">
            <span
              id="refreshSpinner"
              class="spinner-border spinner-border-sm d-none me-1"
              role="status"
            ></span>
            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i>
            Refresh
          </button>
        </div>
      </div>

      <div class="panel-body">
        <!-- Search -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <div class="input-group">
              <span class="input-group-text bg-white"
                ><i class="bi bi-search"></i
              ></span>
              <input
                type="text"
                id="searchDriverRequest"
                class="form-control"
                placeholder="Search by item name, asset, or serial..."
              />
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle" id="driverRequestTable">
            <thead>
              <tr>
                <th width="40" class="text-center">
                  <input type="checkbox" id="selectAllDriverRequests" title="Select all pending requests" />
                </th>
                <th>Ticket #</th>
                <th>Store Name</th>
                <th>Item Name</th>
                <th>Asset</th>
                <th>Serial</th>
                <th class="text-center">Qty</th>
                <th>Request Type</th>
                <th>Status</th>
                <th>Created Date</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="driverRequestTbody">
              <tr>
                <td colspan="11" class="text-center text-muted py-4">
                  Loading...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div
          class="d-flex flex-column flex-lg-row justify-content-between align-items-center mt-3 gap-3"
        >
          <div
            id="driverRequestPaginationInfo"
            class="text-muted small fw-medium"
          >
            Showing 0 to 0 of 0 entries
          </div>
          <nav aria-label="Driver Request Pagination">
            <ul
              class="pagination pagination-sm mb-0"
              id="driverRequestPagination"
            >
              <!-- Generated dynamically -->
            </ul>
          </nav>
        </div>
      </div>
    </section>
  </div>
</main>

<!-- ==========================================
     VIEW DRIVER REQUEST MODAL
=========================================== -->
<div class="modal fade" id="viewDriverRequestModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-eye me-2"></i> Driver Request Details
        </h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Request ID</label
            >
            <div id="viewRequestId" class="fw-semibold"></div>
          </div>
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Ticket Number</label
            >
            <div id="viewTicketNumber" class="fw-semibold"></div>
          </div>
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Status</label
            >
            <div>
              <span id="viewStatus" class="badge rounded-pill px-3 py-2"></span>
            </div>
          </div>

          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Store Name</label
            >
            <div id="viewStoreName" class="fw-semibold"></div>
          </div>
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Store Code</label
            >
            <div id="viewStoreCode" class="fw-semibold"></div>
          </div>
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Request Type</label
            >
            <div id="viewRequestType" class="fw-semibold"></div>
          </div>

          <div class="col-md-6">
            <label class="text-muted small fw-semibold text-uppercase"
              >Item Name</label
            >
            <div id="viewItemName" class="fw-semibold fs-6"></div>
          </div>
          <div class="col-md-3">
            <label class="text-muted small fw-semibold text-uppercase"
              >Asset</label
            >
            <div id="viewAsset" class="fw-semibold"></div>
          </div>
          <div class="col-md-3">
            <label class="text-muted small fw-semibold text-uppercase"
              >Serial</label
            >
            <div id="viewSerial" class="fw-semibold"></div>
          </div>

          <div class="col-md-3">
            <label class="text-muted small fw-semibold text-uppercase"
              >Quantity</label
            >
            <div id="viewRequestQty" class="fw-semibold"></div>
          </div>
          <div class="col-md-4">
            <label class="text-muted small fw-semibold text-uppercase"
              >Created Date</label
            >
            <div id="viewCreatedDate" class="fw-semibold"></div>
          </div>
          <div class="col-md-5">
            <label class="text-muted small fw-semibold text-uppercase"
              >Created By</label
            >
            <div id="viewCreatedBy" class="fw-semibold"></div>
          </div>

          <div class="col-12">
            <label class="text-muted small fw-semibold text-uppercase"
              >Notes</label
            >
            <div id="viewNotes" class="border rounded-3 bg-light p-2 text-body">
              &mdash;
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     EDIT STATUS MODAL
=========================================== -->
<div class="modal fade" id="editStatusModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">
          <i class="bi bi-pencil-square me-2"></i> Update Status
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editStatusId" />
        <p class="text-muted small mb-2">
          Ticket:
          <span id="editStatusTicket" class="fw-semibold text-body"></span>
        </p>
        <label class="form-label fw-semibold">Status</label>
        <select class="form-select" id="editStatusSelect">
          <option value="PENDING">Pending</option>
          <option value="APPROVED">Approved</option>
          <option value="IN_PROGRESS">In Progress</option>
          <option value="COMPLETED">Completed</option>
          <option value="REJECTED">Rejected</option>
          <option value="CANCELLED">Cancelled</option>
        </select>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-warning" id="saveStatusBtn">
          <i class="bi bi-check-circle me-1"></i> Save Status
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     APPROVE CHECKLIST MODAL
     Opened either from a single row's Approve button, or from
     "Approve Selected" after checking one or more PENDING rows —
     both paths lead here and share the same checklist gate. The
     Approve button stays disabled until every box is checked.

     NOTE: these checklist items are placeholders — swap the four
     <label> lines below for whatever your actual approval checklist
     should verify.
=========================================== -->
<div class="modal fade" id="approveChecklistModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-clipboard-check me-2"></i> Approve Driver Request<span id="approveChecklistPlural"></span>
        </h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>
      <div class="modal-body">
        <!-- Populated with one line per request being approved. A single
             approval shows one row; bulk approval lists every selected
             ticket so it's clear exactly what's about to be approved. -->
        <div id="approveChecklistTargets" class="mb-3 small"></div>

        <p class="small text-muted mb-2">
          Confirm each item before approving:
        </p>

        <div class="form-check mb-2">
          <input
            class="form-check-input approveChecklistItemCheck"
            type="checkbox"
            id="checklistItemAvailability"
          />
          <label class="form-check-label" for="checklistItemAvailability">
            Item availability confirmed
          </label>
        </div>
        <div class="form-check mb-2">
          <input
            class="form-check-input approveChecklistItemCheck"
            type="checkbox"
            id="checklistItemQuantity"
          />
          <label class="form-check-label" for="checklistItemQuantity">
            Requested quantity matches available stock
          </label>
        </div>
        <div class="form-check mb-2">
          <input
            class="form-check-input approveChecklistItemCheck"
            type="checkbox"
            id="checklistItemAssetSerial"
          />
          <label class="form-check-label" for="checklistItemAssetSerial">
            Asset and serial details verified
          </label>
        </div>
        <div class="form-check mb-2">
          <input
            class="form-check-input approveChecklistItemCheck"
            type="checkbox"
            id="checklistItemRequester"
          />
          <label class="form-check-label" for="checklistItemRequester">
            Requester and store details confirmed
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-success" id="saveApproveBtn" disabled>
          <i class="bi bi-check-circle me-1"></i> <span id="saveApproveBtnLabel">Approve Request</span>
        </button>
      </div>
    </div>
  </div>
</div>
