<div class="modal fade" id="editShipmentModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">
          <i class="bi bi-pencil-square"></i>
          Edit Shipment Request
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="editShipmentId" />

        <div class="row">
          <!-- Ticket Number -->
          <div class="col-md-3 mb-3">
            <label class="form-label">Ticket Number</label>
            <input
              type="text"
              id="editTicketNumber"
              class="form-control"
              readonly
            />
          </div>

          <!-- Store -->
          <div class="col-md-3 mb-3">
            <label class="form-label">Store</label>
            <select id="editStoreSelect" class="form-select"></select>
          </div>

          <!-- Priority -->
          <div class="col-md-2 mb-3">
            <label class="form-label">Priority</label>
            <select id="editPriority" class="form-select">
              <option value="Low">Low</option>
              <option value="Normal">Normal</option>
              <option value="Urgent">Urgent</option>
            </select>
          </div>

          <!-- Status -->
          <select id="editStatus" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Assigned">Assigned</option>
            <option value="Preparing">Preparing</option>
            <option value="Dispatched">Dispatched</option>
            <option value="Delivered">Delivered</option>
            <option value="Cancelled">Cancelled</option>
          </select>

          <!-- Notes -->
          <div class="col-md-2 mb-3">
            <label class="form-label">Notes</label>
            <textarea id="editNotes" class="form-control" rows="1"></textarea>
          </div>
        </div>

        <hr />

        <div class="row">
          <div class="col-md-3">
            <label>Type</label>
            <select id="editTypeSelect" class="form-select"></select>
          </div>

          <div class="col-md-3">
            <label>Product</label>
            <select id="editProductSelect" class="form-select"></select>
          </div>

          <div class="col-md-2">
            <label>Unit</label>
            <select id="editUnitSelect" class="form-select"></select>
          </div>

          <div class="col-md-2">
            <label>Qty</label>
            <input type="number" id="editQuantity" class="form-control" />
          </div>

          <div class="col-md-2 d-grid">
            <label>&nbsp;</label>

            <button class="btn btn-success" id="editAddItemBtn">
              <i class="bi bi-plus-circle"></i>
              Add Item
            </button>
          </div>
        </div>

        <hr />

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Type</th>
              <th>Product</th>
              <th>Unit</th>
              <th width="120">Qty</th>
              <th width="150">Actions</th>
            </tr>
          </thead>

          <tbody id="editRequestItemsBody">
            <tr>
              <td colspan="5" class="text-center text-muted">No items.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- =========================================================
     2) TABLE ACTIONS COLUMN — Delete button removed. This is
     already baked into shipmentRequest.page.js's renderShipmentTable(),
     shown here just so the column intent is visible: View + Edit
     (+ Assign, when not yet assigned), wrapped in one aligned group.
     No HTML change needed here — the <thead> stays exactly as-is,
     only the row-building JS changed.
========================================================= -->

      <!-- =========================================================
     3) EDIT SHIPMENT MODAL FOOTER — replace the existing footer's
     button markup with this. Two button groups now live side by
     side: #editFormFooterBtns (Cancel + Save Changes, shown by
     default) and #editDecisionFooterBtns (Reject + Approve, hidden
     until a save succeeds while the shipment is still Pending).
     shipmentRequest.page.js's setEditModalStep() toggles between them.
========================================================= -->
      <div class="modal-footer justify-content-end gap-2">
        <!-- Step 1: item-editing form -->
        <div id="editFormFooterBtns" class="d-flex gap-2">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>

          <button class="btn btn-warning" id="updateShipmentBtn">
            <i class="bi bi-save"></i>
            Save Changes
          </button>
        </div>
 
        <!-- Step 2: post-save decision (only reachable while still Pending) -->
        <div id="editDecisionFooterBtns" class="d-flex gap-2 d-none">
          <button class="btn btn-danger" id="editRejectBtn">
            <i class="bi bi-x-circle"></i>
            Reject
          </button>

          <button class="btn btn-info text-white" id="editApproveBtn">
            <i class="bi bi-check-circle"></i>
            Approve
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

