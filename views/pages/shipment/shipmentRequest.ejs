<div class="modal fade" id="addShipmentRequestModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-truck"></i>
          New Shipment Request
        </h5>

        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <form id="shipmentRequestForm">
        <div class="modal-body">
          <!-- ===================== SHIPMENT REQUEST ===================== -->

          <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
              <i class="bi bi-truck"></i>
              Shipment Request
            </div>

            <div class="card-body">
              <!-- ================= REQUEST DETAILS ================= -->

              <h6 class="fw-bold mb-3 border-bottom pb-2">Request Details</h6>

              <div class="row g-3">
                <!-- Request Type -->
                <div class="col-md-3">
                  <label class="form-label">Request Type</label>

                  <select class="form-select" id="requestType">
                    <option value="1">Deployment</option>
                    <option value="2">Transfer</option>
                    <option value="3">Sales</option>
                  </select>
                </div>

                <!-- Priority -->
                <div class="col-md-3">
                  <label class="form-label">Priority</label>

                  <select class="form-select" id="priority">
                    <option value="">Select Priority</option>
                    <option>Low</option>
                    <option>Normal</option>
                    <option>Urgent</option>
                  </select>
                </div>

                <!-- Branch -->
                <div class="col-md-3">
                  <label class="form-label">Branch</label>

                  <select class="form-select" id="branchSelect">
                    <option>Loading...</option>
                  </select>
                </div>

                <!-- Target Branch -->
                <div class="col-md-3 d-none" id="targetBranchGroup">
                  <label class="form-label">Target Branch</label>
                  <select class="form-select" id="targetBranchSelect"></select>
                </div>

                <!-- Store -->
                <div class="col-md-3">
                  <label class="form-label">Store</label>

                  <select class="form-select" id="storeSelect">
                    <option>Loading...</option>
                  </select>
                </div>

                <!-- Ticket -->
                <div class="col-md-4">
                  <label class="form-label">Ticket Number</label>

                  <input
                    type="text"
                    class="form-control"
                    id="ticket_number"
                    placeholder="Ticket Number"
                  />
                </div>

                <!-- Customer -->
                <div class="col-md-6 d-none" id="customerGroup">
                  <label class="form-label">Customer Details</label>
                  <input type="text" class="form-control" id="customer" />
                </div>

                <!-- Notes -->
                <div class="col-md-8">
                  <label class="form-label">Remarks</label>

                  <textarea
                    class="form-control"
                    id="notes"
                    rows="2"
                    placeholder="Additional remarks..."
                  ></textarea>
                </div>
              </div>

              <hr class="my-4" />

              <!-- ================= REQUEST ITEMS ================= -->

              <h6 class="fw-bold mb-3 border-bottom pb-2">Request Items</h6>

              <div class="row g-3 align-items-end">
                <!-- Inventory Type -->
                <div class="col-md-3">
                  <label class="form-label">Inventory Type</label>

                  <select class="form-select" id="typeSelect">
                    <option>Loading...</option>
                  </select>
                </div>

                <!-- Product -->
                <div class="col-md-4">
                  <label class="form-label">Item Name</label>

                  <select class="form-select" id="productSelect">
                    <option>Select Item</option>
                  </select>
                </div>

                <!-- Unit -->
                <div class="col-md-2">
                  <label class="form-label">Unit</label>

                  <select class="form-select" id="unitSelect">
                    <option>Loading...</option>
                  </select>
                </div>

                <!-- Quantity -->
                <div class="col-md-2">
                  <label class="form-label">Quantity</label>

                  <input
                    type="number"
                    min="1"
                    class="form-control"
                    id="quantity"
                  />
                </div>

                <!-- Add -->
                <div class="col-md-1 d-grid">
                  <button type="button" class="btn btn-success" id="addItemBtn">
                    <i class="bi bi-plus-lg"></i>
                  </button>
                </div>
              </div>

              <!-- ================= ITEMS TABLE ================= -->

              <div class="table-responsive mt-4">
                <table class="table table-bordered table-hover align-middle">
                  <thead>
                    <tr>
                      <th width="180">Inventory Type</th>

                      <th>Item Name</th>

                      <th width="120">Unit</th>

                      <th width="120" class="text-center">Quantity</th>

                      <th width="90" class="text-center">Action</th>
                    </tr>
                  </thead>

                  <tbody id="requestItemsBody">
                    <tr>
                      <td colspan="5" class="text-center text-muted py-4">
                        <i class="bi bi-cart-x fs-3"></i><br />

                        No items added yet.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>

          <button type="submit" class="btn btn-primary" id="submitRequestBtn">
            <i class="bi bi-send"></i>
            Request Items
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-bottom"
      >
        <div>
          <h2 class="h4 mb-1">
            <i class="bi bi-truck"></i>
            Shipment Requests
          </h2>

          <p class="text-muted mb-0">
            Manage shipment requests and requested products.
          </p>
        </div>

        <button
          class="btn btn-primary"
          data-bs-toggle="modal"
          data-bs-target="#addShipmentRequestModal"
        >
          <i class="bi bi-plus-circle"></i>
          Add Request
        </button>
      </div>

      <!-- Body -->
      <div class="panel-body p-4">
        <!-- Summary Cards -->
        <!-- Shipment Metrics -->
        <section class="row g-3 mb-4">
          <!-- Pending -->
          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-warning" id="pendingCard">
              <div class="metric-top">
                <span class="metric-label" id="pendingLabel">
                  Pending Requests
                </span>

                <span class="metric-icon">
                  <i class="bi bi-clock-history"></i>
                </span>
              </div>

              <div class="metric-value" id="pendingCount">0</div>

              <div class="metric-meta">
                <span class="text-warning" id="pendingStatus">
                  Waiting approval
                </span>

                <span id="pendingDescription"> for processing </span>
              </div>
            </article>
          </div>

          <!-- Approved -->
          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-primary">
              <div class="metric-top">
                <span class="metric-label"> Approved Requests </span>

                <span class="metric-icon">
                  <i class="bi bi-check2-square"></i>
                </span>
              </div>

              <div class="metric-value" id="approvedCount">8</div>

              <div class="metric-meta">
                <span class="text-primary"> Ready for picking </span>

                <span> warehouse queue </span>
              </div>
            </article>
          </div>

          <!-- In Transit -->
          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-info">
              <div class="metric-top">
                <span class="metric-label"> In Transit </span>

                <span class="metric-icon">
                  <i class="bi bi-truck"></i>
                </span>
              </div>

              <div class="metric-value" id="transitCount">4</div>

              <div class="metric-meta">
                <span class="text-info"> Currently moving </span>

                <span> to destination </span>
              </div>
            </article>
          </div>

          <!-- Delivered -->
          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-success">
              <div class="metric-top">
                <span class="metric-label"> Delivered </span>

                <span class="metric-icon">
                  <i class="bi bi-box-seam"></i>
                </span>
              </div>

              <div class="metric-value" id="deliveredCount">25</div>

              <div class="metric-meta">
                <span class="text-success"> Successfully completed </span>

                <span> shipments </span>
              </div>
            </article>
          </div>
        </section>

        <!-- Filters -->
        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <input
              type="text"
              class="form-control"
              id="searchShipment"
              placeholder="Search ticket number..."
            />
          </div>

          <div class="col-md-2">
            <select class="form-select" id="filterPriority">
              <option value="">All Priority</option>
              <option>Low</option>
              <option>Normal</option>
              <option>High</option>
              <option>Urgent</option>
            </select>
          </div>

          <div class="col-md-2">
            <select class="form-select" id="filterStatus">
              <option value="">All Status</option>
              <option>Pending</option>
              <option>Approved</option>
              <option>Rejected</option>
              <option>For Picking</option>
              <option>Packed</option>
              <option>Dispatched</option>
              <option>In Transit</option>
              <option>Delivered</option>
              <option>Cancelled</option>
            </select>
          </div>

          <div class="col-md-2">
            <select class="form-select" id="filterType">
              <option value="">All Types</option>
              <option>Transfer</option>
              <option>Delivery</option>
              <option>Pull Out</option>
              <option>Return</option>
            </select>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <div>
            <button class="btn btn-success btn-sm" id="bulkAssignBtn" disabled>
              <i class="bi bi-person-check"></i> Assign Selected to Driver
            </button>
            <span class="text-muted small ms-2" id="selectedCountLabel"></span>
          </div>

          <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 280px">
              <span class="input-group-text bg-white">
                <i class="bi bi-upc-scan"></i>
              </span>
              <input
                type="text"
                id="barcodeScanInput"
                class="form-control"
                placeholder="Scan or type barcode..."
                autocomplete="off"
              />
              <button
                class="btn btn-outline-secondary"
                type="button"
                id="barcodeSubmitBtn"
              >
                <i class="bi bi-arrow-return-left"></i>
              </button>
            </div>

            <button
              class="btn btn-outline-success btn-sm"
              id="printAssignedBtn"
            >
              <i class="bi bi-printer"></i> Print Assigned per Driver
            </button>
            <button
              class="btn btn-outline-primary btn-sm"
              id="exportAssignedExcelBtn"
            >
              <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </button>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle">
            <thead>
              <tr>
                <th width="40" class="text-center">
                  <input type="checkbox" id="selectAllShipments" />
                </th>
                <th width="70">ID</th>
                <th width="170">Ticket No.</th>
                <th>Store</th>
                <th width="110" class="text-center">Total Items</th>
                <th width="110">Priority</th>
                <th width="120">Status</th>
                <th width="170">Created At</th>
                <th width="180" class="text-center">Actions</th>
                <th width="180" class="text-center">Barcode</th>
              </tr>
            </thead>

            <tbody id="shipmentTableBody">
              <tr>
                <td colspan="10" class="text-center text-muted py-4">
                  <i class="bi bi-truck fs-2"></i><br />
                  No shipment requests found.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- ==========================================
     TABLE PAGINATION
========================================== -->
        <div
          class="d-flex flex-column flex-lg-row justify-content-between align-items-center mt-4 gap-3"
        >
          <!-- Pagination Information -->
          <div
            id="paginationInfo"
            class="text-muted small fw-medium text-center text-lg-start"
          >
            Showing 0 to 0 of 0 entries
          </div>

          <!-- Pagination Controls -->
          <nav aria-label="Shipment Pagination">
            <ul class="pagination pagination-sm mb-0" id="shipmentPagination">
              <!-- Generated dynamically -->
            </ul>
          </nav>
        </div>
      </div>
    </section>
  </div>
</main>
