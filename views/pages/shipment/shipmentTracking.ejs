<div class="modal fade" id="trackingDateRangeModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-calendar-range"></i>
          Select Date Range
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label"> Filter Type </label>

            <select class="form-select">
              <option>Dispatch Date</option>
              <option>Tracking Date</option>
              <option>Delivery Date</option>
              <option>Last Updated Date</option>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">Quick Range</label>

            <select class="form-select">
              <option>Today</option>
              <option>Yesterday</option>
              <option>Last 7 Days</option>
              <option>Last 30 Days</option>
              <option>This Month</option>
              <option>Last Month</option>
              <option>Custom Date Range</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label"> From Date </label>

            <input type="date" class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="form-label"> To Date </label>

            <input type="date" class="form-control" />
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

        <button class="btn btn-primary">
          <i class="bi bi-search"></i>
          Fetch Data
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="trackingTimelineModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-clock-history"></i>
          Shipment Timeline
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <ul class="list-group">
          <li class="list-group-item">
            <strong>08:00 AM</strong> - Shipment Dispatched
          </li>

          <li class="list-group-item">
            <strong>09:15 AM</strong> - Left Warehouse
          </li>

          <li class="list-group-item">
            <strong>10:45 AM</strong> - Arrived at Quezon City Checkpoint
          </li>

          <li class="list-group-item">
            <strong>12:00 PM</strong> - Estimated Arrival
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="viewTrackingModal">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title">
          <i class="bi bi-geo-alt"></i>
          Shipment Tracking Details
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Tracking No.</label>
            <input
              type="text"
              class="form-control"
              value="TRK-26-06-0001"
              readonly
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Dispatch No.</label>
            <input
              type="text"
              class="form-control"
              value="DSP-26-06-0001"
              readonly
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Vehicle</label>
            <input type="text" class="form-control" value="TRK-001" readonly />
          </div>

          <div class="col-md-3">
            <label class="form-label">Driver</label>
            <input
              type="text"
              class="form-control"
              value="Juan Dela Cruz"
              readonly
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Current Location</label>
            <input
              type="text"
              class="form-control"
              value="Quezon City"
              readonly
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <input
              type="text"
              class="form-control"
              value="In Transit"
              readonly
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">ETA</label>
            <input
              type="text"
              class="form-control"
              value="06/01/2026 12:00 PM"
              readonly
            />
          </div>
        </div>

        <hr />

        <h6 class="fw-bold">Shipment Orders</h6>

        <div class="table-responsive">
          <table class="table table-bordered">
            <thead class="table-dark">
              <tr>
                <th>Order ID</th>
                <th>Client</th>
                <th>Product Code</th>
                <th>Description</th>
                <th>Branch</th>
                <th>Qty</th>
                <th>Unit</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>SO-26-01-001</td>
                <td>ABC Trading</td>
                <td>PRD-001</td>
                <td>Industrial Lubricant</td>
                <td>Main Branch</td>
                <td>50</td>
                <td>PCS</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-geo-alt"></i>
            <span style="font-weight: 700; color: #000">
              Shipment Tracking
            </span>
          </h2>

          <p class="text-muted mb-0">
            Monitor shipment movement and delivery status in real time.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

          <button
            class="btn btn-warning btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#trackingDateRangeModal"
          >
            <i class="bi bi-calendar-range"></i>
            Date Range
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          type="search"
          class="form-control form-control-sm"
          placeholder="Search shipment..."
        />
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-dark text-white">
            <tr>
              <th>ID</th>
              <th>Tracking No.</th>
              <th>Dispatch No.</th>
              <th>Client</th>
              <th>Vehicle</th>
              <th>Driver</th>
              <th>Current Location</th>
              <th>Status</th>
              <th>Last Update</th>
              <th>ETA</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>1</td>
              <td>TRK-26-06-0001</td>
              <td>DSP-26-06-0001</td>
              <td>ABC Trading Corp</td>
              <td>TRK-001</td>
              <td>Juan Dela Cruz</td>
              <td>Quezon City</td>
              <td>
                <span class="badge bg-primary">In Transit</span>
              </td>
              <td>06/01/2026 10:45 AM</td>
              <td>06/01/2026 12:00 PM</td>
              <td class="text-end">
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewTrackingModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#trackingTimelineModal"
                >
                  <i class="bi bi-clock-history"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
