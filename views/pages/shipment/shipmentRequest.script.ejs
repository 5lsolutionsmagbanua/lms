<script>
  /* ============================================================
   SHIPMENT REQUEST PAGE SCRIPT

   CHANGES IN THIS PASS:
   1. Delete action removed entirely (button + handler + ajax
      call). The delete-shipment API route itself was left alone
      server-side; nothing in the UI calls it anymore.
   2. Table is now visually fixed-height: every row (real or
      filler) is the same height via .shipment-row, and
      renderShipmentTable() pads with blank filler rows up to
      rowsPerPage so the table never resizes between a page with
      1 result and a page with 4.
   3. Edit modal now has a two-step flow:
        Step 1 (default): item-editing form + "Save Changes".
        Step 2 (after a successful save, shipment still Pending):
          footer swaps to "Approve" / "Reject".
            - Approve -> PUT /approve-shipment/:ticket, then closes
              the edit modal and opens the existing Assign Driver &
              Vehicle modal for the same ticket.
            - Reject  -> PUT /reject-shipment/:ticket (new route),
              sets status to Rejected.
      Re-opening the modal always resets it back to Step 1.
   4. All plain result messages (success / error / warning) now
      go through the existing toast helper (showToast) instead of
      Swal.fire dialogs. Anything that genuinely needs a click to
      confirm (Approve?/Reject?/Delete-was-here) or needs form
      inputs (the print/export driver pickers) is still a
      SweetAlert dialog — a toast can't take a confirm click or a
      dropdown selection.
   ============================================================ */

  // ==============================
  // GLOBAL STATE
  // ==============================
  let requestItems = []; // items being added on the "New Shipment" form
  let editItems = []; // items being edited on the "Edit Shipment" modal
  let editingRowIndex = -1; // index of item currently being edited in edit modal
  let editShipmentId = null;
  let editTicketNumber = null;
  let editPriorityValue = null;
  let editIsDispatched = false; // true when the shipment being edited already has a dispatch record
  let editStep = "form"; // "form" | "decision" — which footer the edit modal shows

  let allShipments = []; // full dataset from server
  let filteredShipments = []; // after search/priority/status filters
  let currentPage = 1;
  const rowsPerPage = 4;

  $(function () {
    init();

    function init() {
      loadDropdowns();
      loadShipments();
      bindEvents();
    }

    // ==============================
    // LOAD ALL DROPDOWNS (New Shipment form)
    // ==============================
    function loadDropdowns() {
      loadTypes();
      loadBranches();
      loadStores();
      loadUnits();
      loadProducts();
    }

    function loadTypes() {
      $.ajax({
        url: "/types/get-types",
        method: "GET",
        success: function (res) {
          let options = `<option value="">Select Type</option>`;
          res.forEach((t) => {
            options += `<option value="${t.id}">${t.type_name}</option>`;
          });
          $("#typeSelect").html(options);
        },
        error: function () {
          console.log("Unable to load types.");
        },
      });
    }

    function loadBranches() {
      $.ajax({
        url: "/branch/get-branches",
        method: "GET",
        success: function (res) {
          let options = `<option value="">Select Branch</option>`;
          res.forEach((b) => {
            options += `<option value="${b.id}">${b.branch_name}</option>`;
          });
          $("#branchSelect").html(options);
        },
        error: function () {
          console.log("Unable to load branches.");
        },
      });
    }

    function loadStores() {
      $.ajax({
        url: "/store/get-stores",
        method: "GET",
        success: function (res) {
          const stores = Array.isArray(res)
            ? res
            : (res.data ?? res.stores ?? []);

          if (!Array.isArray(stores)) {
            console.error("Unexpected /store/get-stores response:", res);
            showToast("error", "Store list came back in an unexpected format.");
            return;
          }

          let options = `<option value="">Select Store</option>`;
          stores.forEach((s) => {
            options += `<option value="${s.id}">${s.store_name} (${s.store_code})</option>`;
          });
          $("#storeSelect").html(options);
        },
        error: function (xhr) {
          console.error("store/get-stores failed:", xhr.responseText);
          console.log("Unable to load stores.");
        },
      });
    }

    function loadProducts() {
      $.ajax({
        url: "/products/get-products",
        method: "GET",
        success: function (res) {
          let options = `<option value="">Select Item</option>`;
          res.forEach((p) => {
            options += `<option value="${p.id}">${p.inventory_name}</option>`;
          });
          $("#productSelect").html(options);
        },
        error: function () {
          showToast("error", "Failed to load products.");
        },
      });
    }

    function loadUnits() {
      $.ajax({
        url: "/units/get-units",
        method: "GET",
        success: function (res) {
          let options = `<option value="">Select Unit</option>`;
          res.forEach((u) => {
            options += `<option value="${u.id}">${u.unit_name}</option>`;
          });
          $("#unitSelect").html(options);
        },
        error: function () {
          console.log("Unable to load units.");
        },
      });
    }

    // ==============================
    // LOAD SHIPMENTS (table + summary cards)
    // ==============================
    function loadShipments(callback = null) {
      $.ajax({
        url: "/shipmentRequest/get-shipments",
        method: "GET",
        cache: false,

        beforeSend: function () {
          $("#shipmentTableBody").html(`
          <tr>
            <td colspan="10" class="text-center py-5">
              <div class="spinner-border text-primary"></div>
              <br><br>
              Loading shipments...
            </td>
          </tr>
        `);
        },

        success: function (res) {
          allShipments = [...res];
          filteredShipments = [...res];
          currentPage = 1;

          updateSummaryCards();
          renderShipmentTable();

          if (typeof callback === "function") callback();
        },

        error: function () {
          $("#shipmentTableBody").html(`
          <tr>
            <td colspan="10" class="text-center text-danger py-5">
              <i class="bi bi-exclamation-triangle fs-1"></i>
              <br><br>
              Failed to load shipment requests.
            </td>
          </tr>
        `);
        },
      });
    }
    // Expose for handlers defined outside this closure (edit/save flows)
    window.loadShipments = loadShipments;

    function updateSummaryCards() {
      $("#pendingCount").text(
        allShipments.filter((x) => x.status === "Pending").length,
      );
      $("#approvedCount").text(
        allShipments.filter((x) => x.status === "Approved").length,
      );
      $("#transitCount").text(
        allShipments.filter((x) => x.status === "In Transit").length,
      );
      $("#deliveredCount").text(
        allShipments.filter((x) => x.status === "Delivered").length,
      );
    }

    // ==============================
    // TABLE ROW HEIGHT / FIXED SIZE
    // Table always shows exactly `rowsPerPage` row-slots, whether
    // there's 1 result or 4 — filler rows keep the table from
    // growing/shrinking as you filter, search, or page through.
    // ==============================
    const COLUMN_COUNT = 10; // checkbox, id, ticket, store, items, priority, status, created, actions, barcode

    function buildFillerRow() {
      return `<tr class="shipment-row filler-row"><td colspan="${COLUMN_COUNT}">&nbsp;</td></tr>`;
    }

    function renderShipmentTable() {
      const start = (currentPage - 1) * rowsPerPage;
      const end = start + rowsPerPage;
      const data = filteredShipments.slice(start, end);

      const statusColors = {
        Pending: "warning",
        Approved: "primary",
        Preparing: "info",
        "In Transit": "info",
        Dispatched: "dark",
        Delivered: "success",
        Rejected: "danger",
        Cancelled: "danger",
      };

      const priorityColors = {
        Low: "secondary",
        Normal: "primary",
        High: "warning",
        Urgent: "danger",
      };

      let rows = "";
      let renderedRowCount = 0;

      if (data.length === 0) {
        rows = `
    <tr class="shipment-row empty-row">
      <td colspan="${COLUMN_COUNT}" class="text-center text-muted py-4">
        <i class="bi bi-truck fs-1"></i>
        <br><br>
        No shipment requests found.
      </td>
    </tr>
  `;
        renderedRowCount = 1;
      } else {
        data.forEach((shipment) => {
          const assigned = Number(shipment.is_assigned) === 1;
          const isPending = shipment.status === "Pending";

          rows += `
      <tr class="shipment-row">
        <td class="text-center">
    ${
      assigned
        ? `<input type="checkbox" disabled title="Already assigned">`
        : `<input type="checkbox" class="shipmentCheckbox" value="${shipment.shipment_id}">`
    }
  </td>
        <td>${shipment.shipment_id}</td>
        <td>${shipment.ticket_number}</td>
        <td>
          ${shipment.store_name}
          <br>
          <small class="text-muted">${shipment.store_code}</small>
        </td>
        <td class="text-center">${shipment.total_items}</td>
        <td>
          <span class="badge bg-${priorityColors[shipment.priority] || "secondary"}">
            ${shipment.priority}
          </span>
        </td>
        <td>
          <span class="badge bg-${statusColors[shipment.status] || "secondary"}">
            ${shipment.status}
          </span>
        </td>
        <td>${new Date(shipment.created_at).toLocaleDateString()}</td>
        <td class="text-center">
          <div class="d-flex justify-content-center align-items-center gap-1 action-btn-group">
            ${
              assigned
                ? `
                <button class="btn btn-secondary btn-sm" disabled title="Already Assigned">
                  <i class="bi bi-check2-circle"></i>
                </button>
              `
                : `
                <button
                  class="btn btn-success btn-sm assignShipmentBtn"
                  data-id="${shipment.shipment_id}"
                  data-ticket="${shipment.ticket_number}"
                  data-priority="${shipment.priority}">
                  <i class="bi bi-person-check"></i>
                </button>
              `
            }
            <button class="btn btn-primary btn-sm viewShipmentBtn"
              data-id="${shipment.shipment_id}"
              data-ticket="${shipment.ticket_number}">
              <i class="bi bi-eye"></i>
            </button>
            <button
              class="btn btn-warning btn-sm ${assigned ? "" : "editShipmentBtn"}"
              data-ticket="${shipment.ticket_number}"
              ${assigned ? `disabled title="Already dispatched — cannot edit"` : ""}>
              <i class="bi bi-pencil"></i>
            </button>
          </div>
        </td>
        <td class="text-center">
          ${
            shipment.barcode
              ? `<svg class="rowBarcode" data-barcode="${shipment.barcode}"></svg>`
              : `<span class="text-muted">-</span>`
          }
        </td>
      </tr>
    `;
          renderedRowCount++;
        });
      }

      // Pad up to rowsPerPage so the table height never changes.
      for (let i = renderedRowCount; i < rowsPerPage; i++) {
        rows += buildFillerRow();
      }

      $("#shipmentTableBody").html(rows);
      renderPagination();

      $(".rowBarcode").each(function () {
        const value = $(this).data("barcode");
        JsBarcode(this, String(value), {
          format: "CODE128",
          displayValue: false,
          height: 30,
          width: 1.4,
          margin: 0,
        });
        $(this).attr("title", value);
      });
    }

    function renderPagination() {
      const totalPages = Math.max(
        1,
        Math.ceil(filteredShipments.length / rowsPerPage),
      );
      const start =
        filteredShipments.length === 0
          ? 0
          : (currentPage - 1) * rowsPerPage + 1;
      const end = Math.min(currentPage * rowsPerPage, filteredShipments.length);

      $("#paginationInfo").text(
        `Showing ${start} to ${end} of ${filteredShipments.length} entries`,
      );

      let html = `
      <li class="page-item ${currentPage === 1 ? "disabled" : ""}">
        <a class="page-link" href="#" id="previousPage"><i class="bi bi-chevron-left"></i> Previous</a>
      </li>
    `;

      for (let i = 1; i <= totalPages; i++) {
        html += `
        <li class="page-item ${currentPage === i ? "active" : ""}">
          <a href="#" class="page-link pageNumber" data-page="${i}">${i}</a>
        </li>
      `;
      }

      html += `
      <li class="page-item ${currentPage === totalPages ? "disabled" : ""}">
        <a class="page-link" href="#" id="nextPage">Next <i class="bi bi-chevron-right"></i></a>
      </li>
    `;

      $("#shipmentPagination").html(html);
    }

    function applyFilters() {
      const search = ($("#searchShipment").val() || "").toLowerCase();
      const priority = $("#filterPriority").val();
      const status = $("#filterStatus").val();

      filteredShipments = allShipments.filter((x) => {
        const matchSearch =
          x.ticket_number.toLowerCase().includes(search) ||
          x.store_name.toLowerCase().includes(search);
        const matchPriority = priority === "" || x.priority === priority;
        const matchStatus = status === "" || x.status === status;
        return matchSearch && matchPriority && matchStatus;
      });

      currentPage = 1;
      renderShipmentTable();
    }

    // ==============================
    // ASSIGN SHIPMENT MODAL (#assignShipmentModal)
    // ==============================
    function loadAssignDrivers() {
      return $.ajax({
        url: "/shipmentRequest/drivers/list",
        method: "GET",
        success: function (res) {
          let options = `<option value="">Select Driver</option>`;
          if (res.length === 0) {
            options += `<option disabled>No available drivers</option>`;
          } else {
            res.forEach((driver) => {
              options += `<option value="${driver.id}">${driver.driver_code} - ${driver.driver_name}</option>`;
            });
          }
          $("#assignDriver").html(options);
        },
        error: function (xhr) {
          console.error(xhr);
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to load available drivers.",
          );
        },
      });
    }

    let assignVehiclesData = [];

    function loadAssignVehicles() {
      return $.ajax({
        url: "/shipmentRequest/vehicles/list",
        method: "GET",
        success: function (res) {
          assignVehiclesData = res || [];

          let options = `<option value="">Select Vehicle</option>`;
          if (res.length === 0) {
            options += `<option disabled>No available vehicles</option>`;
          } else {
            res.forEach((vehicle) => {
              options += `<option value="${vehicle.id}">${vehicle.vehicle_code} (${vehicle.plate_number})</option>`;
            });
          }
          $("#assignVehicle").html(options);
        },
        error: function (xhr) {
          console.error(xhr);
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to load available vehicles.",
          );
        },
      });
    }

    $(document).on("change", "#assignVehicle", function () {
      const vehicleId = $(this).val();
      const vehicle = assignVehiclesData.find((v) => v.id == vehicleId);

      if (!vehicle || !vehicle.driver_id) {
        $("#assignDriver").val("");
        return;
      }

      const optionExists =
        $("#assignDriver option[value='" + vehicle.driver_id + "']").length > 0;

      if (optionExists) {
        $("#assignDriver").val(vehicle.driver_id);
      } else {
        $("#assignDriver").val("");
        console.warn(
          `[shipmentRequest] Vehicle ${vehicle.vehicle_code}'s linked driver (${vehicle.driver_name}) is not currently available.`,
        );
      }
    });

    function openAssignShipmentModal(shipmentId, ticketNumber, priority) {
      $("#assignShipmentId").val(shipmentId);
      $("#assignTicketNumber").val(ticketNumber);
      $("#assignTicketDisplay").val(ticketNumber);
      $("#assignPriority").val(priority);

      const dispatchNumber = generateDispatchNumber(shipmentId);
      $("#assignDispatchNumber").val(dispatchNumber);

      $("#assignDispatchDate").val("");
      $("#assignEstimatedDelivery").val("");
      $("#assignHelperName").val("");
      $("#assignRemarks").val("");

      $("#assignVehicle")
        .prop("disabled", true)
        .html(`<option value="">Loading...</option>`);

      $.when(loadAssignDrivers(), loadAssignVehicles()).always(function () {
        $("#assignVehicle").prop("disabled", false);
      });

      // getOrCreateInstance (not `new bootstrap.Modal`) — this modal gets
      // opened repeatedly (row click, barcode scan, post-approve handoff),
      // and constructing a fresh instance on top of an existing one is
      // what throws "Cannot read properties of undefined (reading
      // 'backdrop')" from bootstrap's internals.
      const assignModalEl = document.getElementById("assignShipmentModal");
      if (!assignModalEl) {
        console.error(
          "[shipmentRequest] #assignShipmentModal not found in DOM.",
        );
        return;
      }
      bootstrap.Modal.getOrCreateInstance(assignModalEl).show();
    }
    window.openAssignShipmentModal = openAssignShipmentModal;

    $(document).on("click", ".assignShipmentBtn", function () {
      const shipmentId = $(this).data("id");
      const ticket = $(this).data("ticket");
      const priority = $(this).data("priority");

      openAssignShipmentModal(shipmentId, ticket, priority);
    });

    // =====================================
    // SAVE ASSIGNMENT
    // =====================================
    $("#saveAssignmentBtn").click(function () {
      const data = {
        shipment_id: $("#assignShipmentId").val(),
        ticket_number: $("#assignTicketNumber").val(),
        dispatch_number: $("#assignDispatchNumber").val(),
        driver_id: $("#assignDriver").val(),
        vehicle_id: $("#assignVehicle").val(),
        helper_name: $("#assignHelperName").val(),
        dispatch_date: $("#assignDispatchDate").val(),
        estimated_delivery: $("#assignEstimatedDelivery").val(),
        remarks: $("#assignRemarks").val(),
      };

      if (!data.driver_id) {
        showToast("warning", "Please select a driver.");
        return;
      }
      if (!data.vehicle_id) {
        showToast("warning", "Please select a vehicle.");
        return;
      }
      if (!data.dispatch_date) {
        showToast("warning", "Please set a dispatch date.");
        return;
      }

      $.ajax({
        url: "/shipmentDispatch/assign",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(data),

        beforeSend: function () {
          $("#saveAssignmentBtn").prop("disabled", true).html(`
                <span class="spinner-border spinner-border-sm"></span>
                Saving...
            `);
        },

        success: function (res) {
          showToast("success", res.message || "Assigned successfully.");
          $("#assignShipmentModal").modal("hide");
          printShipmentsByTickets([$("#assignTicketNumber").val()]);
          loadShipments();
        },

        error: function (xhr) {
          console.error(xhr);
          showToast("error", xhr.responseJSON?.message || "Assignment failed.");
        },

        complete: function () {
          $("#saveAssignmentBtn")
            .prop("disabled", false)
            .html("Save Assignment");
        },
      });
    });

    /* ============================================================
   PRINT SHIPMENT REQUESTS — GROUPED BY ASSIGNED DRIVER
   ============================================================ */
    function fetchShipmentDetails(ticketNumbers) {
      const requests = ticketNumbers.map(
        (ticket) =>
          new Promise((resolve) => {
            $.ajax({
              url: "/shipmentRequest/get-shipment/" + ticket,
              method: "GET",
              cache: false,
              success: (res) => resolve({ ok: true, ticket, res }),
              error: (xhr) => resolve({ ok: false, ticket, xhr }),
            });
          }),
      );

      return Promise.all(requests);
    }

    function groupByDriver(results) {
      const groups = {};

      results.forEach((r) => {
        if (!r.ok || !r.res.dispatch) {
          if (!r.ok)
            console.warn(`Failed to load shipment ${r.ticket} for printing.`);
          return;
        }

        const { header, items, dispatch } = r.res;
        const key = dispatch.driver_id || dispatch.driver_name || "Unassigned";

        if (!groups[key]) {
          groups[key] = {
            driverLabel: dispatch.driver_name
              ? `${dispatch.driver_code || ""} - ${dispatch.driver_name}`.trim()
              : "Unassigned Driver",
            vehicleLabel: dispatch.vehicle_code
              ? `${dispatch.vehicle_code} (${dispatch.plate_number || ""})`
              : "-",
            shipments: [],
          };
        }

        groups[key].shipments.push({ header, items, dispatch });
      });

      return groups;
    }

    function buildDriverPrintHtml(driverGroups) {
      const today = new Date().toLocaleDateString();
      let sections = "";

      for (const group of Object.values(driverGroups)) {
        const delivered = group.shipments.filter(
          (s) => s.dispatch.dispatch_status === "Delivered",
        );
        const pending = group.shipments.filter(
          (s) => s.dispatch.dispatch_status !== "Delivered",
        );

        sections += `
      <div class="driver-section">
        <div class="driver-header">
          <h2>${group.driverLabel}</h2>
          <div>
            <div><strong>Vehicle:</strong> ${group.vehicleLabel}</div>
            <span class="print-date">Printed: ${today}</span>
          </div>
        </div>

        ${buildStatusSection("Pending / In Transit", pending, "warning")}
        ${buildStatusSection("Delivered", delivered, "success")}
      </div>`;
      }

      return `
    <!DOCTYPE html>
    <html>
    <head>
      <meta charset="UTF-8">
      <title>Assigned Shipments by Driver</title>
      <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #333; font-size: 13px; }
        .driver-section { page-break-after: always; margin-bottom: 20px; }
        .driver-section:last-child { page-break-after: auto; }
        .driver-header {
          display: flex; justify-content: space-between; align-items: flex-start;
          border-bottom: 2px solid #198754; padding-bottom: 8px; margin-bottom: 14px;
        }
        .driver-header h2 { margin: 0; color: #198754; }
        .print-date { font-size: 11px; color: #666; }

        .status-section { margin-bottom: 18px; }
        .status-title {
          font-size: 14px; font-weight: bold; margin-bottom: 8px;
          padding: 4px 8px; border-radius: 4px; display: inline-block;
        }
        .status-title.warning { background: #fff3cd; color: #664d03; }
        .status-title.success { background: #d1e7dd; color: #0f5132; }
        .empty-note { font-size: 12px; color: #999; font-style: italic; margin-bottom: 10px; }

        .shipment-meta {
          display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px;
          margin-bottom: 8px; font-size: 12px;
        }
        .print-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
        .print-table th, .print-table td { border: 1px solid #ccc; padding: 6px; text-align: left; }
        .print-table th { background: #f2f2f2; }
        .remarks { font-size: 12px; margin-bottom: 10px; }
        .shipment-divider { border: none; border-top: 1px dashed #bbb; margin: 14px 0; }
      </style>
    </head>
    <body>${sections}</body>
    </html>`;
    }

    function buildStatusSection(label, shipments, colorClass) {
      if (shipments.length === 0) {
        return `
      <div class="status-section">
        <div class="status-title ${colorClass}">${label} (0)</div>
        <div class="empty-note">No shipments in this category.</div>
      </div>`;
      }

      const blocks = shipments
        .map(({ header, items, dispatch }) => {
          const itemRows = items
            .map(
              (item) => `
            <tr>
              <td>${item.type_name || "-"}</td>
              <td>${item.product_name || item.inventory_name || "-"}</td>
              <td>${item.unit_name || "-"}</td>
              <td class="text-center">${item.quantity}</td>
            </tr>`,
            )
            .join("");

          return `
        <div class="shipment-block">
          <div class="shipment-meta">
            <div><strong>Ticket:</strong> ${header.ticket_number}</div>
            <div><strong>Dispatch #:</strong> ${dispatch.dispatch_number || "-"}</div>
             <div><strong>Store:</strong> ${header.store_name || "-"}</div>
             <div><strong>Store Address:</strong> ${header.store_address || "-"}</div>
            <div><strong>Priority:</strong> ${header.priority}</div>
            <div><strong>Dispatch Date:</strong> ${dispatch.dispatch_date ? new Date(dispatch.dispatch_date).toLocaleString() : "-"}</div>
            <div><strong>${dispatch.dispatch_status === "Delivered" ? "Delivered At" : "Est. Delivery"}:</strong>
              ${
                dispatch.dispatch_status === "Delivered"
                  ? dispatch.delivered_at
                    ? new Date(dispatch.delivered_at).toLocaleString()
                    : "-"
                  : dispatch.estimated_delivery
                    ? new Date(dispatch.estimated_delivery).toLocaleString()
                    : "-"
              }
            </div>
            <div><strong>Helper:</strong> ${dispatch.helper_name || "-"}</div>
          </div>
          <table class="print-table">
            <thead>
              <tr><th>Type</th><th>Item</th><th>Unit</th><th>Qty</th></tr>
            </thead>
