    const STATUS_FILL = {
      Pending: "FFFFF3CD",
      "In Transit": "FFCFF4FC",
      Dispatched: "FFE2E3E5",
      Delivered: "FFD1E7DD",
      Cancelled: "FFF8D7DA",
    };
    const STATUS_FONT = {
      Pending: "FF664D03",
      "In Transit": "FF055160",
      Dispatched: "FF41464B",
      Delivered: "FF0F5132",
      Cancelled: "FF842029",
    };

    const HEADER_FILL = "FF198754";
    const HEADER_FONT = "FFFFFFFF";
    const THIN_BORDER = {
      top: { style: "thin", color: { argb: "FFD0D0D0" } },
      left: { style: "thin", color: { argb: "FFD0D0D0" } },
      bottom: { style: "thin", color: { argb: "FFD0D0D0" } },
      right: { style: "thin", color: { argb: "FFD0D0D0" } },
    };

    const _measureCanvas = document.createElement("canvas");
    const _measureCtx = _measureCanvas.getContext("2d");

    function countWrappedLines(text, pixelWidth, font) {
      if (!text) return 1;

      _measureCtx.font = font;

      const words = String(text).split(/\s+/).filter(Boolean);
      if (words.length === 0) return 1;

      let lines = 1;
      let currentLineWidth = 0;
      const spaceWidth = _measureCtx.measureText(" ").width;

      for (const word of words) {
        const wordWidth = _measureCtx.measureText(word).width;

        if (wordWidth > pixelWidth) {
          lines += Math.ceil(wordWidth / pixelWidth);
          currentLineWidth = 0;
          continue;
        }

        const testWidth =
          currentLineWidth === 0
            ? wordWidth
            : currentLineWidth + spaceWidth + wordWidth;

        if (testWidth > pixelWidth) {
          lines++;
          currentLineWidth = wordWidth;
        } else {
          currentLineWidth = testWidth;
        }
      }

      return lines;
    }

    function excelColWidthToPixels(charWidth) {
      const rawPixels = charWidth * 7 + 5;
      const CELL_PADDING = 10;
      const SAFETY_FACTOR = 0.92;
      return Math.floor((rawPixels - CELL_PADDING) * SAFETY_FACTOR);
    }

    function filterGroupsByStatus(driverGroups, statusFilter) {
      if (statusFilter === "__all__") return driverGroups;

      const filtered = {};

      Object.entries(driverGroups).forEach(([key, group]) => {
        const shipments = group.shipments.filter((s) => {
          const isDelivered = s.dispatch.dispatch_status === "Delivered";
          return statusFilter === "delivered" ? isDelivered : !isDelivered;
        });

        if (shipments.length > 0) {
          filtered[key] = { ...group, shipments };
        }
      });

      return filtered;
    }

    async function buildShipmentWorkbook(driverGroups) {
      const workbook = new ExcelJS.Workbook();
      workbook.creator = "Shipment System";
      workbook.created = new Date();

      const FONT_SPEC = "11px Calibri, Arial, sans-serif";

      const columns = [
        { header: "Ticket #", key: "ticket", width: 14 },
        { header: "Dispatch #", key: "dispatch", width: 16 },
        { header: "Store", key: "store", width: 24 },
        { header: "Priority", key: "priority", width: 10 },
        { header: "Type", key: "type", width: 25 },
        { header: "Item", key: "item", width: 26 },
        { header: "Unit", key: "unit", width: 10 },
        { header: "Qty", key: "qty", width: 8 },
        { header: "Status", key: "status", width: 14 },
        { header: "Dispatch Date", key: "dispatchDate", width: 25 },
        { header: "Est. / Delivered", key: "deliveryDate", width: 25 },
        { header: "Helper", key: "helper", width: 16 },
        { header: "Remarks", key: "remarks", width: 24 },
      ];

      for (const group of Object.values(driverGroups)) {
        const safeName = group.driverLabel
          .replace(/[\[\]\*\?\/\\:]/g, "")
          .slice(0, 31);

        const sheet = workbook.addWorksheet(safeName || "Driver", {
          views: [{ state: "frozen", ySplit: 3 }],
          pageSetup: {
            orientation: "landscape",
            paperSize: 9,
            fitToPage: true,
            fitToWidth: 1,
            fitToHeight: 0,
            margins: {
              left: 0.4,
              right: 0.4,
              top: 0.5,
              bottom: 0.6,
              header: 0.2,
              footer: 0.3,
            },
            horizontalCentered: true,
          },
        });

        sheet.columns = columns;
        sheet.pageSetup.printTitlesRow = "3:3";

        sheet.headerFooter = {
          oddHeader: `&L&8Shipment Report — ${group.driverLabel}&R&8Generated: ${new Date().toLocaleString()}`,
          oddFooter: `&C&8Page &P of &N&R&8Confidential — Internal Use Only`,
        };
        sheet.columns = columns;
        sheet.pageSetup.printTitlesRow = "3:3";

        sheet.mergeCells(1, 1, 1, columns.length);
        const titleCell = sheet.getCell(1, 1);
        titleCell.value = `Assigned Shipments — ${group.driverLabel}`;
        titleCell.font = { bold: true, size: 14, color: { argb: HEADER_FONT } };
        titleCell.alignment = { vertical: "middle", horizontal: "center" };
        titleCell.fill = {
          type: "pattern",
          pattern: "solid",
          fgColor: { argb: HEADER_FILL },
        };
        sheet.getRow(1).height = 26;

        sheet.mergeCells(2, 1, 2, columns.length);
        const subCell = sheet.getCell(2, 1);
        subCell.value = `Vehicle: ${group.vehicleLabel}   |   Generated: ${new Date().toLocaleString()}`;
        subCell.font = { italic: true, size: 10, color: { argb: "FF555555" } };
        subCell.alignment = { vertical: "middle", horizontal: "center" };

        const headerRow = sheet.getRow(3);
        columns.forEach((col, i) => {
          const cell = headerRow.getCell(i + 1);
          cell.value = col.header;
          cell.font = { bold: true, color: { argb: HEADER_FONT } };
          cell.fill = {
            type: "pattern",
            pattern: "solid",
            fgColor: { argb: HEADER_FILL },
          };
          cell.border = THIN_BORDER;
          cell.alignment = {
            vertical: "middle",
            horizontal: "center",
            wrapText: true,
          };
        });
        headerRow.height = 20;

        let rowIndex = 4;
        group.shipments.forEach(({ header, items, dispatch }) => {
          items.forEach((item, itemIdx) => {
            const row = sheet.getRow(rowIndex);
            row.values = {
              ticket: header.ticket_number,
              dispatch: dispatch.dispatch_number || "-",
              store: header.store_name || "-",
              priority: header.priority,
              type: item.type_name || "-",
              item: item.product_name || item.inventory_name || "-",
              unit: item.unit_name || "-",
              qty: item.quantity,
              status: dispatch.dispatch_status || "-",
              dispatchDate: dispatch.dispatch_date
                ? new Date(dispatch.dispatch_date).toLocaleString()
                : "-",
              deliveryDate:
                dispatch.dispatch_status === "Delivered"
                  ? dispatch.delivered_at
                    ? new Date(dispatch.delivered_at).toLocaleString()
                    : "-"
                  : dispatch.estimated_delivery
                    ? new Date(dispatch.estimated_delivery).toLocaleString()
                    : "-",
              helper: dispatch.helper_name || "-",
              remarks: itemIdx === 0 ? dispatch.remarks || "" : "",
            };

            const bandFill = rowIndex % 2 === 0 ? "FFF7F7F7" : "FFFFFFFF";

            columns.forEach((col, i) => {
              const cell = row.getCell(i + 1);
              cell.border = THIN_BORDER;
              cell.alignment = {
                vertical: "middle",
                horizontal: "center",
                wrapText: true,
              };
              if (col.key !== "status") {
                cell.fill = {
                  type: "pattern",
                  pattern: "solid",
                  fgColor: { argb: bandFill },
                };
              }
            });

            const statusCell = row.getCell(9);
            statusCell.fill = {
              type: "pattern",
              pattern: "solid",
              fgColor: {
                argb: STATUS_FILL[dispatch.dispatch_status] || "FFF1F1F1",
              },
            };
            statusCell.font = {
              bold: true,
              color: {
                argb: STATUS_FONT[dispatch.dispatch_status] || "FF333333",
              },
            };
            statusCell.alignment = {
              vertical: "middle",
              horizontal: "center",
              wrapText: true,
            };

            const estimatedLines = Math.max(
              ...columns.map((col, i) => {
                const value = row.getCell(i + 1).value;
                const text = value ? String(value) : "";
                const pixelWidth = excelColWidthToPixels(col.width);
                return countWrappedLines(text, pixelWidth, FONT_SPEC);
              }),
            );

            row.height = Math.min(150, Math.max(18, estimatedLines * 15 + 4));

            rowIndex++;
          });
        });

        sheet.autoFilter = {
          from: { row: 3, column: 1 },
          to: { row: 3, column: columns.length },
        };
      }

      const buffer = await workbook.xlsx.writeBuffer();
      const blob = new Blob([buffer], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const filename = `assigned-shipments-${new Date().toISOString().slice(0, 10)}.xlsx`;
      saveAs(blob, filename);
    }

