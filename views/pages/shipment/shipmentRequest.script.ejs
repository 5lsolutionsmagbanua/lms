    function bindEvents() {
      $("#typeSelect").change(function () {
        const text = $("#typeSelect option:selected").text().toLowerCase();
        if (text.includes("non-serialized")) {
          $("#unitGroup").removeClass("d-none");
        } else {
          $("#unitGroup").addClass("d-none");
          $("#unitSelect").val("");
        }
        validateItemFields();
      });

      $("#addItemBtn").click(addItem);

      $("#shipmentRequestForm").submit(function (e) {
        e.preventDefault();
        saveShipment();
      });

      $(document).on("click", ".removeItemBtn", function () {
        requestItems.splice($(this).data("index"), 1);
        renderItems();
      });

      $(document).on("input", ".quantityInput", function () {
        const index = $(this).data("index");
        const qty = parseFloat($(this).val());
        if (qty > 0) requestItems[index].quantity = qty;
      });

      $("#productSelect").on("change", validateItemFields);
      $("#unitSelect").on("change", validateItemFields);
      $("#quantity").on("keyup change", validateItemFields);

      $("#requestType").change(function () {
        const type = $(this).val();
        $(
          "#targetBranchGroup, #storeGroup, #ticketGroup, #customerGroup, #unitGroup",
        ).addClass("d-none");

        if (type == "1") {
          $("#storeGroup, #ticketGroup").removeClass("d-none");
        } else if (type == "2") {
          $("#targetBranchGroup").removeClass("d-none");
        } else if (type == "3") {
          $("#customerGroup, #unitGroup").removeClass("d-none");
        }
      });

      $("#searchShipment").on("keyup", applyFilters);
      $("#filterPriority").change(applyFilters);
      $("#filterStatus").change(applyFilters);

      $(document).on("click", "#previousPage", function (e) {
        e.preventDefault();
        if (currentPage > 1) {
          currentPage--;
          renderShipmentTable();
        }
      });

      $(document).on("click", "#nextPage", function (e) {
        e.preventDefault();
        const totalPages = Math.ceil(filteredShipments.length / rowsPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          renderShipmentTable();
        }
      });

      $(document).on("click", ".pageNumber", function (e) {
        e.preventDefault();
        currentPage = Number($(this).data("page"));
        renderShipmentTable();
      });

      $(document).on("click", "#printBarcodeBtn", function () {
        const svg = document.getElementById("viewBarcodeSvg").outerHTML;
        const printWindow = window.open("", "_blank");
        printWindow.document.write(`
    <html>
      <head><title>Print Barcode</title></head>
      <body style="text-align:center; margin-top:40px;">
        ${svg}
      </body>
    </html>
  `);
        printWindow.document.close();
        printWindow.print();
      });
    }
  });

  // Keep it focused by default so scans land here without clicking first
  $("#barcodeScanInput").trigger("focus");
  $(document).on("click", function (e) {
    if (!$(e.target).is("input, textarea, select, button, .btn")) {
      $("#barcodeScanInput").trigger("focus");
    }
  });

  $("#barcodeScanInput").on("keypress", function (e) {
    if (e.which === 13) {
      e.preventDefault();
      submitBarcodeInput();
    }
  });

  $(document).on("click", "#barcodeSubmitBtn", function () {
    submitBarcodeInput();
  });

  function submitBarcodeInput() {
    const scannedValue = $("#barcodeScanInput").val().trim();
    $("#barcodeScanInput").val("");
    handleBarcodeScan(scannedValue);
  }

  function showToast(icon, message) {
    Swal.fire({
      toast: true,
      position: "top-end",
      icon: icon, // 'success' | 'error' | 'warning' | 'info'
      title: message,
      showConfirmButton: false,
      timer: 2200,
      timerProgressBar: true,
    });
  }

  function handleBarcodeScan(barcodeValue) {
    if (!barcodeValue) return;

    const shipment = allShipments.find(
      (x) => String(x.barcode) === barcodeValue,
    );

    if (!shipment) {
      showToast("error", `No shipment found for barcode: ${barcodeValue}`);
      flashScanInput("danger");
      return;
    }

    if (Number(shipment.is_assigned) === 1) {
      showToast("warning", `${shipment.ticket_number} is already assigned.`);
      flashScanInput("warning");
      return;
    }

    flashScanInput("success");
    showToast(
      "success",
      `Scanned ${shipment.ticket_number} — opening assignment...`,
    );

    openAssignShipmentModal(
      shipment.shipment_id,
      shipment.ticket_number,
      shipment.priority,
    );
  }

  function flashScanInput(type) {
    const input = $("#barcodeScanInput");
    const cls = type === "success" ? "is-valid" : "is-invalid";
    input.addClass(cls);
    setTimeout(() => input.removeClass(cls), 600);
  }

  // ==============================
  // BULK SELECTION
  // ==============================
  $(document).on("change", "#selectAllShipments", function () {
    $(".shipmentCheckbox").prop("checked", $(this).is(":checked"));
    updateBulkAssignState();
  });

  $(document).on("change", ".shipmentCheckbox", updateBulkAssignState);

  function updateBulkAssignState() {
    const count = $(".shipmentCheckbox:checked").length;
    $("#bulkAssignBtn").prop("disabled", count === 0);
    $("#selectedCountLabel").text(count > 0 ? `${count} selected` : "");
  }

  $("#bulkAssignBtn").click(function () {
    const selectedIds = $(".shipmentCheckbox:checked")
      .map(function () {
        return $(this).val();
      })
      .get();

    if (selectedIds.length === 0) return;

    $("#bulkAssignSummary").text(
      `Assigning ${selectedIds.length} shipment(s) to one driver and vehicle.`,
    );
    $(
      "#bulkDispatchDate, #bulkEstimatedDelivery, #bulkHelperName, #bulkRemarks",
    ).val("");

    $("#bulkAssignDriver").html(`<option value="">Loading...</option>`);
    $("#bulkAssignVehicle").html(`<option value="">Loading...</option>`);

    $.when(
      $.get("/shipmentRequest/drivers/list"),
      $.get("/shipmentRequest/vehicles/list"),
    ).done(function (driverRes, vehicleRes) {
      const drivers = driverRes[0];
      const vehicles = vehicleRes[0];

      let driverOptions = `<option value="">Select Driver</option>`;
      drivers.forEach((d) => {
        driverOptions += `<option value="${d.id}">${d.driver_code} - ${d.driver_name}</option>`;
      });
      $("#bulkAssignDriver").html(driverOptions);

      let vehicleOptions = `<option value="">Select Vehicle</option>`;
      vehicles.forEach((v) => {
        vehicleOptions += `<option value="${v.id}">${v.vehicle_code} (${v.plate_number})</option>`;
      });
      $("#bulkAssignVehicle").html(vehicleOptions);
    });

    bootstrap.Modal.getOrCreateInstance(
      document.getElementById("bulkAssignModal"),
    ).show();
  });

  $("#saveBulkAssignBtn").click(function () {
    const selectedIds = $(".shipmentCheckbox:checked")
      .map(function () {
        return $(this).val();
      })
      .get();

    const driverId = $("#bulkAssignDriver").val();
    const vehicleId = $("#bulkAssignVehicle").val();
    const dispatchDate = $("#bulkDispatchDate").val();
    const estimatedDelivery = $("#bulkEstimatedDelivery").val();
    const helperName = $("#bulkHelperName").val();
    const remarks = $("#bulkRemarks").val();

    if (!driverId) {
      showToast("warning", "Please select a driver.");
      return;
    }
    if (!vehicleId) {
      showToast("warning", "Please select a vehicle.");
      return;
    }
    if (!dispatchDate) {
      showToast("warning", "Please set a dispatch date.");
      return;
    }
    if (selectedIds.length === 0) {
      showToast("warning", "No shipments selected.");
      return;
    }

    $.ajax({
      url: "/shipmentDispatch/assign",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify({
        shipment_ids: selectedIds,
        dispatch_number: generateDispatchNumber(selectedIds[0]),
        driver_id: driverId,
        vehicle_id: vehicleId,
        helper_name: helperName,
        dispatch_date: dispatchDate,
        estimated_delivery: estimatedDelivery,
        remarks: remarks,
      }),

      beforeSend: function () {
        $("#saveBulkAssignBtn").prop("disabled", true).html(`
        <span class="spinner-border spinner-border-sm"></span> Assigning...
      `);
      },
      success: function (res) {
        $("#bulkAssignModal").modal("hide");
        $("#selectAllShipments").prop("checked", false);

        showToast("success", res.message || "Shipments assigned.");

        const tickets = allShipments
          .filter((s) => selectedIds.includes(String(s.shipment_id)))
          .map((s) => s.ticket_number);
        printShipmentsByTickets(tickets);

        loadShipments();
      },

      error: function (xhr) {
        showToast(
          "error",
          xhr.responseJSON?.message || "Unable to assign shipments.",
        );
      },

      complete: function () {
        $("#saveBulkAssignBtn").prop("disabled", false).html(`
        <i class="bi bi-check-circle me-1"></i> Assign All
      `);
      },
    });
  });

  /* ============================================================
   VIEW SHIPMENT
   ============================================================ */
  function viewShipment(ticket) {
    $("#viewItemsBody").html(`
    <tr>
      <td colspan="5" class="text-center py-4">
        <div class="spinner-border spinner-border-sm text-primary"></div>
        <br><br>
        Loading shipment...
      </td>
    </tr>
  `);

    $.ajax({
      url: "/shipmentRequest/get-shipment/" + ticket,
      type: "GET",
      cache: false,

      success: function (res) {
        const shipment = res.header;
        const items = res.items || [];
        const dispatch = res.dispatch || null;
        const statusColors = {
          Pending: "warning",
          Approved: "primary",
          Preparing: "info",
          "In Transit": "info",
          Dispatched: "dark",
          Delivered: "success",
          Rejected: "danger",
          Cancelled: "danger",
          Picked: "secondary",
          Arrived: "info",
        };
        $("#viewTicketNumber").val(shipment.ticket_number);
        $("#viewStore").val(shipment.store_name);
        $("#viewPriority").val(shipment.priority);
        $("#viewStatus").val(shipment.status);
        $("#viewCreatedAt").val(new Date(shipment.created_at).toLocaleString());
        $("#viewNotes").val(shipment.notes || "");

        if (shipment.barcode) {
          JsBarcode("#viewBarcodeSvg", shipment.barcode, {
            format: "CODE128",
            displayValue: true,
            height: 60,
          });
          $("#viewBarcodeSvg").closest(".card").show();
        } else {
          $("#viewBarcodeSvg").closest(".card").hide();
        }

        let rows = "";
        if (items.length === 0) {
          rows = `
          <tr>
            <td colspan="5" class="text-center text-muted py-4">
              <i class="bi bi-box-seam fs-3"></i><br><br>
              No items found.
            </td>
          </tr>
        `;
        } else {
          items.forEach((item, index) => {
            const productName =
              item.product_name ||
              item.inventory_name ||
              item.productName ||
              "-";
            rows += `
            <tr>
              <td>${index + 1}</td>
              <td>${item.type_name || "-"}</td>
              <td>${productName}</td>
              <td>${item.unit_name || "-"}</td>
              <td class="text-center">${item.quantity}</td>
            </tr>
          `;
          });
        }

        if (dispatch) {
          $("#viewDispatchSection").removeClass("d-none");

          $("#viewDriver").val(
            dispatch.driver_name
              ? `${dispatch.driver_code || ""} - ${dispatch.driver_name}`.trim()
              : "Not assigned",
          );
          $("#viewVehicle").val(
            dispatch.vehicle_code
              ? `${dispatch.vehicle_code} (${dispatch.plate_number || ""})`
              : "Not assigned",
          );

          $("#viewDispatchStatus")
            .text(dispatch.dispatch_status || "-")
            .attr(
              "class",
              `badge rounded-pill px-3 py-2 bg-${statusColors[dispatch.dispatch_status] || "secondary"}`,
            );

          $("#viewDeliveredAt").val(
            dispatch.delivered_at
              ? new Date(dispatch.delivered_at).toLocaleString()
              : "Not yet delivered",
          );
          $("#viewDispatchDate").val(
            dispatch.dispatch_date
              ? new Date(dispatch.dispatch_date).toLocaleString()
              : "-",
          );
          $("#viewEstimatedDelivery").val(
            dispatch.estimated_delivery
              ? new Date(dispatch.estimated_delivery).toLocaleString()
              : "-",
          );
          $("#viewDeliveryRemarks").val(dispatch.remarks || "");

          if (dispatch.proof_photo_path) {
            let photoPaths = [];
            try {
              const parsed = JSON.parse(dispatch.proof_photo_path);
              photoPaths = Array.isArray(parsed)
                ? parsed
                : [dispatch.proof_photo_path];
            } catch (e) {
              photoPaths = [dispatch.proof_photo_path];
            }

            if (photoPaths.length > 0) {
              $("#viewProofPhotoGrid").html(
                photoPaths
                  .map(
                    (src) => `
                  <img src="${src}"
                    class="rounded border viewProofPhotoImg"
                    style="width:140px;height:140px;object-fit:cover;cursor:zoom-in;">
                `,
                  )
                  .join(""),
              );
              $("#viewProofPhotoGrid")
                .find(".viewProofPhotoImg")
                .on("click", function () {
                  window.open(this.src, "_blank");
                });
              $("#viewProofPhotoGrid").show();
              $("#viewProofPhotoEmpty").hide();
            } else {
              $("#viewProofPhotoGrid").hide().empty();
              $("#viewProofPhotoEmpty").show();
            }
          } else {
            $("#viewProofPhotoGrid").hide().empty();
            $("#viewProofPhotoEmpty").show();
          }
        } else {
          $("#viewDispatchSection").addClass("d-none");
        }
        $("#viewItemsBody").html(rows);
        $("#viewShipmentModal").modal("show");
      },

      error: function (xhr) {
        showToast(
          "error",
          xhr.responseJSON?.message || "Unable to load shipment.",
        );
      },
    });
  }

  /* ============================================================
   EDIT SHIPMENT MODAL

   STEP 1 ("form"): normal item-editing UI + "Save Changes".
   STEP 2 ("decision"): shown after a successful save, only when
   the shipment is still Pending and not dispatched — footer swaps
   to Approve / Reject instead of closing the modal outright.
   Re-opening the modal (editShipment()) always resets to Step 1.
   ============================================================ */
  function editShipment(ticket) {
    editShipmentId = null;
    editTicketNumber = ticket;
    editPriorityValue = null;
    editItems = [];
    editingRowIndex = -1;
    editIsDispatched = false;
    editStep = "form";

    $("#editShipmentId").val("");
    $("#editTicketNumber").val("");
    $("#editPriority").val("");
    $("#editNotes").val("");
    $("#editRequestItemsBody").empty();
    $("#editDispatchWarning").remove();
    setEditLocked(false);
    setEditModalStep("form");

    $.ajax({
      url: `/shipmentRequest/get-shipment/${ticket}`,
      type: "GET",

      beforeSend: function () {
        $("#editShipmentModal").modal("show");
        $("#editRequestItemsBody").html(`
        <tr>
          <td colspan="5" class="text-center">
            <div class="spinner-border spinner-border-sm me-2"></div>
            Loading shipment...
          </td>
        </tr>
      `);
      },

      success: function (res) {
        const { header, items, dispatch } = res;

        editShipmentId = header.shipment_id;
        editTicketNumber = header.ticket_number;
        editPriorityValue = header.priority;
        editIsDispatched = !!dispatch;

        $("#editShipmentId").val(header.shipment_id);
        $("#editTicketNumber").val(header.ticket_number);
        $("#editPriority").val(header.priority);
        $("#editStatus").val(header.status);
        $("#editNotes").val(header.notes);

        loadEditStores(header.store_id);
        loadEditTypes();
        loadEditUnits();
        loadEditProducts();

        editItems = items.map((item) => ({
          shipment_detail_id: item.shipment_detail_id,
          shipment_id: item.shipment_id,
          typeId: item.type_id,
          typeName: item.type_name,
          productId: item.product_id,
          productName: item.product_name,
          unitId: item.unit_id,
          unitName: item.unit_name,
          quantity: item.quantity,
        }));

        renderEditItems();
        setEditLocked(editIsDispatched);

        if (editIsDispatched) {
          $("#editRequestItemsBody").closest("table").before(`
            <div id="editDispatchWarning" class="alert alert-warning py-2 mb-2">
              <i class="bi bi-lock-fill me-1"></i>
              This shipment has already been dispatched and can no longer be edited.
            </div>
          `);
        }
      },

      error: function (xhr) {
        $("#editShipmentModal").modal("hide");
        showToast(
          "error",
          xhr.responseJSON?.message || "Unable to load shipment.",
        );
      },
    });
  }

  // Switches the edit modal's FOOTER between the item-editing step
  // and the approve/reject decision step. Does not touch the body —
  // the item form stays underneath, just visually locked, so the
  // decision step still shows what was just saved.
  function setEditModalStep(step) {
    editStep = step;

    if (step === "decision") {
      $("#editFormFooterBtns").addClass("d-none");
      $("#editDecisionFooterBtns").removeClass("d-none");
      setEditLocked(true);
    } else {
      $("#editFormFooterBtns").removeClass("d-none");
      $("#editDecisionFooterBtns").addClass("d-none");
    }
  }

  function setEditLocked(locked) {
    $(
      "#editStoreSelect, #editPriority, #editStatus, #editNotes, " +
        "#editTypeSelect, #editProductSelect, #editUnitSelect, #editQuantity, " +
        "#editAddItemBtn, #updateShipmentBtn",
    ).prop("disabled", locked);

    $(".editItemRow, .removeItemRow").prop("disabled", locked);
  }

  function loadEditStores(selected = "") {
    $.ajax({
      url: "/store/get-stores",
      method: "GET",
      success: function (res) {
        const stores = Array.isArray(res)
          ? res
          : (res.data ?? res.stores ?? []);

        let options = `<option value="">Select Store</option>`;

        stores.forEach((store) => {
          options += `
                    <option value="${store.id}">
                        ${store.store_name} (${store.store_code})
                    </option>
                `;
        });

        $("#editStoreSelect").html(options);

        if (selected) {
          $("#editStoreSelect").val(String(selected));
        }
      },
    });
  }

  function loadEditTypes(selected = "") {
    $.ajax({
      url: "/types/get-types",
      method: "GET",
      success: function (res) {
        let options = `<option value="">Select Type</option>`;
        res.forEach((type) => {
          options += `<option value="${type.id}">${type.type_name}</option>`;
        });
        $("#editTypeSelect").html(options).val(selected);
      },
    });
  }

  function loadEditUnits(selected = "") {
    $.ajax({
      url: "/units/get-units",
      method: "GET",
      success: function (res) {
        let options = `<option value="">Select Unit</option>`;
        res.forEach((unit) => {
          options += `<option value="${unit.id}">${unit.unit_name}</option>`;
        });
        $("#editUnitSelect").html(options).val(selected);
      },
    });
  }

  function loadEditProducts(selected = "") {
    $.ajax({
      url: "/products/get-products",
      method: "GET",
      success: function (res) {
        let options = `<option value="">Select Item</option>`;
        res.forEach((p) => {
          options += `<option value="${p.id}">${p.inventory_name}</option>`;
        });
        $("#editProductSelect").html(options);
        if (selected) $("#editProductSelect").val(selected);
      },
      error: function (xhr) {
        console.log(xhr.responseText);
      },
    });
  }

  function renderEditItems() {
    let rows = "";

    if (editItems.length === 0) {
      rows = `
      <tr>
        <td colspan="5" class="text-center text-muted">No items found.</td>
      </tr>
    `;
    } else {
      editItems.forEach((item, index) => {
        rows += `
        <tr>
          <td>${item.typeName ?? item.type_name ?? "-"}</td>
          <td>${item.productName ?? item.product_name ?? item.inventory_name ?? "-"}</td>
          <td>${item.unitName ?? item.unit_name ?? "-"}</td>
          <td class="text-center">${item.quantity}</td>
          <td class="text-center">
            <button class="btn btn-warning btn-sm editItemRow" data-index="${index}" ${editIsDispatched ? "disabled" : ""}>
              <i class="bi bi-pencil"></i>
            </button>
            <button class="btn btn-danger btn-sm removeItemRow" data-index="${index}" ${editIsDispatched ? "disabled" : ""}>
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>
      `;
      });
    }

    $("#editRequestItemsBody").html(rows);
  }

  function clearEditItemFields() {
    $("#editTypeSelect").val("");
    $("#editProductSelect").val("");
    $("#editUnitSelect").val("");
    $("#editQuantity").val("");
  }

  $(document).on("click", ".editItemRow", function () {
    if (editIsDispatched) return;

    editingRowIndex = $(this).data("index");
    const item = editItems[editingRowIndex];

    $("#editTypeSelect").val(item.typeId);
    loadEditProducts(item.productId);
    $("#editUnitSelect").val(item.unitId);
    $("#editQuantity").val(item.quantity);

    $("#editAddItemBtn")
      .removeClass("btn-success")
      .addClass("btn-primary")
      .html(`<i class="bi bi-check-lg"></i> Update Item`);
  });

  $(document).on("click", ".removeItemRow", function () {
    if (editIsDispatched) return;

    editItems.splice($(this).data("index"), 1);
    renderEditItems();
  });

  $("#editAddItemBtn").click(function () {
    if (editIsDispatched) return;

    if ($("#editProductSelect").val() == "") {
      showToast("warning", "Please select a product.");
      return;
    }
    if (
      $("#editQuantity").val() == "" ||
      Number($("#editQuantity").val()) <= 0
    ) {
      showToast("warning", "Please enter a valid quantity.");
      return;
    }

    const duplicate = editItems.find((item, index) => {
      return (
        item.typeId == $("#editTypeSelect").val() &&
        item.productId == $("#editProductSelect").val() &&
        item.unitId == $("#editUnitSelect").val() &&
        index !== editingRowIndex
      );
    });

    if (duplicate) {
      showToast("warning", "This product has already been added.");
      return;
    }

    const item = {
      typeId: $("#editTypeSelect").val(),
      typeName: $("#editTypeSelect option:selected").text(),
      productId: $("#editProductSelect").val(),
      productName: $("#editProductSelect option:selected").text(),
      unitId: $("#editUnitSelect").val(),
      unitName: $("#editUnitSelect option:selected").text(),
      quantity: Number($("#editQuantity").val()),
    };

    if (editingRowIndex === -1) {
      editItems.push(item);
    } else {
      editItems[editingRowIndex] = item;
      editingRowIndex = -1;
      $("#editAddItemBtn")
        .removeClass("btn-primary")
        .addClass("btn-success")
        .html(`<i class="bi bi-plus-lg"></i>`);
    }

    renderEditItems();
    clearEditItemFields();
  });

  // "Save Changes" — saves the item edits. If the shipment is still
  // Pending (and not dispatched), the footer swaps to Approve/Reject
  // instead of closing the modal.
  $("#updateShipmentBtn")
    .off("click")
    .on("click", function () {
      if (editIsDispatched) {
        showToast(
          "warning",
          "This shipment has already been dispatched and can no longer be edited.",
        );
        return;
      }

      if ($("#editStoreSelect").val() == "") {
        showToast("warning", "Please select a store.");
        return;
      }
      if ($("#editPriority").val() == "") {
        showToast("warning", "Please select priority.");
        return;
      }
      if ($("#editStatus").val() == "") {
        showToast("warning", "Please select a status.");
        return;
      }
      if (editItems.length === 0) {
        showToast("warning", "Please add at least one item.");
        return;
      }

      const invalidQty = editItems.find(
        (item) => !item.quantity || item.quantity <= 0,
      );
      if (invalidQty) {
        showToast("warning", "All quantities must be greater than zero.");
        return;
      }

      editPriorityValue = $("#editPriority").val();

      $.ajax({
        url: "/shipmentRequest/update-shipment",
        type: "PUT",
        contentType: "application/json",
        data: JSON.stringify({
          shipment_id: editShipmentId,
          store_id: $("#editStoreSelect").val(),
          priority: $("#editPriority").val(),
          notes: $("#editNotes").val(),
          status: $("#editStatus").val(),
          items: editItems,
        }),

        beforeSend: function () {
          $("#updateShipmentBtn")
            .prop("disabled", true)
            .html(
              `<span class="spinner-border spinner-border-sm"></span> Saving...`,
            );
        },

        success: function (res) {
          showToast("success", res.message || "Shipment updated.");
          window.loadShipments();

          const statusNow = $("#editStatus").val();
          if (statusNow === "Pending") {
            // Move to the Approve/Reject decision step instead of closing.
            setEditModalStep("decision");
          } else {
            document.activeElement.blur();
            $("#editShipmentModal").modal("hide");
            editItems = [];
            editingRowIndex = -1;
            renderEditItems();
          }
        },

        error: function (xhr) {
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to update shipment.",
          );
        },

        complete: function () {
          $("#updateShipmentBtn")
            .prop("disabled", false)
            .html(`<i class="bi bi-save"></i> Save Changes`);
        },
      });
    });

  // Decision step — Approve: confirm, mark Approved, then hand off
  // straight into the existing Assign Driver & Vehicle modal.
  $(document).on("click", "#editApproveBtn", function () {
    Swal.fire({
      title: "Approve Shipment?",
      text: `Ticket No. ${editTicketNumber}`,
      icon: "question",
      showCancelButton: true,
      confirmButtonColor: "#0dcaf0",
      confirmButtonText: "Yes, Approve",
    }).then((result) => {
      if (!result.isConfirmed) return;

      $.ajax({
        url: "/shipmentRequest/approve-shipment/" + editTicketNumber,
        type: "PUT",
        success: function (res) {
          showToast("success", res.message || "Shipment approved.");

          document.activeElement.blur();
          $("#editShipmentModal").modal("hide");
          window.loadShipments();

          $("#editShipmentModal").one("hidden.bs.modal", function () {
            // Bootstrap needs a beat to finish tearing down the previous
            // modal's backdrop before a new one opens cleanly; combined
            // with getOrCreateInstance() above, this avoids the
            // "reading 'backdrop'" crash when this fires right after hide.
            setTimeout(function () {
              openAssignShipmentModal(
                editShipmentId,
                editTicketNumber,
                editPriorityValue,
              );
            }, 50);
          });
        },
        error: function (xhr) {
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to approve shipment.",
          );
        },
      });
    });
  });

  // Decision step — Reject: confirm, mark Rejected, close out.
  $(document).on("click", "#editRejectBtn", function () {
    Swal.fire({
      title: "Reject Shipment?",
      text: `Ticket No. ${editTicketNumber}`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      confirmButtonText: "Yes, Reject",
    }).then((result) => {
      if (!result.isConfirmed) return;

      $.ajax({
        url: "/shipmentRequest/reject-shipment/" + editTicketNumber,
        type: "PUT",
        success: function (res) {
          showToast("success", res.message || "Shipment rejected.");

          document.activeElement.blur();
          $("#editShipmentModal").modal("hide");
          window.loadShipments();
        },
        error: function (xhr) {
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to reject shipment.",
          );
        },
      });
    });
  });

  /* ============================================================
   HELPERS
   ============================================================ */
  function generateDispatchNumber(shipmentId) {
    const year = new Date().getFullYear();
    return `DSP-${year}-${String(shipmentId).padStart(6, "0")}`;
  }

  function generateBarcode(shipmentId) {
    return `SHP-${String(shipmentId).padStart(6, "0")}`;
  }
</script>
 