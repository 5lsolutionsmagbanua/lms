    function addItem() {
      const typeId = $("#typeSelect").val();
      const typeName = $("#typeSelect option:selected").text();
      const productId = $("#productSelect").val();
      const productName = $("#productSelect option:selected").text();
      const unitId = $("#unitSelect").val();
      const unitName = $("#unitSelect option:selected").text();
      const quantity = parseFloat($("#quantity").val());

      if (!typeId || !productId || !unitId || quantity <= 0) {
        showToast("warning", "Please complete all item details.");
        return;
      }

      const exists = requestItems.find((item) => item.productId == productId);
      if (exists) {
        showToast("warning", "This item has already been added.");
        return;
      }

      requestItems.push({
        typeId,
        typeName,
        productId,
        productName,
        unitId,
        unitName,
        quantity,
      });
      renderItems();

      $("#productSelect").val("");
      $("#unitSelect").val("");
      $("#quantity").val("");
      validateItemFields();
    }

    function renderItems() {
      let html = "";

      if (requestItems.length === 0) {
        html = `
        <tr>
          <td colspan="5" class="text-center text-muted py-4">
            <i class="bi bi-cart-x fs-3"></i><br>
            No items added yet.
          </td>
        </tr>
      `;
      } else {
        requestItems.forEach((item, index) => {
          html += `
          <tr>
            <td>${item.typeName}</td>
            <td>${item.productName}</td>
            <td>${item.unitName}</td>
            <td width="120">
              <input type="number" min="1" class="form-control quantityInput" data-index="${index}" value="${item.quantity}">
            </td>
            <td class="text-center">
              <button type="button" class="btn btn-danger btn-sm removeItemBtn" data-index="${index}">
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>
        `;
        });
      }

      $("#requestItemsBody").html(html);
    }

    function validateItemFields() {
      const typeId = $("#typeSelect").val();
      const productId = $("#productSelect").val();
      const unitId = $("#unitSelect").val();
      const quantity = $("#quantity").val();
      const complete =
        typeId && productId && unitId && quantity && parseFloat(quantity) > 0;

      $("#addItemBtn").prop("disabled", !complete);
      $("#addItemBtn")
        .toggleClass("btn-success", !!complete)
        .toggleClass("btn-secondary", !complete);
    }

    function saveShipment() {
      if ($("#storeSelect").val() == "") {
        showToast("warning", "Please select a store.");
        return;
      }
      if ($("#priority").val() == "") {
        showToast("warning", "Please select a priority.");
        return;
      }
      if (requestItems.length === 0) {
        showToast("warning", "Please add at least one item.");
        return;
      }

      const invalidQty = requestItems.find(
        (item) => !item.quantity || Number(item.quantity) <= 0,
      );
      if (invalidQty) {
        showToast("warning", "All quantities must be greater than zero.");
        return;
      }

      const data = {
        request_type: $("#requestType").val(),
        ticket_number: $("#ticket_number").val(),
        store_id: $("#storeSelect").val(),
        priority: $("#priority").val(),
        notes: $("#notes").val(),
        items: requestItems,
      };

      $.ajax({
        url: "/shipmentRequest/add-shipment",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(data),

        beforeSend: function () {
          $("#saveShipmentBtn").prop("disabled", true).html(`
          <span class="spinner-border spinner-border-sm me-2"></span> Saving...
        `);
        },

        success: function (res) {
          showToast("success", res.message || "Shipment saved successfully.");

          loadShipments(function () {
            $("#shipmentId").val(res.shipment.shipment_id);
            $("#ticketNumber").val(res.shipment.ticket_number);
            $("#dispatchNumber").val(res.shipment.dispatch_number);
            $("#shipmentPriority").val(res.shipment.priority);

            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            $("#dispatchDate").val(now.toISOString().slice(0, 16));

            loadDrivers();
            loadVehicles();

            const shipmentModal = bootstrap.Modal.getInstance(
              document.getElementById("addShipmentRequestModal"),
            );
            shipmentModal.hide();

            $("#addShipmentRequestModal").one("hidden.bs.modal", function () {
              requestItems = [];
              editingRowIndex = -1;
              renderItems();

              $("#shipmentRequestForm")[0].reset();
              $("#ticket_number")
                .val("")
                .prop("disabled", true)
                .prop("readonly", true);

              $("#productSelect").empty();
              $("#unitSelect").empty();
              $("#quantity").val("");

              loadProducts();
              validateItemFields();

              bootstrap.Modal.getOrCreateInstance(
                document.getElementById("assignModal"),
              ).show();
            });
          });
        },

        error: function (xhr) {
          showToast(
            "error",
            xhr.responseJSON?.message || "Unable to save shipment.",
          );
        },

        complete: function () {
          $("#saveShipmentBtn").prop("disabled", false).html(`
          <i class="bi bi-save me-1"></i> Save Shipment
        `);
        },
      });
    }

