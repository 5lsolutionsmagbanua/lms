<div class="modal fade" id="editReturnModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-pencil"></i> Edit Shipment Return
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Return No</label>
            <input class="form-control" value="RT-0001" readonly />
          </div>

          <div class="col-md-4">
            <label class="form-label">Reference No</label>
            <input class="form-control" value="SO-2026-001" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Client</label>
            <input class="form-control" value="ABC Trading" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Reason</label>
            <textarea class="form-control">Damaged items</textarea>
          </div>

          <div class="col-md-6">
            <label class="form-label">Status</label>
            <select class="form-select">
              <option selected>Pending</option>
              <option>Approved</option>
              <option>Rejected</option>
            </select>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">Update</button>
      </div>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 p-4 border-bottom"
      >
        <!-- TITLE -->
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-arrow-return-left"></i>
            Shipment Return
          </h2>

          <p class="text-muted mb-0">Manage returned shipments and items.</p>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex gap-2">
          <button class="btn btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

          <button
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addReturnModal"
          >
            <i class="bi bi-plus-circle"></i>
            Add Return
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pt-3">
        <input
          type="search"
          class="form-control form-control-sm"
          placeholder="Search returns..."
          data-table-search="returnTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive px-3 pb-3">
        <table
          class="table align-middle"
          id="returnTable"
          data-searchable-table
        >
          <thead>
            <tr>
              <th>ID</th>
              <th>Return No.</th>
              <th>Reference No.</th>
              <th>Client</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Created At</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>1</td>
              <td>RT-0001</td>
              <td>SO-2026-001</td>
              <td>ABC Trading</td>
              <td>Damaged items</td>

              <td>
                <span class="badge text-bg-warning"> Pending </span>
              </td>

              <td>2026-06-01</td>

              <td class="text-end">
                <button
                  class="btn btn-light btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewReturnModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <button
                  class="btn btn-primary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#editReturnModal"
                >
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<div class="modal fade" id="addReturnModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-plus-circle"></i> Add Shipment Return
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Return No</label>
            <input class="form-control" value="RT-0001" readonly />
          </div>

          <div class="col-md-4">
            <label class="form-label">Reference No</label>
            <input class="form-control" placeholder="SO-2026-001" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Client</label>
            <input class="form-control" placeholder="Client Name" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Reason</label>
            <textarea class="form-control" rows="2"></textarea>
          </div>

          <div class="col-md-6">
            <label class="form-label">Status</label>
            <select class="form-select">
              <option>Pending</option>
              <option>Approved</option>
              <option>Rejected</option>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">Remarks</label>
            <textarea class="form-control" rows="3"></textarea>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">Save Return</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="viewReturnModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title">
          <i class="bi bi-eye"></i> View Return Details
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <input class="form-control" value="RT-0001" readonly />
          </div>

          <div class="col-md-4">
            <input class="form-control" value="SO-2026-001" readonly />
          </div>

          <div class="col-md-4">
            <input class="form-control" value="ABC Trading" readonly />
          </div>

          <div class="col-12">
            <textarea class="form-control" readonly>Damaged items</textarea>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
