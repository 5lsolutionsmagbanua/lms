<div class="modal fade" id="editActivityModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Activity</h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Shipment ID</label>
            <input class="form-control" value="SH-2026-001" readonly />
          </div>

          <div class="col-md-4">
            <label class="form-label">Action</label>
            <select class="form-select">
              <option selected>Dispatched</option>
              <option>Updated</option>
              <option>Delivered</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">User</label>
            <input class="form-control" value="Admin" />
          </div>

          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea class="form-control">
Shipment dispatched to warehouse.</textarea
            >
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">Update</button>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="viewActivityModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title"><i class="bi bi-eye"></i> View Activity</h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <input class="form-control" value="SH-2026-001" readonly />
          </div>

          <div class="col-md-4">
            <input class="form-control" value="Dispatched" readonly />
          </div>

          <div class="col-md-4">
            <input class="form-control" value="Admin" readonly />
          </div>

          <div class="col-12">
            <textarea class="form-control" readonly>
Shipment dispatched to warehouse.
            </textarea>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="addActivityModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-plus-circle"></i> Add Shipment Activity
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Shipment ID</label>
            <input class="form-control" placeholder="SH-2026-001" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Action</label>
            <select class="form-select">
              <option>Created</option>
              <option>Updated</option>
              <option>Approved</option>
              <option>Dispatched</option>
              <option>Delivered</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">User</label>
            <input class="form-control" placeholder="Admin" />
          </div>

          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="3"></textarea>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">Save Activity</button>
      </div>
    </div>
  </div>
</div>
<div class="panel">
  <div
    class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2"
  >
    <div>
      <h2 class="h5 mb-1 section-title">
        <i class="bi bi-activity"></i>
        <span style="font-weight: 700; color: #000">Shipment Activity</span>
      </h2>
      <p class="text-muted mb-0">
        Track all shipment actions and history logs.
      </p>
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-primary">
        <i class="bi bi-arrow-repeat"></i> Sync
      </button>

      <button
        class="btn btn-sm btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#addActivityModal"
      >
        <i class="bi bi-plus-circle"></i> Add Activity
      </button>
    </div>
  </div>

  <!-- Search -->
  <div class="px-3 pb-2">
    <input
      class="form-control form-control-sm"
      placeholder="Search activity..."
    />
  </div>

  <!-- Table -->
  <div class="table-responsive">
    <table class="table align-middle">
      <thead class="table-dark text-white">
        <tr>
          <th>ID</th>
          <th>Shipment ID</th>
          <th>Action</th>
          <th>Description</th>
          <th>User</th>
          <th>Date Time</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>1</td>
          <td>SH-2026-001</td>
          <td>Created</td>
          <td>Shipment request created</td>
          <td>Admin</td>
          <td>2026-06-01 10:30</td>
          <td class="text-end">
            <button
              class="btn btn-light btn-sm"
              data-bs-toggle="modal"
              data-bs-target="#viewActivityModal"
            >
              <i class="bi bi-eye"></i>
            </button>

            <button
              class="btn btn-primary btn-sm"
              data-bs-toggle="modal"
              data-bs-target="#editActivityModal"
            >
              <i class="bi bi-pencil"></i>
            </button>

            <button class="btn btn-danger btn-sm">
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
