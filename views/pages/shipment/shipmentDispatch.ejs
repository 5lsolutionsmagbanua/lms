      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Dispatch No.</label>
            <input
              type="text"
              class="form-control"
              value="DSP-26-06-0001"
              readonly
            />
