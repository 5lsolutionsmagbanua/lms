<div class="modal fade" id="addShipmentPlanModal">
  <div
    class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
  >
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-map"></i>
          Shipment Planning Form
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <!-- Planning Information -->
          <div class="col-12">
            <h6 class="fw-bold border-bottom pb-2">Planning Information</h6>
          </div>

          <div class="col-md-3">
            <label class="form-label">Planning No.</label>
            <input
              type="text"
              class="form-control"
              value="PLN-26-06-0001"
              readonly
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Shipment ID</label>
            <select class="form-select">
              <option>Select Shipment</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Planning Date</label>
            <input type="date" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select">
              <option>Draft</option>
              <option>Planned</option>
              <option>In Transit</option>
              <option>Delivered</option>
              <option>Cancelled</option>
            </select>
          </div>

          <!-- Vehicle Assignment -->
          <div class="col-12 mt-4">
            <h6 class="fw-bold border-bottom pb-2">Vehicle Assignment</h6>
          </div>

          <div class="col-md-4">
            <label class="form-label">Vehicle</label>
            <select class="form-select">
              <option>Select Vehicle</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Driver</label>
            <select class="form-select">
              <option>Select Driver</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Helper</label>
            <select class="form-select">
              <option>Select Helper</option>
            </select>
          </div>

          <!-- Route Information -->
          <div class="col-12 mt-4">
            <h6 class="fw-bold border-bottom pb-2">Route Information</h6>
          </div>

          <div class="col-md-4">
            <label class="form-label">Origin Warehouse</label>
            <select class="form-select">
              <option>Main Warehouse</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Destination Branch</label>
            <select class="form-select">
              <option>Select Branch</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Route Code</label>
            <input type="text" class="form-control" placeholder="RTE-001" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Departure Date & Time</label>
            <input type="datetime-local" class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Expected Arrival</label>
            <input type="datetime-local" class="form-control" />
          </div>

          <!-- Shipment Products -->
          <div class="col-12 mt-4">
            <div class="d-flex justify-content-between align-items-center">
              <h6 class="fw-bold mb-0">Shipment Products</h6>

              <button type="button" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i>
                Add Product
              </button>
            </div>
            <hr />
          </div>

          <div class="col-12">
            <div class="table-responsive">
              <table class="table table-bordered align-middle">
                <thead class="table-dark">
                  <tr>
                    <th>Product Code</th>
                    <th>Description</th>
                    <th>Branch</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                    <th>Weight</th>
                    <th>Volume</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  <tr>
                    <td><input class="form-control" /></td>
                    <td><input class="form-control" /></td>
                    <td>
                      <select class="form-select">
                        <option>Main Branch</option>
                      </select>
                    </td>
                    <td><input type="number" class="form-control" /></td>
                    <td><input class="form-control" /></td>
                    <td><input class="form-control" /></td>
                    <td><input class="form-control" /></td>
                    <td>
                      <button class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Costing -->
          <div class="col-12 mt-4">
            <h6 class="fw-bold border-bottom pb-2">Costing Information</h6>
          </div>

          <div class="col-md-3">
            <label class="form-label">Fuel Cost</label>
            <input type="number" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Toll Fee</label>
            <input type="number" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Labor Cost</label>
            <input type="number" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Estimated Total Cost</label>
            <input type="number" class="form-control" />
          </div>

          <!-- Remarks -->
          <div class="col-12">
            <label class="form-label">Remarks</label>
            <textarea rows="3" class="form-control"></textarea>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>

        <button class="btn btn-primary">
          <i class="bi bi-save"></i>
          Save Shipment Plan
        </button>
      </div>
    </div>
  </div>
</div>

