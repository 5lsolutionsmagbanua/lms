<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Panel -->
    <section class="panel">
      <!-- Header Actions -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-shop"></i>
            <span style="font-weight: 700; color: #000">
              Vendor Management
            </span>
          </h2>
          <p class="text-muted mb-0">
            Search, sync, import, and manage vendor records.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Sync
          </button>

          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addVendorModal"
          >
            <i class="bi bi-plus-circle"></i> Add Vendor
          </button>

          <div class="modal fade" id="addVendorModal">
            <div class="modal-dialog modal-lg modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                  <h5 class="modal-title">
                    <i class="bi bi-shop"></i>
                    Add Vendor
                  </h5>

                  <button
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                  ></button>
                </div>

                <div class="modal-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Business Name *</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Enter business name"
                      />
                    </div>

                    <div class="col-md-3">
                      <label class="form-label">SO Prefix *</label>

                      <div class="input-group">
                        <input
                          type="text"
                          class="form-control"
                          id="soPrefix"
                          data-bs-toggle="modal"
                          data-bs-target="#soPrefixModal"
                        />
                      </div>
                    </div>

                    <div class="col-md-3">
                      <label class="form-label">PR Prefix *</label>

                      <div class="input-group">
                        <input
                          type="text"
                          class="form-control"
                          id="prPrefix"
                          data-bs-toggle="modal"
                          data-bs-target="#prPrefixModal"
                        />
                      </div>
                    </div>

                    <div class="col-md-6">
                      <label class="form-label">Business Type *</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Distributor"
                      />
                    </div>

                    <div class="col-md-6">
                      <label class="form-label">Contact Person</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Juan Dela Cruz"
                      />
                    </div>

                    <div class="col-md-6">
                      <label class="form-label">Email</label>
                      <input
                        type="email"
                        class="form-control"
                        placeholder="vendor@email.com"
                      />
                    </div>

                    <div class="col-md-3">
                      <label class="form-label">Phone</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="e.g., 02xxxx yyyy"
                      />
                    </div>

                    <div class="col-md-3">
                      <label class="form-label">Mobile</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="+639XXXXXXXXX"
                      />
                    </div>

                    <div class="col-md-12">
                      <label class="form-label">Address</label>
                      <textarea class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                      <label class="form-label">TIN</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="123-456-789-000"
                      />
                    </div>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                  </button>

                  <button class="btn btn-primary">
                    <i class="bi bi-check-circle"></i>
                    Save Vendor
                  </button>
                </div>
              </div>
            </div>
          </div>

          <button class="btn btn-sm btn-success">
            <i class="bi bi-upload"></i> Upload Excel
          </button>

          <button class="btn btn-sm btn-dark">
            <i class="bi bi-download"></i> Download Excel
          </button>
        </div>
      </div>

      <div class="modal fade" id="soPrefixModal">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header bg-primary text-white">
              <h5 class="modal-title">
                <i class="bi bi-sliders"></i>

                Customize SO Sequence Format
              </h5>

              <button
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
              ></button>
            </div>

            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Prefix</label>

                <input type="text" class="form-control" value="SO" />
              </div>

              <div class="form-check mb-2">
                <input
                  class="form-check-input"
                  type="checkbox"
                  checked
                  id="soYear"
                />

                <label class="form-check-label" for="soYear">
                  Include Year
                </label>
              </div>

              <div class="form-check mb-3">
                <input
                  class="form-check-input"
                  type="checkbox"
                  checked
                  id="soMonth"
                />

                <label class="form-check-label" for="soMonth">
                  Include Month
                </label>
              </div>

              <div class="mb-3">
                <label class="form-label">Number Padding</label>

                <select class="form-select">
                  <option>0001 (4 Digits)</option>

                  <option>00001 (5 Digits)</option>

                  <option>000001 (6 Digits)</option>
                </select>
              </div>

              <div class="alert alert-info mb-0">
                <strong>Preview:</strong>

                SO-2026-06-0001
              </div>
            </div>

            <div class="modal-footer">
              <button class="btn btn-secondary" data-bs-dismiss="modal">
                Cancel
              </button>

              <button class="btn btn-primary">
                <i class="bi bi-check-circle"></i>

                Save Format
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="modal fade" id="prPrefixModal">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header bg-success text-white">
              <h5 class="modal-title">
                <i class="bi bi-sliders"></i>

                Customize PR Sequence Format
              </h5>

              <button
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
              ></button>
            </div>

            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Prefix</label>

                <input type="text" class="form-control" value="PR" />
              </div>

              <div class="form-check mb-2">
                <input
                  class="form-check-input"
                  type="checkbox"
                  checked
                  id="prYear"
                />

                <label class="form-check-label" for="prYear">
                  Include Year
                </label>
              </div>

              <div class="form-check mb-3">
                <input
                  class="form-check-input"
                  type="checkbox"
                  checked
                  id="prMonth"
                />

                <label class="form-check-label" for="prMonth">
                  Include Month
                </label>
              </div>

              <div class="mb-3">
                <label class="form-label">Number Padding</label>

                <select class="form-select">
                  <option>0001 (4 Digits)</option>

                  <option>00001 (5 Digits)</option>

                  <option>000001 (6 Digits)</option>
                </select>
              </div>

              <div class="alert alert-success mb-0">
                <strong>Preview:</strong>

                PR-2026-06-0001
              </div>
            </div>

            <div class="modal-footer">
              <button class="btn btn-secondary" data-bs-dismiss="modal">
                Cancel
              </button>

              <button class="btn btn-success">
                <i class="bi bi-check-circle"></i>
                Save Format
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search vendors..."
          data-table-search="vendorTable"
          aria-label="Search vendors"
        />
      </div>
      <!-- EDIT MODAL -->
      <div class="modal fade" id="editVendorModal">
        <div class="modal-dialog modal-lg modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header bg-warning">
              <h5 class="modal-title">
                <i class="bi bi-pencil-square"></i>
                Edit Vendor
              </h5>

              <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
              <div class="row g-3">
                <div class="col-md-2">
                  <label class="form-label">ID</label>

                  <input type="text" class="form-control" disabled />
                </div>

                <div class="col-md-10">
                  <label class="form-label">Business Name</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-6">
                  <label class="form-label">Business Type</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-6">
                  <label class="form-label">Contact Person</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-6">
                  <label class="form-label">Email</label>

                  <input type="email" class="form-control" />
                </div>

                <div class="col-md-3">
                  <label class="form-label">Phone</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-3">
                  <label class="form-label">Mobile</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-12">
                  <label class="form-label">Address</label>

                  <textarea class="form-control" rows="2">Quezon City</textarea>
                </div>

                <div class="col-md-4">
                  <label class="form-label">TIN</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label class="form-label">SO Prefix</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label class="form-label">PR Prefix</label>

                  <input type="text" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label class="form-label">Status</label>

                  <select class="form-select">
                    <option selected>Active</option>
                    <option>Inactive</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="modal-footer">
              <button class="btn btn-secondary" data-bs-dismiss="modal">
                Cancel
              </button>

              <button class="btn btn-warning">
                <i class="bi bi-save"></i>
                Save Changes
              </button>
            </div>
          </div>
        </div>
      </div>
