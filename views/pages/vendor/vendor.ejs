<!-- =========================
     EDIT MODAL
========================= -->
<div class="modal fade" id="editVendorModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <!-- HEADER -->
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-pencil-square"></i> Edit Vendor
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body">
        <form id="editVendorForm">
          <div class="row g-3">
            <!-- BASIC -->
            <div class="col-12">
              <h6 class="text-muted">Basic Information</h6>
              <hr />
            </div>

            <div class="col-md-4">
              <label class="form-label">Vendor Name</label>
              <input
                type="text"
                class="form-control"
                value="ABC Trading Corp"
              />
            </div>

            <div class="col-md-4">
              <label class="form-label">Vendor Type</label>
              <select class="form-select">
                <option selected>Distributor</option>
                <option>Manufacturer</option>
                <option>Supplier</option>
                <option>International</option>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label">Status</label>
              <select class="form-select">
                <option selected>Active</option>
                <option>Inactive</option>
                <option>Blacklisted</option>
              </select>
            </div>

            <!-- CONTACT -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Contact Information</h6>
              <hr />
            </div>

            <div class="col-md-4">
              <label class="form-label">Contact Person</label>
              <input type="text" class="form-control" value="Juan Dela Cruz" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" value="abc@email.com" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Phone</label>
              <input type="text" class="form-control" value="0917-123-4567" />
            </div>

            <!-- ADDRESS -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Address</h6>
              <hr />
            </div>

            <div class="col-12">
              <input
                type="text"
                class="form-control"
                value="123 Industrial Street, Quezon City"
              />
            </div>

            <!-- NOTES -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Notes</h6>
              <hr />
            </div>

            <div class="col-12">
              <textarea class="form-control" rows="3">
Reliable supplier for electronics and packaging materials.
              </textarea>
            </div>
          </div>
        </form>
      </div>

      <!-- FOOTER -->
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">
          <i class="bi bi-save"></i> Update Vendor
        </button>
      </div>
    </div>
  </div>
</div>
