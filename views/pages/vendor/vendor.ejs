<!-- =========================
     ADD VENDOR MODAL
========================= -->
<div class="modal fade" id="addVendorModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <!-- HEADER -->
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-building"></i> Add Vendor</h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <!-- BODY -->
      <div class="modal-body">
        <form id="vendorForm">
          <div class="row g-3">
            <!-- ================= BASIC INFO ================= -->
            <div class="col-12">
              <h6 class="text-muted">Basic Information</h6>
              <hr />
            </div>

            <div class="col-md-4">
              <label class="form-label">Vendor Name *</label>
              <input
                type="text"
                class="form-control"
                placeholder="ABC Trading Corp"
                required
              />
            </div>

            <div class="col-md-4">
              <label class="form-label">Vendor Type *</label>
              <select class="form-select" required>
                <option value="">Select Type</option>
                <option>Local</option>
                <option>International</option>
                <option>Manufacturer</option>
                <option>Distributor</option>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label">Status</label>
              <select class="form-select">
                <option selected>Active</option>
                <option>Inactive</option>
                <option>Blacklisted</option>
              </select>
            </div>

            <!-- ================= CONTACT ================= -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Contact Information</h6>
              <hr />
            </div>

            <div class="col-md-4">
              <label class="form-label">Contact Person *</label>
              <input
                type="text"
                class="form-control"
                placeholder="Juan Dela Cruz"
                required
              />
            </div>

            <div class="col-md-4">
              <label class="form-label">Email *</label>
              <input
                type="email"
                class="form-control"
                placeholder="email@example.com"
                required
              />
            </div>

            <div class="col-md-4">
              <label class="form-label">Phone *</label>
              <input
                type="text"
                class="form-control"
                placeholder="09XX-XXX-XXXX"
                required
              />
            </div>

            <!-- ================= ADDRESS ================= -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Address</h6>
              <hr />
            </div>

            <div class="col-12">
              <label class="form-label">Street Address</label>
              <input
                type="text"
                class="form-control"
                placeholder="123 Industrial Street"
              />
            </div>

            <div class="col-md-4">
              <label class="form-label">City</label>
              <input type="text" class="form-control" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Province</label>
              <input type="text" class="form-control" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Postal Code</label>
              <input type="text" class="form-control" />
            </div>

            <!-- ================= NOTES ================= -->
            <div class="col-12 mt-2">
              <h6 class="text-muted">Notes</h6>
              <hr />
            </div>

            <div class="col-12">
              <textarea
                class="form-control"
                rows="3"
                placeholder="Internal remarks about this vendor..."
              ></textarea>
            </div>
          </div>
        </form>
      </div>

      <!-- FOOTER -->
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button class="btn btn-primary">
          <i class="bi bi-save"></i> Save Vendor
        </button>
      </div>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="card shadow-sm border-0 panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 p-4 border-bottom"
      >
        <!-- TITLE -->
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-building"></i>
            Vendor Management
          </h2>

          <p class="text-muted mb-0">Manage supplier and vendor records.</p>
        </div>

        <!-- BUTTONS -->
        <div class="row g-2 w-100 w-lg-auto">
          <div class="col-12 col-sm-6 col-lg-auto">
            <button class="btn btn-outline-primary btn-sm w-100">
              <i class="bi bi-arrow-repeat"></i>
              Sync
            </button>
          </div>

          <div class="col-12 col-sm-6 col-lg-auto">
            <button
              class="btn btn-primary btn-sm w-100"
              data-bs-toggle="modal"
              data-bs-target="#addVendorModal"
            >
              <i class="bi bi-plus-circle"></i>
              Add Vendor
            </button>
          </div>

          <div class="col-12 col-sm-6 col-lg-auto">
            <button class="btn btn-success btn-sm w-100">
              <i class="bi bi-upload"></i>
              Import
            </button>
          </div>

          <div class="col-12 col-sm-6 col-lg-auto">
            <button class="btn btn-dark btn-sm w-100">
              <i class="bi bi-download"></i>
              Export
            </button>
          </div>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="card-body pb-2">
        <div class="row g-2">
          <div class="col-12 col-md-4">
            <input
              type="search"
              class="form-control form-control-sm"
              placeholder="Search vendor..."
              data-table-search="vendorTable"
            />
          </div>
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-responsive px-3 pb-3">
        <table
          class="table table-hover align-middle mb-0"
          id="vendorTable"
          data-searchable-table
        >
          <thead>
            <tr>
              <th>ID</th>
              <th>Vendor Name</th>
              <th>Type</th>
              <th>Contact Person</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>ABC Trading Corp</td>
              <td>Distributor</td>
              <td>Juan Dela Cruz</td>
              <td>abc@email.com</td>
              <td>0917-123-4567</td>

              <td>
                <span class="badge text-bg-success"> Active </span>
              </td>

              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <button class="btn btn-light btn-sm">
                    <i class="bi bi-eye"></i>
                  </button>

                  <button class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil"></i>
                  </button>

                  <button class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>Metro Supply</td>
              <td>Manufacturer</td>
              <td>Maria Santos</td>
              <td>metro@email.com</td>
              <td>0998-555-1122</td>

              <td>
                <span class="badge text-bg-warning"> Inactive </span>
              </td>

              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <button class="btn btn-light btn-sm">
                    <i class="bi bi-eye"></i>
                  </button>

                  <button class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil"></i>
                  </button>

                  <button class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
