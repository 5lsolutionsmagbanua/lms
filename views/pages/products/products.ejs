                  accept=".xlsx,.xls,.csv"
                />

                <div id="bulkUploadUnitReport" class="mt-3 d-none">
                  <div id="bulkUploadUnitSummary" class="fw-bold mb-2"></div>
                  <div
                    id="bulkUploadUnitErrors"
                    class="small text-danger"
                    style="max-height: 180px; overflow-y: auto"
                  ></div>
                </div>
              </div>

              <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">
