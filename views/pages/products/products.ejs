<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-box-seam"></i>
            <span style="font-weight: 700; color: #000">
              Product Management
            </span>
          </h2>
          <p class="text-muted mb-0">
            Manage product inventory and product records.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Sync
          </button>

          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addProductModal"
          >
            <i class="bi bi-plus-circle"></i> Add Product
          </button>

          <button class="btn btn-sm btn-success">
            <i class="bi bi-upload"></i> Upload Excel
          </button>

          <button class="btn btn-sm btn-dark">
            <i class="bi bi-download"></i> Download Excel
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search product..."
          data-table-search="productTable"
        />
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="productTable"
          data-searchable-table
        >
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Vendor</th>
              <th>UPS</th>
              <th>Product Code</th>
              <th>Product Description</th>
              <th>Product Category</th>
              <th>Product Subcategory</th>
              <th>Price</th>
              <th>Unit</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>ABC Trading Corp</td>
              <td>UPS-001</td>
              <td>PRD-1001</td>
              <td>Wireless Barcode Scanner</td>
              <td>Electronics</td>
              <td>Scanner</td>
              <td>₱5,500</td>
              <td>PCS</td>
              <td><span class="badge text-bg-success">Active</span></td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>Metro Supply</td>
              <td>UPS-002</td>
              <td>PRD-1002</td>
              <td>Shipping Box Large</td>
              <td>Packaging</td>
              <td>Boxes</td>
              <td>₱120</td>
              <td>BOX</td>
              <td><span class="badge text-bg-success">Active</span></td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>Prime Logistics</td>
              <td>UPS-003</td>
              <td>PRD-1003</td>
              <td>Pallet Jack</td>
              <td>Equipment</td>
              <td>Warehouse Tools</td>
              <td>₱15,000</td>
              <td>UNIT</td>
              <td><span class="badge text-bg-warning">Inactive</span></td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>Global Traders</td>
              <td>UPS-004</td>
              <td>PRD-1004</td>
              <td>Bubble Wrap Roll</td>
              <td>Packaging</td>
              <td>Protective Wrap</td>
              <td>₱350</td>
              <td>ROLL</td>
              <td><span class="badge text-bg-success">Active</span></td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>Skyline Supply</td>
              <td>UPS-005</td>
              <td>PRD-1005</td>
              <td>Label Printer</td>
              <td>Electronics</td>
              <td>Printer</td>
              <td>₱8,700</td>
              <td>PCS</td>
              <td><span class="badge text-bg-success">Active</span></td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
