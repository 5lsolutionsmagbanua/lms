<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Panel -->
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-archive"></i>
            <span style="font-weight: 700; color: #000">
              Stocks Adjustment
            </span>
          </h2>

          <p class="text-muted mb-0">
            Manage stock adjustment records and inventory corrections.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Sync
          </button>

          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addStockAdjustmentModal"
          >
            <i class="bi bi-plus-circle"></i> Add Adjust Stock
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search stock adjustment..."
          data-table-search="stockAdjustmentTable"
        />
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="stockAdjustmentTable"
          data-searchable-table
        >
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Branch Name</th>
              <th>Branch ID</th>
              <th>Reference No.</th>
              <th>Remarks</th>
              <th>Date Created</th>
              <th>Created By</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>Quezon City Branch</td>
              <td>BR-001</td>
              <td>REF-2026-0001</td>
              <td>Inventory recount adjustment</td>
              <td>May 28, 2026</td>
              <td>Admin</td>
              <td>
                <span class="badge text-bg-success"> Approved </span>
              </td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>Manila Branch</td>
              <td>BR-002</td>
              <td>REF-2026-0002</td>
              <td>Damaged stocks correction</td>
              <td>May 27, 2026</td>
              <td>Maria Santos</td>
              <td>
                <span class="badge text-bg-warning"> Pending </span>
              </td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>Pasig Branch</td>
              <td>BR-003</td>
              <td>REF-2026-0003</td>
              <td>Missing inventory update</td>
              <td>May 26, 2026</td>
              <td>Juan Dela Cruz</td>
              <td>
                <span class="badge text-bg-primary"> Processing </span>
              </td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>Taguig Branch</td>
              <td>BR-004</td>
              <td>REF-2026-0004</td>
              <td>Warehouse transfer adjustment</td>
              <td>May 25, 2026</td>
              <td>Mark Cruz</td>
              <td>
                <span class="badge text-bg-danger"> Rejected </span>
              </td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>Makati Branch</td>
              <td>BR-005</td>
              <td>REF-2026-0005</td>
              <td>Stock recount verification</td>
              <td>May 24, 2026</td>
              <td>Admin</td>
              <td>
                <span class="badge text-bg-success"> Approved </span>
              </td>
              <td class="text-end">
                <button class="btn btn-light btn-sm">
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
