<script>
  $(document).ready(function () {
    const $addUserModal = $("#addUserModal");
    const $editUserModal = $("#editUserModal");

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    // =========================
    // STATE
    // =========================
    let state = {
      page: 1,
      limit: 4,
      search: "",
    };

    loadUsers();
    loadBranches();
    loadRoles();

    function escapeHtml(str) {
      return $("<div>")
        .text(str == null ? "" : str)
        .html();
    }

    // Blank, invisible row matching the live column count (9), used to pad
    // the table so its height never shifts between 1 row and a full page.
    function fillerRow() {
      return `
        <tr>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
        </tr>
      `;
    }

    // =========================
    // LOAD USERS (paginated + searchable)
    // =========================
    function loadUsers() {
      $.ajax({
        url: "/users/get-users",
        method: "GET",
        data: { page: state.page, limit: state.limit, search: state.search },
        success: function (res) {
          renderTable(res.data);
          renderPagination(res.pagination);
        },
        error: function (xhr) {
          console.error("[users] Failed to load users", xhr);
          Toast.fire({ icon: "error", title: "Failed to load users." });
        },
      });
    }

    function renderTable(users) {
      const target = state.limit;
      let rows = "";

      if (!users || users.length === 0) {
        rows += `
          <tr>
            <td colspan="9" class="text-center text-muted py-4">
              <i class="bi bi-inbox fs-4 d-block mb-1"></i>
              No users found
            </td>
          </tr>
        `;
        for (let i = 1; i < target; i++) rows += fillerRow();
        $("#userTableBody").html(rows);
        return;
      }

      users.forEach((user) => {
        rows += `
          <tr>
            <td>${user.id}</td>
            <td title="${escapeHtml(user.first_name)}">${escapeHtml(user.first_name)}</td>
            <td title="${escapeHtml(user.last_name)}">${escapeHtml(user.last_name)}</td>
            <td title="${escapeHtml(user.email)}">${escapeHtml(user.email)}</td>
            <td>${escapeHtml(user.username)}</td>
            <td title="${escapeHtml(user.branch_name || "-")}">${escapeHtml(user.branch_name || "-")}</td>
            <td>${escapeHtml(user.role_name || "-")}</td>
            <td>
              ${
                user.is_active == 1
                  ? `<span class="badge bg-success">Active</span>`
                  : `<span class="badge bg-danger">Inactive</span>`
              }
            </td>
            <td class="text-end">
              <button class="btn btn-warning btn-sm editUserBtn" data-id="${user.id}"><i class="bi bi-pencil"></i></button>
            </td>
          </tr>
        `;
      });

      for (let i = users.length; i < target; i++) rows += fillerRow();

      $("#userTableBody").html(rows);
    }

    function renderPagination(pagination) {
      const { page, totalPages, total, limit } = pagination;

      if (total === 0) {
        $("#userPaginationInfo").text("No entries");
        $("#userPagination").html("");
        return;
      }

      const start = (page - 1) * limit + 1;
      const end = Math.min(page * limit, total);
      $("#userPaginationInfo").text(
        `Showing ${start}-${end} of ${total} entries`,
      );

      let html = "";
      html += `<li class="page-item ${page <= 1 ? "disabled" : ""}">
                <button class="page-link" data-page="${page - 1}">Prev</button>
              </li>`;

      const windowSize = 5;
      let startPage = Math.max(1, page - Math.floor(windowSize / 2));
      let endPage = Math.min(totalPages, startPage + windowSize - 1);
      startPage = Math.max(1, endPage - windowSize + 1);

      if (startPage > 1) {
        html += `<li class="page-item"><button class="page-link" data-page="1">1</button></li>`;
        if (startPage > 2)
          html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
      }

      for (let p = startPage; p <= endPage; p++) {
        html += `<li class="page-item ${p === page ? "active" : ""}">
                  <button class="page-link" data-page="${p}">${p}</button>
                </li>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1)
          html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
        html += `<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`;
      }

      html += `<li class="page-item ${page >= totalPages ? "disabled" : ""}">
                <button class="page-link" data-page="${page + 1}">Next</button>
              </li>`;

      $("#userPagination").html(html);
    }

    $(document).on("click", "#userPagination .page-link", function () {
      const p = parseInt($(this).data("page"), 10);
      if (!p || p < 1) return;
      state.page = p;
      loadUsers();
    });

    $("#entriesPerPage").on("change", function () {
      state.limit = parseInt($(this).val(), 10);
      state.page = 1;
      loadUsers();
    });

    let searchTimer = null;
    $("#searchUser").on("input", function () {
      const val = $(this).val();
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.search = val.trim();
        state.page = 1;
        loadUsers();
      }, 400);
    });

    function loadBranches() {
      $.get("/users/get-branches", function (res) {
        let html = `<option value="">Select Branch</option>`;

        res.forEach((b) => {
          html += `<option value="${b.id}">${escapeHtml(b.branch_name)}</option>`;
        });

        $addUserModal.find("#branch_id").html(html);
        $editUserModal.find("#edit_branch_id").html(html);
      }).fail(function (xhr) {
        console.error("[users] Failed to load branches", xhr);
      });
    }

    function loadRoles() {
      $.get("/users/get-roles", function (res) {
        let html = `<option value="">Select Role</option>`;

        res.forEach((r) => {
          html += `<option value="${r.id}">${escapeHtml(r.role_name)}</option>`;
        });

        $addUserModal.find("#role_id").html(html);
        $editUserModal.find("#edit_role_id").html(html);
      }).fail(function (xhr) {
        console.error("[users] Failed to load roles", xhr);
      });
    }

    // =========================
    // ADD USER
    // =========================
    $(document).on("click", "#addUserBtn", function (e) {
      e.preventDefault();

      const data = {
        branch_id: $addUserModal.find("#branch_id").val(),
        role_id: $addUserModal.find("#role_id").val(),
        first_name: $addUserModal.find("#first_name").val().trim(),
        last_name: $addUserModal.find("#last_name").val().trim(),
        email: $addUserModal.find("#email").val().trim(),
        username: $addUserModal.find("#username").val().trim(),
        password: $addUserModal.find("#password").val(),
      };

      if (!data.branch_id) {
        Toast.fire({ icon: "warning", title: "Please select a Branch." });
        $addUserModal.find("#branch_id").focus();
        return;
      }

      if (!data.role_id) {
        Toast.fire({ icon: "warning", title: "Please select a Role." });
        $addUserModal.find("#role_id").focus();
        return;
      }

      if (data.first_name === "") {
        Toast.fire({ icon: "warning", title: "Please enter the First Name." });
        $addUserModal.find("#first_name").focus();
        return;
      }

      if (data.last_name === "") {
        Toast.fire({ icon: "warning", title: "Please enter the Last Name." });
        $addUserModal.find("#last_name").focus();
        return;
      }

      if (data.email === "") {
        Toast.fire({
          icon: "warning",
          title: "Please enter the Email Address.",
        });
        $addUserModal.find("#email").focus();
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!emailRegex.test(data.email)) {
        Toast.fire({
          icon: "warning",
          title: "Please enter a valid Email Address.",
        });
        $addUserModal.find("#email").focus();
        return;
      }

      if (data.username === "") {
        Toast.fire({ icon: "warning", title: "Please enter the Username." });
        $addUserModal.find("#username").focus();
        return;
      }

      if (data.password === "") {
        Toast.fire({ icon: "warning", title: "Please enter the Password." });
        $addUserModal.find("#password").focus();
        return;
      }

      if (data.password.length < 8) {
        Toast.fire({
          icon: "warning",
          title: "Password must be at least 8 characters long.",
        });
        $addUserModal.find("#password").focus();
        return;
      }

      $.ajax({
        url: "/users",
        method: "POST",
        data: data,
        dataType: "json",

        beforeSend: function () {
          $("#addUserBtn").prop("disabled", true).text("Saving...");
        },

        success: function (res) {
          $addUserModal.modal("hide");

          $addUserModal.find("input").val("");
          $addUserModal.find("select").prop("selectedIndex", 0);

          $addUserModal
            .find(".is-valid, .is-invalid")
            .removeClass("is-valid is-invalid");

          state.page = 1;
          loadUsers();

          Toast.fire({
            icon: "success",
            title: res?.message || "User added successfully.",
          });
        },

        error: function (err) {
          console.error("[users] Add user failed:", err);
          Toast.fire({
            icon: "error",
            title: err.responseJSON?.message || "Failed to add user.",
          });
        },

        complete: function () {
          $("#addUserBtn").prop("disabled", false).text("Save User");
        },
      });
    });

    // =========================
    // EDIT USER
    // =========================
    $(document).on("click", ".editUserBtn", function () {
      const id = $(this).data("id");

      $.get(`/users/${id}`, function (user) {
        $editUserModal.find("#edit_user_id").val(user.id);
        $editUserModal.find("#edit_first_name").val(user.first_name);
        $editUserModal.find("#edit_last_name").val(user.last_name);
        $editUserModal.find("#edit_email").val(user.email);
        $editUserModal.find("#edit_username").val(user.username);

        $editUserModal.find("#edit_branch_id").val(user.branch_id);
        $editUserModal.find("#edit_role_id").val(user.role_id);

        $editUserModal.modal("show");
      }).fail(function (xhr) {
        console.error(`[users] Failed to load user ${id} for edit`, xhr);
        Toast.fire({ icon: "error", title: "Failed to load user data." });
      });
    });

    $(document).on("click", "#updateUserBtn", function () {
      const id = $editUserModal.find("#edit_user_id").val();

      const data = {
        branch_id: $editUserModal.find("#edit_branch_id").val(),
        role_id: $editUserModal.find("#edit_role_id").val(),
        first_name: $editUserModal.find("#edit_first_name").val().trim(),
        last_name: $editUserModal.find("#edit_last_name").val().trim(),
        email: $editUserModal.find("#edit_email").val().trim(),
        username: $editUserModal.find("#edit_username").val().trim(),
      };

      $.ajax({
        url: `/users/${id}`,
        method: "PUT",
        data: data,

        beforeSend: function () {
          $("#updateUserBtn").prop("disabled", true).text("Updating...");
        },

        success: function (res) {
          $editUserModal.modal("hide");
          loadUsers();
          Toast.fire({
            icon: "success",
            title: res.message || "User updated successfully.",
          });
        },

        error: function (xhr) {
          Toast.fire({
            icon: "error",
            title: xhr.responseJSON?.message || "Failed to update user",
          });
        },

        complete: function () {
          $("#updateUserBtn").prop("disabled", false).text("Update");
        },
      });
    });

    // =========================
    // EXPORT EXCEL — server-generated, styled, all users (not just this page)
    // =========================
    $("#exportUserExcelBtn").click(function () {
      window.location.href = "/users/export-excel";
    });

    // =========================
    // BULK UPLOAD
    // =========================
    $("#bulkUploadUserSubmitBtn").click(function () {
      const fileInput = $("#bulkUploadUserFile")[0];

      if (!fileInput.files || fileInput.files.length === 0) {
        Toast.fire({ icon: "warning", title: "Please select a file first." });
        return;
      }

      const formData = new FormData();
      formData.append("file", fileInput.files[0]);

      $.ajax({
        url: "/users/bulk-upload",
        method: "POST",
        data: formData,
        processData: false,
        contentType: false,

        beforeSend: function () {
          $("#bulkUploadUserSubmitBtn")
            .prop("disabled", true)
            .html(
              '<span class="spinner-border spinner-border-sm"></span> Uploading...',
            );
          $("#bulkUploadUserReport").addClass("d-none");
        },

        success: function (res) {
          showBulkReport(res.report, res.message);
          state.page = 1;
          loadUsers();
        },

        error: function (err) {
          const res = err.responseJSON;
          if (res && res.report) {
            showBulkReport(res.report, res.message);
          } else {
            Toast.fire({
              icon: "error",
              title: res?.message || "Bulk upload failed.",
            });
          }
        },

        complete: function () {
          $("#bulkUploadUserSubmitBtn")
            .prop("disabled", false)
            .html('<i class="bi bi-cloud-upload"></i> Upload File');
        },
      });
    });

    function showBulkReport(report, message) {
      $("#bulkUploadUserReport").removeClass("d-none");

      const summaryColor = report.failed > 0 ? "text-warning" : "text-success";
      $("#bulkUploadUserSummary")
        .removeClass()
        .addClass(`fw-bold mb-2 ${summaryColor}`)
        .text(message || `${report.success} of ${report.total} imported.`);

      if (report.errors && report.errors.length > 0) {
        let list = "<ul class='ps-3 mb-0'>";
        report.errors.forEach((e) => {
          list += `<li>Row ${e.row}: ${escapeHtml(e.message)}</li>`;
        });
        list += "</ul>";
        $("#bulkUploadUserErrors").html(list);
      } else {
        $("#bulkUploadUserErrors").html("");
      }
    }

    $("#bulkUploadUserModal").on("hidden.bs.modal", function () {
      $("#bulkUploadUserFile").val("");
      $("#bulkUploadUserReport").addClass("d-none");
    });

    // =========================
    // PRINT USERS — pulls the FULL list from the server (not just the
    // current page) so the printed report isn't limited by pagination.
    // =========================
    $("#printUserBtn").click(function () {
      $(this).prop("disabled", true);

      $.ajax({
        url: "/users/get-users",
        method: "GET",
        data: { page: 1, limit: 100000, search: state.search },

        success: function (res) {
          renderPrintReport(res.data, res.pagination.total);
        },

        error: function () {
          Toast.fire({ icon: "error", title: "Failed to prepare the report." });
        },

        complete: function () {
          $("#printUserBtn").prop("disabled", false);
        },
      });
    });

    function renderPrintReport(users, total) {
      let rows = "";
      users.forEach((u, i) => {
        rows += `
          <tr class="${i % 2 === 0 ? "even" : ""}">
            <td>${u.id}</td>
            <td>${escapeHtml(u.first_name)}</td>
            <td>${escapeHtml(u.last_name)}</td>
            <td>${escapeHtml(u.email)}</td>
            <td>${escapeHtml(u.username)}</td>
            <td>${escapeHtml(u.branch_name || "-")}</td>
            <td>${escapeHtml(u.role_name || "-")}</td>
            <td>${u.is_active == 1 ? "Active" : "Inactive"}</td>
          </tr>
        `;
      });

      const printWindow = window.open("", "_blank", "width=1100,height=700");

      printWindow.document.write(`
        <html>
        <head>
          <title>User List Report</title>
          <style>
            * { box-sizing: border-box; }
            body { font-family: 'Segoe UI', Arial, sans-serif; padding: 32px; color: #1f2937; }
            .report-header {
              display: flex; justify-content: space-between; align-items: center;
              border-bottom: 3px solid #2563eb; padding-bottom: 12px; margin-bottom: 4px;
            }
            .report-header h1 { font-size: 22px; margin: 0; color: #1e3a8a; }
            .report-header .badge {
              background: #2563eb; color: #fff; padding: 6px 14px;
              border-radius: 999px; font-size: 12px; font-weight: bold;
            }
            .meta { display: flex; justify-content: space-between; color: #6b7280; font-size: 12px; margin: 8px 0 20px; }
            table { width: 100%; border-collapse: collapse; font-size: 12px; }
            thead th { background: #2563eb; color: #fff; text-align: left; padding: 10px 8px; }
            tbody td { padding: 8px; border-bottom: 1px solid #e5e7eb; }
            tbody tr.even { background: #f3f4f6; }
            .report-footer { margin-top: 24px; text-align: right; font-size: 11px; color: #9ca3af; }
            @media print { body { padding: 12px; } }
          </style>
        </head>
        <body>
          <div class="report-header">
            <h1>User List Report</h1>
            <span class="badge">${total} Total User${total === 1 ? "" : "s"}</span>
          </div>
          <div class="meta">
            <span>Generated on ${new Date().toLocaleString()}</span>
            ${state.search ? `<span>Filtered by: "${escapeHtml(state.search)}"</span>` : ""}
          </div>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Username</th>
                <th>Branch</th>
                <th>Role</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
          <div class="report-footer">LMS &mdash; User Management</div>
        </body>
        </html>
      `);

      printWindow.document.close();

      printWindow.onload = function () {
        printWindow.focus();
        setTimeout(function () {
          printWindow.print();
          printWindow.onafterprint = function () {
            printWindow.close();
          };
        }, 400);
      };
    }
  });
</script>
