<script>
  let editMode = false;
  let editUserId = null;

  $(document).ready(function () {
    loadUsers();

    $("#addUserBtn").click(function () {
      addUser();
    });

    $("#updateUserBtn").click(function () {
      updateUser();
    });
  });

  // =========================
  // LOAD USERS
  // =========================
  function loadUsers() {
    $.ajax({
      url: "/users/get-users",
      method: "GET",
      success: function (data) {
        console.log("USERS DATA:", data); // DEBUG

        let rows = "";

        data.forEach((item) => {
          rows += `
           <tr>
              <td>${item.id}</td>
              <td>${item.full_name}</td>
              <td>${item.username}</td>
              <td>${item.password}</td>
              <td>${item.role}</td>
              <td>${item.is_active == 1 ? "Active" : "Inactive"}</td>
              <td>${formatDate(item.created_at)}</td>
              <td>${formatDate(item.updated_at)}</td>
              <td class="text-end">
                <button class="btn btn-warning btn-sm"
                onclick='editUser(${JSON.stringify(item)})'>
                <i class="bi bi-pencil"></i> Edit
                </button>
                <button class="btn btn-danger btn-sm"
                onclick='deleteUser(${item.id})'>
                <i class="bi bi-trash"></i> Delete
                </button>
              </td>
            </tr>
          `;
        });

        $("#userTableBody").html(rows);
      },
      error: function (err) {
        console.log("ERROR:", err);
      },
    });
  }
  $.ajax({
    url: "/users/get-users",
    method: "GET",
    success: function (data) {
      console.log("USERS DATA:", data); // DEBUG

      let rows = "";

      data.forEach((item) => {
        rows += `
            <tr>
              <td>${item.id}</td>
              <td>${item.full_name}</td>
              <td>${item.username}</td>
              <td>${item.password}</td>
              <td>${item.role}</td>
              <td>${item.is_active == 1 ? "Active" : "Inactive"}</td>
            </tr>
          `;
      });

      $("#userTableBody").html(rows);
    },
    error: function (err) {
      console.log("ERROR:", err);
    },
  });

  // =========================
  // ADD USER
  // =========================
  function addUser() {
    const data = getFormData();

    if (!validateForm(data)) return;

    $.ajax({
      url: "/users/add-user",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(data),

      success: function () {
        Swal.fire({
          title: "User added successfully!",
          icon: "success",
        });

        clearForm();
        loadUsers();

        bootstrap.Modal.getInstance(
          document.getElementById("addUserModal"),
        ).hide();
      },

      error: function (err) {
        Swal.fire({
          icon: "error",
          title: "Error",
          text: err.responseJSON?.message || "Insert failed",
        });
      },
    });
  }

  // =========================
  // EDIT USER
  // =========================
  function editUser(user) {
    editMode = true;
    editUserId = user.id;

    $("#edit_user_id").val(user.id);
    $("#edit_full_name").val(user.full_name);
    $("#edit_username").val(user.username);
    $("#edit_role").val(user.role);

    $("#edit_status").val(user.is_active == 1 ? "active" : "inactive");

    const modal = new bootstrap.Modal(document.getElementById("editUserModal"));

    modal.show();
  }

  // =========================
  // UPDATE USER
  // =========================
  function updateUser() {
    const data = {
      id: $("#edit_user_id").val(),
      full_name: $("#edit_full_name").val().trim(),
      username: $("#edit_username").val().trim(),
      role: $("#edit_role").val(),
      status: $("#edit_status").val(),
    };

    if (!data.full_name || !data.username || !data.role) {
      Swal.fire({
        icon: "error",
        title: "Validation Error",
        text: "Please fill all required fields.",
      });

      return;
    }

    $.ajax({
      url: "/users/update-user",
      method: "PUT",
      contentType: "application/json",
      data: JSON.stringify(data),

      success: function () {
        Swal.fire({
          title: "User updated successfully!",
          icon: "success",
        });

        loadUsers();

        bootstrap.Modal.getInstance(
          document.getElementById("editUserModal"),
        ).hide();

        editMode = false;
        editUserId = null;
      },

      error: function (err) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: err.responseJSON?.message || "Update failed",
        });
      },
    });
  }

  // =========================
  // DELETE USER
  // =========================
  function deleteUser(id) {
    Swal.fire({
      title: "Are you sure?",
      text: "You won't be able to revert this!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete it!",
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: "/users/delete-user",
          method: "DELETE",
          contentType: "application/json",
          data: JSON.stringify({
            id: id,
          }),

          success: function () {
            Swal.fire({
              title: "Deleted!",
              text: "User has been deleted.",
              icon: "success",
            });

            loadUsers();
          },

          error: function () {
            Swal.fire({
              title: "Error!",
              text: "Delete failed.",
              icon: "error",
            });
          },
        });
      }
    });
  }

  // =========================
  // FORM DATA
  // =========================
  function getFormData() {
    return {
      full_name: $("#full_name").val().trim(),
      username: $("#username").val().trim(),
      password: $("#password").val().trim(),
      role: $("#role").val(),
      status: $("#status").val(),
    };
  }

  // =========================
  // VALIDATION
  // =========================
  function validateForm(data) {
    if (!data.full_name || !data.username || !data.password || !data.role) {
      Swal.fire({
        icon: "error",
        title: "Oops...",
        text: "Please fill all required fields",
      });

      return false;
    }

    return true;
  }

  // =========================
  // CLEAR FORM
  // =========================
  function clearForm() {
    $("#addUserForm")[0].reset();
  }

  // =========================
  // FORMAT DATE
  // =========================
  function formatDate(date) {
    return date ? new Date(date).toLocaleString() : "";
  }
</script>
