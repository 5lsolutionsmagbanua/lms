<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 p-4 border-bottom"
      >
        <div class="d-flex align-items-center gap-3">
          <div class="header-icon-box">
            <i class="bi bi-shield-lock"></i>
          </div>
          <div>
            <h2 class="h5 mb-1 section-title">User Roles Management</h2>
            <p class="text-muted mb-0">
              Manage system roles and access permissions
            </p>
          </div>
        </div>

        <div class="d-flex gap-2 flex-wrap role-toolbar">
          <button
            class="btn btn-outline-dark rounded-pill fw-semibold"
            id="printRoleBtn"
            type="button"
          >
            <i class="bi bi-printer"></i> Print
          </button>

          <button
            class="btn btn-outline-success rounded-pill fw-semibold"
            id="exportRoleExcelBtn"
            type="button"
          >
            <i class="bi bi-file-earmark-excel"></i> Export Excel
          </button>

          <button
            class="btn btn-outline-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#bulkUploadRoleModal"
            type="button"
          >
            <i class="bi bi-upload"></i> Bulk Upload
          </button>

          <button
            class="btn btn-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#addRoleModal"
            type="button"
          >
            <i class="bi bi-plus-circle"></i>
            Add Role
          </button>
        </div>
      </div>

      <!-- CONTROLS -->
      <div class="row g-2 px-3 pt-3">
        <div class="col-12 col-md-2">
          <select class="form-select form-select-sm" id="entriesPerPage">
            <option value="4" selected>4 Entries</option>
            <option value="10">10 Entries</option>
            <option value="25">25 Entries</option>
            <option value="50">50 Entries</option>
          </select>
        </div>

        <div class="col-12 col-md-4 ms-md-auto">
          <input
            type="search"
            id="roleSearch"
            class="form-control form-control-sm"
            placeholder="Search role..."
          />
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-responsive px-3 pb-3 mt-3">
        <table class="table align-middle" id="roleTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Role Name</th>
              <th>Description</th>
              <th>Status</th>
              <th>Created At</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>

          <tbody id="roleTableBody"></tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 px-3 pb-3"
      >
        <div class="text-muted small" id="rolePaginationInfo"></div>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="rolePagination"></ul>
        </nav>
      </div>
    </section>
  </div>
</main>

<div class="modal fade" id="addRoleModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-shield-plus"></i> Add Role</h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Role Name *</label>
            <input type="text" class="form-control" id="role_name" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Description *</label>
            <input type="text" class="form-control" id="role_description" />
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>

        <button class="btn btn-primary" id="saveRoleBtn">
          <i class="bi bi-save"></i> Save Role
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="editRoleModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-pencil-square"></i> Edit Role
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <!-- ROLE ID -->
        <input type="hidden" id="edit_role_id" />

        <div class="row g-3">
          <div class="col-md-9">
            <label class="form-label">Role Name *</label>
            <input type="text" class="form-control" id="edit_role_name" />
          </div>

          <div class="col-md-12">
            <label class="form-label">Description *</label>
            <textarea
              class="form-control"
              rows="3"
              id="edit_role_description"
            ></textarea>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>

        <button class="btn btn-warning" id="updateRoleBtn">
          <i class="bi bi-save"></i> Update Role
        </button>
      </div>
    </div>
  </div>
</div>

<!-- BULK UPLOAD MODAL -->
<div class="modal fade" id="bulkUploadRoleModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-upload"></i> Bulk Upload Roles
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="template-download-card">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box">
              <i class="bi bi-file-earmark-spreadsheet"></i>
            </div>
            <div>
              <div class="fw-semibold">Role Upload Template</div>
              <small class="text-muted"
                >.xlsx &middot; role_name, description</small
              >
            </div>
          </div>
          <a
            href="/userRoles/download-template"
            class="btn btn-success btn-sm"
            id="downloadRoleTemplateBtn"
          >
            <i class="bi bi-download"></i> Download Template
          </a>
        </div>

        <p class="text-muted small mb-2">
          File must include columns: <code>role_name</code>,
          <code>description</code>. Role names must be unique. Max 1000 rows,
          5MB.
        </p>

        <label>Select Excel or CSV File</label>
        <input
          type="file"
          id="bulkUploadRoleFile"
          class="form-control"
          accept=".xlsx,.xls,.csv"
        />

        <div id="bulkUploadRoleReport" class="mt-3 d-none">
          <div id="bulkUploadRoleSummary" class="fw-bold mb-2"></div>
          <div
            id="bulkUploadRoleErrors"
            class="small text-danger"
            style="max-height: 180px; overflow-y: auto"
          ></div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-success" id="bulkUploadRoleSubmitBtn">
          <i class="bi bi-cloud-upload"></i> Upload File
        </button>
      </div>
    </div>
  </div>
</div>
