<div class="modal fade" id="editUserModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">Edit User</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="editUserForm">
          <input type="hidden" id="edit_user_id" />

          <div class="row">
            <!-- BRANCH -->
            <div class="col-md-6 mb-3">
              <label class="form-label">Branch *</label>
              <select id="edit_branch_id" class="form-select">
                <option value="">Select Branch</option>
              </select>
            </div>

            <!-- ROLE -->
            <div class="col-md-6 mb-3">
              <label class="form-label">Role *</label>
              <select id="edit_role_id" class="form-select">
                <option value="">Select Role</option>
              </select>
            </div>

            <!-- FIRST NAME -->
            <div class="col-md-6 mb-3">
              <label>First Name</label>
              <input type="text" id="edit_first_name" class="form-control" />
            </div>

            <!-- LAST NAME -->
            <div class="col-md-6 mb-3">
              <label>Last Name</label>
              <input type="text" id="edit_last_name" class="form-control" />
            </div>

            <!-- EMAIL -->
            <div class="col-md-6 mb-3">
              <label>Email</label>
              <input type="email" id="edit_email" class="form-control" />
            </div>

            <!-- USERNAME -->
            <div class="col-md-6 mb-3">
              <label>Username</label>
              <input type="text" id="edit_username" class="form-control" />
            </div>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-warning" id="updateUserBtn">Update</button>
      </div>
    </div>
  </div>
</div>

<!-- ADD USER MODAL -->
<div class="modal fade" id="addUserModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Add User</h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="row">
          <!-- BRANCH -->
          <div class="col-md-6 mb-3">
            <label class="form-label">Branch*</label>
            <select
              class="form-select"
              id="branch_id"
              name="branch_id"
              required
            >
              <option value="">Select Branch</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Role*</label>
            <select class="form-select" id="role_id" name="role_id" required>
              <option value="">Select Role</option>
            </select>
          </div>

          <!-- FIRST NAME -->
          <div class="col-md-6 mb-3">
            <label>First Name</label>
            <input type="text" id="first_name" class="form-control" required />
          </div>

          <!-- LAST NAME -->
          <div class="col-md-6 mb-3">
            <label>Last Name</label>
            <input type="text" id="last_name" class="form-control" required />
          </div>

          <!-- EMAIL -->
          <div class="col-md-6 mb-3">
            <label>Email</label>
            <input type="email" id="email" class="form-control" required />
          </div>

          <!-- USERNAME -->
          <div class="col-md-6 mb-3">
            <label>Username</label>
            <input type="text" id="username" class="form-control" required />
          </div>

          <!-- PASSWORD -->
          <div class="col-md-12 mb-3">
            <label>Password</label>
            <input
              type="password"
              id="password"
              class="form-control"
              required
            />
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" id="addUserBtn">Save User</button>
      </div>
    </div>
  </div>
</div>
<!-- ADD USER MODAL -->

<!-- BULK UPLOAD MODAL -->
<div class="modal fade" id="bulkUploadUserModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-upload"></i> Bulk Upload Users
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="template-download-card">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box">
              <i class="bi bi-file-earmark-spreadsheet"></i>
            </div>
            <div>
              <div class="fw-semibold">User Upload Template</div>
              <small class="text-muted"
                >.xlsx &middot; first_name, last_name, email, username,
                password, branch_name, role_name</small
              >
            </div>
          </div>
          <a
            href="/users/download-template"
            class="btn btn-success btn-sm"
            id="downloadUserTemplateBtn"
          >
            <i class="bi bi-download"></i> Download Template
          </a>
        </div>

        <p class="text-muted small mb-2">
          <code>branch_name</code> and <code>role_name</code> must exactly match
          an existing branch/role (see the template's reference sheet). Max 1000
          rows, 5MB.
        </p>

        <label>Select Excel or CSV File</label>
        <input
          type="file"
          id="bulkUploadUserFile"
          class="form-control"
          accept=".xlsx,.xls,.csv"
        />

        <div id="bulkUploadUserReport" class="mt-3 d-none">
          <div id="bulkUploadUserSummary" class="fw-bold mb-2"></div>
          <div
            id="bulkUploadUserErrors"
            class="small text-danger"
            style="max-height: 180px; overflow-y: auto"
          ></div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-success" id="bulkUploadUserSubmitBtn">
          <i class="bi bi-cloud-upload"></i> Upload File
        </button>
      </div>
    </div>
  </div>
</div>
<!-- BULK UPLOAD MODAL -->

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 p-4 border-bottom"
      >
        <div class="d-flex align-items-center gap-3">
          <div class="header-icon-box">
            <i class="bi bi-people"></i>
          </div>
          <div>
            <h2 class="h5 mb-1 section-title">User Management</h2>
            <p class="text-muted mb-0">
              Manage system users and their access permissions.
            </p>
          </div>
        </div>

        <div class="d-flex gap-2 flex-wrap user-toolbar">
          <button
            class="btn btn-outline-secondary rounded-pill fw-semibold"
            id="printUserBtn"
            type="button"
          >
            <i class="bi bi-printer"></i> Print
          </button>

          <button
            class="btn btn-outline-success rounded-pill fw-semibold"
            id="exportUserExcelBtn"
            type="button"
          >
            <i class="bi bi-file-earmark-excel"></i> Export Excel
          </button>

          <button
            class="btn btn-outline-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#bulkUploadUserModal"
            type="button"
          >
            <i class="bi bi-upload"></i> Bulk Upload
          </button>

          <button
            class="btn btn-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#addUserModal"
            type="button"
          >
            <i class="bi bi-person-plus"></i>
            Add User
          </button>
        </div>
      </div>

      <!-- CONTROLS -->
      <div class="row g-2 px-3 pt-3">
        <div class="col-12 col-md-2">
          <select class="form-select form-select-sm" id="entriesPerPage">
            <option value="4" selected>4 Entries</option>
            <option value="10">10 Entries</option>
            <option value="25">25 Entries</option>
            <option value="50">50 Entries</option>
          </select>
        </div>

        <div class="col-12 col-md-4 ms-md-auto">
          <input
            type="text"
            class="form-control form-control-sm"
            id="searchUser"
            placeholder="Search user..."
          />
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-responsive px-3 pb-3 mt-3">
        <table class="table align-middle" id="userTable">
          <thead>
            <tr>
              <th>User ID</th>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Email</th>
              <th>Username</th>
              <th>Branch</th>
              <th>Role</th>
              <th>Status</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>

          <tbody id="userTableBody"></tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 px-3 pb-3"
      >
        <div class="text-muted small" id="userPaginationInfo"></div>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="userPagination"></ul>
        </nav>
      </div>
    </section>
  </div>
</main>
