<script>
  // =========================================================
  // STATE
  // =========================================================
  let allBranches = []; // full dataset from server
  let filteredBranches = []; // after search filter applied
  let currentPage = 1;
  const PAGE_SIZE = 4;

  const Toast = Swal.mixin({
    toast: true,
    position: "top-end",
    showConfirmButton: false,
    timer: 2500,
    timerProgressBar: true,
  });

  $(document).ready(function () {
    loadBranches();
    loadBranchDropdown();

    // ADD BRANCH
    $("#saveBranchBtn").click(function () {
      addBranch();
    });

    // UPDATE BRANCH
    $("#updateBranchBtn").click(function () {
      updateBranch();
    });

    // SEARCH (client-side, integrates with pagination)
    $("#branchSearchInput").on("keyup", function () {
      applyFilterAndRender($(this).val());
    });

    // PRINT
    $("#printBranchBtn").click(function () {
      printBranchTable();
    });

    // EXPORT EXCEL
    $("#exportExcelBtn").click(function () {
      exportToExcel();
    });

    // BULK UPLOAD SUBMIT
    $("#submitBulkUploadBtn").click(function () {
      submitBulkUpload();
    });
  });

  // ======================================================
  // LOAD BRANCH TABLE
  // ======================================================
  function loadBranches() {
    $.ajax({
      url: "/branch/get-branches",
      method: "GET",
      success: function (data) {
        allBranches = data || [];
        applyFilterAndRender($("#branchSearchInput").val() || "");
      },
      error: function (err) {
        console.log("LOAD BRANCH ERROR:", err);
        Toast.fire({ icon: "error", title: "Failed to load branches." });
      },
    });
  }

  // ======================================================
  // SEARCH + PAGINATE
  // ======================================================
  function applyFilterAndRender(term) {
    const search = (term || "").trim().toLowerCase();

    filteredBranches = !search
      ? allBranches.slice()
      : allBranches.filter((b) => {
          return (
            String(b.branch_name || "")
              .toLowerCase()
              .includes(search) ||
            String(b.company_name || "")
              .toLowerCase()
              .includes(search) ||
            String(b.address || "")
              .toLowerCase()
              .includes(search) ||
            String(b.contact_number || "")
              .toLowerCase()
              .includes(search)
          );
        });

    currentPage = 1;
    renderTable();
    renderPagination();
  }

  // ======================================================
  // RENDER TABLE (fixed height — always PAGE_SIZE rows tall)
  // ======================================================
  function renderTable() {
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = filteredBranches.slice(start, start + PAGE_SIZE);

    let rows = "";

    pageItems.forEach((item) => {
      rows += `
        <tr>
          <td>${item.id}</td>
          <td title="${escapeHtml(item.branch_name)}">${item.branch_name}</td>
          <td title="${escapeHtml(item.company_name)}">${item.company_name}</td>
          <td title="${escapeHtml(item.address)}">${item.address}</td>
          <td>${item.contact_number}</td>
          <td>
            <button
              type="button"
              class="btn btn-warning btn-sm editBranchBtn"
              data-id="${item.id}">
              <i class="bi bi-pencil"></i>
            </button>
          </td>
        </tr>
      `;
    });

    // Filler rows keep the table the same height whether it has 1 or PAGE_SIZE rows
    for (let i = pageItems.length; i < PAGE_SIZE; i++) {
      rows += `
        <tr>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
          <td class="filler-row">&nbsp;</td>
        </tr>
      `;
    }

    if (filteredBranches.length === 0) {
      rows = `
        <tr>
          <td colspan="6" class="text-center text-muted py-4">No branches found</td>
        </tr>
      `;
      for (let i = 1; i < PAGE_SIZE; i++) {
        rows += `
          <tr>
            <td class="filler-row">&nbsp;</td>
            <td class="filler-row">&nbsp;</td>
            <td class="filler-row">&nbsp;</td>
            <td class="filler-row">&nbsp;</td>
            <td class="filler-row">&nbsp;</td>
            <td class="filler-row">&nbsp;</td>
          </tr>
        `;
      }
    }

    $("#branchTableBody").html(rows);

    const total = filteredBranches.length;
    const shownStart = total === 0 ? 0 : start + 1;
    const shownEnd = Math.min(start + PAGE_SIZE, total);
    $("#branchPageInfo").text(
      total === 0
        ? "No results"
        : `Showing ${shownStart}-${shownEnd} of ${total}`,
    );
  }

  // ======================================================
  // PAGINATION CONTROLS
  // ======================================================
  function renderPagination() {
    const totalPages = Math.max(
      1,
      Math.ceil(filteredBranches.length / PAGE_SIZE),
    );

    let html = "";

    html += `
      <li class="page-item ${currentPage === 1 ? "disabled" : ""}">
        <a class="page-link" href="#" data-page="${currentPage - 1}">Prev</a>
      </li>
    `;

    for (let p = 1; p <= totalPages; p++) {
      html += `
        <li class="page-item ${p === currentPage ? "active" : ""}">
          <a class="page-link" href="#" data-page="${p}">${p}</a>
        </li>
      `;
    }

    html += `
      <li class="page-item ${currentPage === totalPages ? "disabled" : ""}">
        <a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>
      </li>
    `;

    $("#branchPagination").html(html);
  }

  $(document).on("click", "#branchPagination .page-link", function (e) {
    e.preventDefault();
    const page = parseInt($(this).data("page"), 10);
    const totalPages = Math.max(
      1,
      Math.ceil(filteredBranches.length / PAGE_SIZE),
    );

    if (isNaN(page) || page < 1 || page > totalPages) return;

    currentPage = page;
    renderTable();
    renderPagination();
  });

  // ======================================================
  // EDIT BRANCH
  // ======================================================
  $(document).on("click", ".editBranchBtn", function () {
    const id = $(this).data("id");
    editBranch(id);
  });

  function editBranch(id) {
    $.ajax({
      url: "/branch/get-branch/" + id,
      method: "GET",
      dataType: "json",

      success: function (branch) {
        $("#edit_branch_id").val(branch.id);
        $("#edit_branch_name").val(branch.branch_name);
        $("#edit_company_name").val(branch.company_name);
        $("#edit_address").val(branch.address);
        $("#edit_email").val(branch.email);
        $("#edit_contact_number").val(branch.contact_number);

        $("#editBranchModal").modal("show");
      },

      error: function (err) {
        console.log("GET BRANCH ERROR:", err);

        Toast.fire({
          icon: "error",
          title: err.responseJSON?.message || "Failed to load branch.",
        });
      },
    });
  }

  // ======================================================
  // ADD BRANCH
  // ======================================================
  function addBranch() {
    const data = {
      branch_name: $("#branch_name").val().trim(),
      company_name: $("#company_name").val().trim(),
      address: $("#address").val().trim(),
      email: $("#email").val().trim(),
      contact_number: $("#contact_number").val().trim(),
    };

    if (data.branch_name === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Branch Name." });
      $("#branch_name").focus();
      return;
    }

    if (data.company_name === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Company Name." });
      $("#company_name").focus();
      return;
    }

    if (data.address === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Address." });
      $("#address").focus();
      return;
    }

    if (data.email === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Email Address." });
      $("#email").focus();
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(data.email)) {
      Toast.fire({
        icon: "warning",
        title: "Please enter a valid Email Address.",
      });
      $("#email").focus();
      return;
    }

    if (data.contact_number === "") {
      Toast.fire({
        icon: "warning",
        title: "Please enter the Contact Number.",
      });
      $("#contact_number").focus();
      return;
    }

    const phoneRegex = /^[0-9]{11}$/;
    if (!phoneRegex.test(data.contact_number)) {
      Toast.fire({
        icon: "warning",
        title: "Contact Number must be exactly 11 digits.",
      });
      $("#contact_number").focus();
      return;
    }

    $.ajax({
      url: "/branch/add-branch",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(data),

      success: function () {
        Toast.fire({ icon: "success", title: "Branch added successfully" });

        $("#addBranchForm")[0].reset();
        $("#addBranchModal").modal("hide");

        loadBranches();
        loadBranchDropdown();
      },

      error: function (err) {
        Toast.fire({
          icon: "error",
          title: err.responseJSON?.message || "Failed to add branch.",
        });
      },
    });
  }

  // ======================================================
  // UPDATE BRANCH
  // ======================================================
  function updateBranch() {
    const data = {
      id: $("#edit_branch_id").val(),
      branch_name: $("#edit_branch_name").val().trim(),
      company_name: $("#edit_company_name").val().trim(),
      address: $("#edit_address").val().trim(),
      email: $("#edit_email").val().trim(),
      contact_number: $("#edit_contact_number").val().trim(),
    };

    if (data.branch_name === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Branch Name." });
      $("#edit_branch_name").focus();
      return;
    }

    if (data.company_name === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Company Name." });
      $("#edit_company_name").focus();
      return;
    }

    if (data.address === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Address." });
      $("#edit_address").focus();
      return;
    }

    if (data.email === "") {
      Toast.fire({ icon: "warning", title: "Please enter the Email Address." });
      $("#edit_email").focus();
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(data.email)) {
      Toast.fire({
        icon: "warning",
        title: "Please enter a valid Email Address.",
      });
      $("#edit_email").focus();
      return;
    }

    if (data.contact_number === "") {
      Toast.fire({
        icon: "warning",
        title: "Please enter the Contact Number.",
      });
      $("#edit_contact_number").focus();
      return;
    }

    const phoneRegex = /^[0-9]{11}$/;
    if (!phoneRegex.test(data.contact_number)) {
      Toast.fire({
        icon: "warning",
        title: "Contact Number must be exactly 11 digits.",
      });
      $("#edit_contact_number").focus();
      return;
    }

    $.ajax({
      url: "/branch/update-branch",
      method: "PUT",
      contentType: "application/json",
      data: JSON.stringify(data),

      success: function () {
        Toast.fire({ icon: "success", title: "Branch updated successfully" });

        $("#editBranchModal").modal("hide");

        loadBranches();
        loadBranchDropdown();
      },

      error: function (err) {
        Toast.fire({
          icon: "error",
          title: err.responseJSON?.message || "Update failed",
        });
      },
    });
  }

  // ======================================================
  // LOAD BRANCH INTO USER DROPDOWN
  // ======================================================
  function loadBranchDropdown() {
    $.ajax({
      url: "/branch/get-branches",
      method: "GET",
      success: function (data) {
        let options = `<option value="">Select Branch</option>`;

        data.forEach((branch) => {
          options += `
            <option value="${branch.id}">
              ${branch.branch_name}
            </option>
          `;
        });

        $("#branch_id").html(options);
      },
    });
  }

  // ======================================================
  // PRINT
  // ======================================================
  function printBranchTable() {
    const rows = filteredBranches
      .map(
        (b) => `
        <tr>
          <td>${b.id}</td>
          <td>${escapeHtml(b.branch_name)}</td>
          <td>${escapeHtml(b.company_name)}</td>
          <td>${escapeHtml(b.address)}</td>
          <td>${escapeHtml(b.email || "")}</td>
          <td>${escapeHtml(b.contact_number)}</td>
        </tr>
      `,
      )
      .join("");

    const html = `
      <html>
        <head>
          <title>Branch List</title>
          <style>
            body { font-family: Arial, sans-serif; padding: 24px; }
            h2 { margin-bottom: 4px; }
            .meta { color: #666; margin-bottom: 16px; font-size: 12px; }
            table { width: 100%; border-collapse: collapse; }
            th, td { border: 1px solid #ccc; padding: 8px; font-size: 12px; text-align: left; }
            th { background: #f1f1f1; }
          </style>
        </head>
        <body>
          <h2>Branch List</h2>
          <div class="meta">Generated ${new Date().toLocaleString()} &middot; ${filteredBranches.length} record(s)</div>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Branch Name</th>
                <th>Company Name</th>
                <th>Address</th>
                <th>Email</th>
                <th>Contact Number</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </body>
      </html>
    `;

    const printWindow = window.open("", "_blank");
    printWindow.document.write(html);
    printWindow.document.close();
    printWindow.focus();
    printWindow.onload = function () {
      printWindow.print();
    };
  }

  // ======================================================
  // EXPORT EXCEL (client-side, via SheetJS)
  // ======================================================
  function exportToExcel() {
    if (typeof XLSX === "undefined") {
      Toast.fire({ icon: "error", title: "Excel export library not loaded." });
      return;
    }

    if (!filteredBranches.length) {
      Toast.fire({ icon: "info", title: "There are no branches to export." });
      return;
    }

    // Sort by Branch ID ascending
    const sortedBranches = [...filteredBranches].sort((a, b) => {
      return Number(a.id) - Number(b.id);
    });

    const data = sortedBranches.map((b) => ({
      "Branch ID": b.id,
      "Branch Name": b.branch_name,
      "Company Name": b.company_name,
      Address: b.address,
      Email: b.email || "",
      "Contact Number": b.contact_number,
    }));

    const worksheet = XLSX.utils.json_to_sheet(data);

    worksheet["!cols"] = [
      { wch: 10 },
      { wch: 24 },
      { wch: 24 },
      { wch: 36 },
      { wch: 26 },
      { wch: 16 },
    ];

    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Branches");

    const filename = `branches_${new Date().toISOString().slice(0, 10)}.xlsx`;
    XLSX.writeFile(workbook, filename);

    Toast.fire({ icon: "success", title: "Excel file downloaded." });
  }

  // ======================================================
  // BULK UPLOAD
  // ======================================================
  function submitBulkUpload() {
    const fileInput = document.getElementById("bulkUploadFile");
    const file = fileInput.files[0];

    if (!file) {
      Toast.fire({ icon: "warning", title: "Please choose a file to upload." });
      return;
    }

    const formData = new FormData();
    formData.append("file", file);

    const $btn = $("#submitBulkUploadBtn");
    $btn
      .prop("disabled", true)
      .html('<i class="bi bi-hourglass-split"></i> Uploading...');

    $.ajax({
      url: "/branch/bulk-upload",
      method: "POST",
      data: formData,
      processData: false,
      contentType: false,

      success: function (res) {
        Toast.fire({
          icon: "success",
          title: res.message || "Bulk upload complete.",
        });

        $("#bulkUploadFile").val("");
        $("#bulkUploadModal").modal("hide");

        loadBranches();
        loadBranchDropdown();
      },

      error: function (err) {
        Toast.fire({
          icon: "error",
          title: err.responseJSON?.message || "Bulk upload failed.",
        });
      },

      complete: function () {
        $btn
          .prop("disabled", false)
          .html('<i class="bi bi-cloud-upload"></i> Upload');
      },
    });
  }

  // ======================================================
  // UTIL
  // ======================================================
  function escapeHtml(str) {
    if (str === null || str === undefined) return "";
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatDate(date) {
    return date ? new Date(date).toLocaleString() : "";
  }
</script>
