<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-activity"></i>
            <span style="font-weight: 700; color: #000">
              Client Order Activity
            </span>
          </h2>

          <p class="text-muted mb-0">
            Track all client order actions and transaction activities.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <!-- SYNC -->
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search activity..."
          data-table-search="clientOrderActivityTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="clientOrderActivityTable"
          data-searchable-table
        >
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Order ID</th>
              <th>Date Time</th>
              <th>Action</th>
              <th>Full Name</th>
              <th>Remarks</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>SO-2026-05-0001</td>
              <td>May 28, 2026 08:45 AM</td>

              <td>
                <span class="badge text-bg-primary"> Created </span>
              </td>

              <td>Admin User</td>
              <td>New client order created.</td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>SO-2026-05-0002</td>
              <td>May 28, 2026 09:10 AM</td>

              <td>
                <span class="badge text-bg-warning"> Updated </span>
              </td>

              <td>Maria Santos</td>
              <td>Order quantity adjusted.</td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>SO-2026-05-0003</td>
              <td>May 28, 2026 10:15 AM</td>

              <td>
                <span class="badge text-bg-success"> Approved </span>
              </td>

              <td>Juan Dela Cruz</td>
              <td>Order approved for processing.</td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>SO-2026-05-0004</td>
              <td>May 28, 2026 11:20 AM</td>

              <td>
                <span class="badge text-bg-info"> Exported </span>
              </td>

              <td>Mark Cruz</td>
              <td>Order exported to Excel.</td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>SO-2026-05-0005</td>
              <td>May 28, 2026 01:30 PM</td>

              <td>
                <span class="badge text-bg-danger"> Cancelled </span>
              </td>

              <td>Anna Reyes</td>
              <td>Client cancelled the order request.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
