<div class="modal fade" id="addVehicleModal" tabindex="-1">
  <div
    class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
  >
    <div class="modal-content">
      <!-- Header -->
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-truck"></i>
          Add Vehicle
        </h5>

        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <!-- Vehicle Details -->
        <h6 class="fw-bold border-bottom pb-2 mb-3">Vehicle Details</h6>

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label"
              >Plate Number <span class="text-danger">*</span></label
            >
            <input
              type="text"
              id="add_plate_number"
              class="form-control"
              placeholder="ABC-1234"
            />
          </div>

          <div class="col-md-4">
            <label class="form-label"
              >Vehicle Type <span class="text-danger">*</span></label
            >
            <select id="add_vehicle_type" class="form-select">
              <option value="">Select Type</option>
              <option value="Truck">Truck</option>
              <option value="Van">Van</option>
              <option value="Motorcycle">Motorcycle</option>
              <option value="Trailer">Trailer</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Weight Capacity (kg)</label>
            <input
              type="number"
              id="add_capacity"
              class="form-control"
              placeholder="5000"
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Brand</label>
            <input
              type="text"
              id="add_brand"
              class="form-control"
              placeholder="Toyota"
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Model</label>
            <input
              type="text"
              id="add_model"
              class="form-control"
              placeholder="HiAce"
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Year Model</label>
            <input
              type="number"
              id="add_year_model"
              class="form-control"
              placeholder="2026"
            />
          </div>

          <div class="col-md-3">
            <label class="form-label">Color</label>
            <input
              type="text"
              id="add_color"
              class="form-control"
              placeholder="White"
            />
          </div>
        </div>

        <!-- Operations -->
        <h6 class="fw-bold border-bottom pb-2 mt-4 mb-3">
          Operational Information
        </h6>

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Assigned Driver</label>
            <select id="add_driver_id" class="form-select">
              <option value="">Select Driver</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Fuel Type</label>
            <select id="add_fuel_type" class="form-select">
              <option value="Diesel">Diesel</option>
              <option value="Gasoline">Gasoline</option>
              <option value="Electric">Electric</option>
              <option value="Hybrid">Hybrid</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Current Mileage (km)</label>
            <input
              type="number"
              id="add_odometer"
              class="form-control"
              placeholder="0"
            />
          </div>

          <div class="col-md-4">
            <label class="form-label">Vehicle Status</label>
            <select id="add_status" class="form-select">
              <option value="Available" selected>Available</option>
              <option value="Assigned">Assigned</option>
              <option value="In Transit">In Transit</option>
              <option value="Maintenance">Maintenance</option>
              <option value="Unavailable">Unavailable</option>
            </select>
          </div>
        </div>

        <!-- Documents -->
        <h6 class="fw-bold border-bottom pb-2 mt-4 mb-3">
          Registration & Insurance
        </h6>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Registration Expiry</label>
            <input type="date" id="add_reg_expiry" class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Insurance Expiry</label>
            <input type="date" id="add_insurance_expiry" class="form-control" />
          </div>
        </div>

        <!-- Remarks -->
        <h6 class="fw-bold border-bottom pb-2 mt-4 mb-3">Remarks</h6>

        <textarea
          id="add_remarks"
          class="form-control"
          rows="4"
          placeholder="Enter remarks (optional)..."
        >
        </textarea>
      </div>

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle"></i>
          Cancel
        </button>

        <button type="button" class="btn btn-primary" id="saveVehicleBtn">
          <i class="bi bi-save"></i>
          Save Vehicle
        </button>
      </div>
    </div>
  </div>
</div>

