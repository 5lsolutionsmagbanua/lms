<!-- BULK UPLOAD MODAL -->
<div class="modal fade" id="bulkUploadVehicleModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-upload"></i> Bulk Upload Vehicles
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="template-download-card">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box">
              <i class="bi bi-file-earmark-spreadsheet"></i>
            </div>
            <div>
              <div class="fw-semibold">Vehicle Upload Template</div>
              <small class="text-muted"
                >.xlsx &middot; plate_number, vehicle_type, brand, model,
                capacity, and more</small
              >
            </div>
          </div>
          <a
            href="/vehicle/bulk/template"
            class="btn btn-success btn-sm"
            id="downloadVehicleTemplateBtn"
          >
            <i class="bi bi-download"></i> Download Template
          </a>
        </div>

        <p class="text-muted small mb-2">
          <code>plate_number</code> and <code>vehicle_type</code> are required;
          <code>driver_code</code> is optional and must match an available
          driver (see the template's reference sheet). Every uploaded vehicle
          starts as "Available". Max 1000 rows, 5MB.
        </p>

        <label>Select Excel or CSV File</label>
        <input
          type="file"
          id="bulkUploadVehicleFile"
          class="form-control"
          accept=".xlsx,.xls,.csv"
        />

        <div id="bulkUploadVehicleReport" class="mt-3 d-none">
          <div id="bulkUploadVehicleSummary" class="fw-bold mb-2"></div>
          <div
            id="bulkUploadVehicleErrors"
            class="small text-danger"
            style="max-height: 180px; overflow-y: auto"
          ></div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-success" id="bulkUploadVehicleSubmitBtn">
          <i class="bi bi-cloud-upload"></i> Upload File
        </button>
      </div>
    </div>
  </div>
</div>

<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <section class="panel">
      <!-- Header -->
      <div
        class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 p-4 border-bottom"
      >
        <div class="d-flex align-items-center gap-3">
          <div class="header-icon-box">
            <i class="bi bi-truck"></i>
          </div>
          <div>
            <h2 class="h5 mb-1 section-title">Vehicle Management</h2>
            <p class="text-muted mb-0">
              Manage company vehicles used for deliveries and shipment
              operations.
            </p>
          </div>
        </div>

        <div class="d-flex gap-2 flex-wrap vehicle-toolbar">
          <button
            class="btn btn-outline-secondary rounded-pill fw-semibold"
            id="printVehicleBtn"
            type="button"
          >
            <i class="bi bi-printer"></i> Print
          </button>

          <button
            class="btn btn-outline-success rounded-pill fw-semibold"
            id="exportVehicleExcelBtn"
            type="button"
          >
            <i class="bi bi-file-earmark-excel"></i> Export Excel
          </button>

          <button
            class="btn btn-outline-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#bulkUploadVehicleModal"
            type="button"
          >
            <i class="bi bi-upload"></i> Bulk Upload
          </button>

          <button
            class="btn btn-primary rounded-pill fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#addVehicleModal"
            type="button"
          >
            <i class="bi bi-plus-circle"></i>
            Add Vehicle
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="p-3 border-bottom">
        <div class="row g-2">
          <div class="col-12 col-md-2">
            <select class="form-select form-select-sm" id="entriesPerPage">
              <option value="4" selected>4 Entries</option>
              <option value="10">10 Entries</option>
              <option value="25">25 Entries</option>
              <option value="50">50 Entries</option>
            </select>
          </div>

          <div class="col-12 col-md-4">
            <input
              type="search"
              id="vehicleSearchInput"
              class="form-control form-control-sm"
              placeholder="Search vehicle..."
            />
          </div>

          <div class="col-12 col-md-3 ms-md-auto">
            <select class="form-select form-select-sm" id="filterStatus">
              <option value="">All Status</option>
              <option value="Available">Available</option>
              <option value="Assigned">Assigned</option>
              <option value="In Transit">In Transit</option>
              <option value="Maintenance">Maintenance</option>
              <option value="Unavailable">Unavailable</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="vehicleTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Code</th>
              <th>Plate Number</th>
              <th>Type</th>
              <th>Brand</th>
              <th>Model</th>
              <th>Capacity</th>
              <th>Assigned Driver</th>
              <th>Registration Expiry</th>
              <th>Insurance Expiry</th>
              <th>Status</th>
              <th>Remarks</th>
              <th>Created At</th>
              <th>Created By</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody id="vehicleTableBody"></tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 px-3 py-3"
      >
        <div class="text-muted small" id="vehiclePaginationInfo"></div>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="vehiclePagination"></ul>
        </nav>
      </div>
    </section>
  </div>
</main>
