<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-box-arrow-in-down"></i>

            <span style="font-weight: 700; color: #000">
              Purchase Order Receiving Report
            </span>
          </h2>

          <p class="text-muted mb-0">
            Track inbound deliveries, receiving records, and export reports.
          </p>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

          <button class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel"></i>
            Batch Export Excel
          </button>

          <button
            class="btn btn-sm btn-warning"
            data-bs-toggle="modal"
            data-bs-target="#receivingReportDateRangeModal"
          >
            <i class="bi bi-calendar-range"></i>
            Select Date Range
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search receiving report..."
          data-table-search="receivingReportTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="receivingReportTable"
          data-searchable-table
        >
          <thead class="table-dark text-white">
            <tr>
              <th>ID</th>
              <th>Purchase ID</th>
              <th>Inbound Carrier</th>
              <th>DR Invoice</th>
              <th>DR Invoice Date</th>
              <th>Shipped Via</th>
              <th>Number</th>
              <th>Remarks</th>
              <th>Created At</th>
              <th>Created By</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>PO-26-01-001</td>
              <td>LBC Express</td>
              <td>DR-10001</td>
              <td>May 29, 2026</td>
              <td>Truck Delivery</td>
              <td>RR-0001</td>
              <td>Complete delivery received</td>
              <td>May 29, 2026</td>
              <td>Admin</td>

              <td class="text-end">
                <!-- VIEW -->
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewReceivingReportModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <!-- EDIT -->
                <button
                  class="btn btn-warning btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#editReceivingReportModal"
                >
                  <i class="bi bi-pencil"></i>
                </button>

                <!-- DELETE -->
                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>

                <!-- EXPORT -->
                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportReceivingReportModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>
              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>PO-26-01-002</td>
              <td>J&T Express</td>
              <td>DR-10002</td>
              <td>May 28, 2026</td>
              <td>Air Freight</td>
              <td>RR-0002</td>
              <td>Partial items received</td>
              <td>May 28, 2026</td>
              <td>Maria Santos</td>

              <td class="text-end">
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewReceivingReportModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <button
                  class="btn btn-warning btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#editReceivingReportModal"
                >
                  <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>

                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportReceivingReportModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<!-- ================= DATE RANGE MODAL ================= -->
<div class="modal fade" id="receivingReportDateRangeModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-calendar-range"></i>
          Select Date Range
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">From Start Date</label>
          <input type="date" class="form-control" />
        </div>

        <div class="mb-3">
          <label class="form-label">To End Date</label>
          <input type="date" class="form-control" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-primary">
          <i class="bi bi-search"></i>
          Fetch
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================= VIEW MODAL ================= -->
<div class="modal fade" id="viewReceivingReportModal">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title">
          <i class="bi bi-eye"></i>
          Receiving Details
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Receiving ID</th>
              <th>Product Code</th>
              <th>Product Name</th>
              <th>Branch</th>
              <th>Quantity</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>RR-0001</td>
              <td>PRD-1001</td>
              <td>Barcode Scanner</td>
              <td>Quezon City</td>
              <td>10</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editReceivingReportModal">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-pencil"></i>
          Edit Receiving Report
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div class="row g-2">
          <div class="col-md-3">
            <label class="form-label">Inbound Carrier</label>
            <input class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">DR Invoice</label>
            <input class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Invoice Date</label>
            <input type="date" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Shipped Via</label>
            <input class="form-control" />
          </div>
        </div>

        <hr />

        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead class="table-dark">
              <tr>
                <th>Product</th>
                <th>Product Code</th>
                <th>Branch</th>
                <th>Quantity</th>
                <th>New Quantity</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Barcode Scanner</td>
                <td>PRD-1001</td>
                <td>QC Branch</td>
                <td>10</td>
                <td><input class="form-control form-control-sm" /></td>
              </tr>
            </tbody>
          </table>
        </div>

        <button class="btn btn-primary mt-2">Submit Update</button>
      </div>
    </div>
  </div>
</div>

<!-- ================= EXPORT MODAL ================= -->
<div class="modal fade" id="exportReceivingReportModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-box-arrow-up"></i>
          Ready to Export
        </h5>
        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Checked By</label>
          <input class="form-control" />
        </div>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           

        <div class="mb-3">
          <label class="form-label">Order ID</label>
          <input class="form-control" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i>
          Excel
        </button>

        <button class="btn btn-danger">
          <i class="bi bi-file-earmark-pdf"></i>
          PDF
        </button>
      </div>
    </div>
  </div>
</div>
