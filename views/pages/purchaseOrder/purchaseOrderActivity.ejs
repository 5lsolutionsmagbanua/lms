<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">

    <!-- PANEL -->
    <section class="panel">

      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >

        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-clock-history"></i>

            <span style="font-weight:700; color:#000;">
              Purchase Order Activity
            </span>
          </h2>

          <p class="text-muted mb-0">
            Monitor all purchase order transactions and activity logs.
          </p>
        </div>

        <!-- ACTION -->
        <div class="d-flex flex-wrap gap-2">

          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">

        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search purchase order activity..."
          data-table-search="purchaseOrderActivityTable"
        />

      </div>

      <!-- TABLE -->
      <div class="table-responsive">

        <table
          class="table align-middle mb-0"
          id="purchaseOrderActivityTable"
          data-searchable-table
        >

          <thead class="table-dark text-white">

            <tr>
              <th>ID</th>
              <th>ORDER ID</th>
              <th>DATE TIME</th>
              <th>ACTIONS</th>
              <th>USER</th>
              <th>REMARKS</th>
            </tr>

          </thead>

          <tbody>

            <tr>
              <td class="fw-semibold">1</td>
              <td>PO-26-01-001</td>
              <td>May 29, 2026 08:15 AM</td>
              <td>
                <span class="badge text-bg-primary">
                  Created
                </span>
              </td>
              <td>Admin User</td>
              <td>Purchase order successfully created</td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>PO-26-01-002</td>
              <td>May 29, 2026 09:05 AM</td>
              <td>
                <span class="badge text-bg-warning">
                  Updated
                </span>
              </td>
              <td>Maria Santos</td>
              <td>Updated product quantity</td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>PO-26-01-003</td>
              <td>May 29, 2026 10:10 AM</td>
              <td>
                <span class="badge text-bg-success">
                  Approved
                </span>
              </td>
              <td>Juan Dela Cruz</td>
              <td>Purchase order approved by manager</td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>PO-26-01-004</td>
              <td>May 29, 2026 11:20 AM</td>
              <td>
                <span class="badge text-bg-info">
                  Exported
                </span>
              </td>
              <td>Mark Cruz</td>
              <td>Exported purchase order to Excel</td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>PO-26-01-005</td>
              <td>May 29, 2026 01:45 PM</td>
              <td>
                <span class="badge text-bg-danger">
                  Deleted
                </span>
              </td>
              <td>Anna Reyes</td>
              <td>Removed product item from purchase order</td>
            </tr>

          </tbody>

        </table>

      </div>

    </section>

  </div>
</main>