<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <!-- PANEL -->
    <section class="panel">
      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-clock-history"></i>
            <span style="font-weight: 700; color: #000">
              Purchase Request Activity
            </span>
          </h2>

          <p class="text-muted mb-0">
            Monitor request processing history and user activities.
          </p>
        </div>

        <!-- ACTION -->
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search request activity..."
          data-table-search="purchaseRequestActivityTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="purchaseRequestActivityTable"
          data-searchable-table
        >
          <thead class="table-dark text-white">
            <tr>
              <th>ID</th>
              <th>Request ID</th>
              <th>Date Time</th>
              <th>Action History</th>
              <th>User</th>
              <th>Remarks</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="fw-semibold">1</td>
              <td>REQ-2026-0001</td>
              <td>May 28, 2026 08:30 AM</td>
              <td>
                <span class="badge text-bg-success"> Request Approved </span>
              </td>
              <td>Admin</td>
              <td>Approved by purchasing manager</td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>REQ-2026-0002</td>
              <td>May 28, 2026 09:15 AM</td>
              <td>
                <span class="badge text-bg-warning"> Pending Review </span>
              </td>
              <td>Maria Santos</td>
              <td>Waiting for warehouse confirmation</td>
            </tr>

            <tr>
              <td class="fw-semibold">3</td>
              <td>REQ-2026-0003</td>
              <td>May 28, 2026 10:05 AM</td>
              <td>
                <span class="badge text-bg-primary"> Request Created </span>
              </td>
              <td>Juan Dela Cruz</td>
              <td>New request submitted</td>
            </tr>

            <tr>
              <td class="fw-semibold">4</td>
              <td>REQ-2026-0004</td>
              <td>May 28, 2026 11:40 AM</td>
              <td>
                <span class="badge text-bg-danger"> Request Rejected </span>
              </td>
              <td>Mark Cruz</td>
              <td>Invalid product quantity</td>
            </tr>

            <tr>
              <td class="fw-semibold">5</td>
              <td>REQ-2026-0005</td>
              <td>May 28, 2026 01:20 PM</td>
              <td>
                <span class="badge text-bg-info"> Exported to PDF </span>
              </td>
              <td>Admin</td>
              <td>Purchase request exported successfully</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
