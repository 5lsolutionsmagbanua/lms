<main class="dashboard-content">
  <div class="container-fluid px-3 px-lg-4 py-4">

    <!-- PANEL -->
    <section class="panel">

      <!-- HEADER -->
      <div
        class="panel-header d-flex flex-wrap gap-2 justify-content-between align-items-center"
      >

        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-cart-plus"></i>
            <span style="font-weight:700; color:#000;">
              Purchase Request
            </span>
          </h2>

          <p class="text-muted mb-0">
            Manage purchase requests and vendor requisitions.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

          <!-- SYNC -->
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i>
            Sync
          </button>

          <!-- UPLOAD -->
          <button class="btn btn-sm btn-success">
            <i class="bi bi-upload"></i>
            Upload Excel
          </button>

          <!-- DOWNLOAD -->
          <button class="btn btn-sm btn-dark">
            <i class="bi bi-download"></i>
            Download Excel
          </button>

          <!-- DATE RANGE -->
          <button
            class="btn btn-sm btn-warning"
            data-bs-toggle="modal"
            data-bs-target="#purchaseDateRangeModal"
          >
            <i class="bi bi-calendar-range"></i>
            Select Date Range
          </button>

          <!-- ADD REQUEST -->
          <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addPurchaseRequestModal"
          >
            <i class="bi bi-plus-circle"></i>
            Add Request
          </button>

        </div>
      </div>

      <!-- SEARCH -->
      <div class="px-3 pb-2">
        <input
          class="form-control form-control-sm table-search"
          type="search"
          placeholder="Search purchase request..."
          data-table-search="purchaseRequestTable"
        />
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table
          class="table align-middle mb-0"
          id="purchaseRequestTable"
          data-searchable-table
        >

          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Date</th>
              <th>Vendor Name</th>
              <th>Order ID</th>
              <th>Client Name</th>
              <th>Processed By</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>

            <tr>
              <td class="fw-semibold">1</td>
              <td>May 28, 2026</td>
              <td>ABC Trading Corp</td>
              <td>ORD-2026-0001</td>
              <td>Metro Retail</td>
              <td>Admin</td>

              <td>
                <span class="badge text-bg-success">
                  Approved
                </span>
              </td>

              <td class="text-end">

                <!-- VIEW -->
                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewPurchaseModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <!-- EXPORT -->
                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportPurchaseModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>

              </td>
            </tr>

            <tr>
              <td class="fw-semibold">2</td>
              <td>May 27, 2026</td>
              <td>Global Supply</td>
              <td>ORD-2026-0002</td>
              <td>Skyline Store</td>
              <td>Maria Santos</td>

              <td>
                <span class="badge text-bg-warning">
                  Pending
                </span>
              </td>

              <td class="text-end">

                <button
                  class="btn btn-info btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#viewPurchaseModal"
                >
                  <i class="bi bi-eye"></i>
                </button>

                <button
                  class="btn btn-success btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#exportPurchaseModal"
                >
                  <i class="bi bi-box-arrow-up"></i>
                </button>

              </td>
            </tr>

          </tbody>

        </table>
      </div>

    </section>
  </div>
</main>

<!-- ================================================= -->
<!-- DATE RANGE MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="purchaseDateRangeModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header bg-warning">
        <h5 class="modal-title">
          <i class="bi bi-calendar-range"></i>
          Select Date Range
        </h5>

        <button
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">

        <div class="mb-3">
          <label class="form-label">
            From Start Date
          </label>

          <input type="date" class="form-control" />
        </div>

        <div class="mb-3">
          <label class="form-label">
            To End Date
          </label>

          <input type="date" class="form-control" />
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-primary">
          <i class="bi bi-search"></i>
          Fetch
        </button>
      </div>

    </div>
  </div>
</div>

<!-- ================================================= -->
<!-- VIEW PURCHASE DETAILS MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="viewPurchaseModal">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header bg-info text-white">
        <h5 class="modal-title">
          <i class="bi bi-eye"></i>
          Purchase Request Details
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">

        <div class="table-responsive">
          <table class="table table-bordered align-middle">

            <thead class="table-dark">
              <tr>
                <th>SO ID</th>
                <th>Request ID</th>
                <th>Product Code</th>
                <th>Product Description</th>
                <th>Branch Name</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody>

              <tr>

                <td>SO-26-01-003</td>
                <td>REQ-0001</td>
                <td>PRD-1001</td>
                <td>Wireless Barcode Scanner</td>
                <td>Quezon City Branch</td>
                <td>10</td>
                <td>PCS</td>
                <td>₱5,500</td>
                <td>₱55,000</td>

                <td>
                  <span class="badge text-bg-success">
                    Approved
                  </span>
                </td>

                <td>
                  <button class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>

              </tr>

              <tr>

                <td>SO-26-01-004</td>
                <td>REQ-0002</td>
                <td>PRD-1002</td>
                <td>Shipping Box Large</td>
                <td>Manila Branch</td>
                <td>50</td>
                <td>BOX</td>
                <td>₱120</td>
                <td>₱6,000</td>

                <td>
                  <span class="badge text-bg-warning">
                    Pending
                  </span>
                </td>

                <td>
                  <button class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>

              </tr>

            </tbody>

          </table>
        </div>

      </div>

    </div>
  </div>
</div>

<!-- ================================================= -->
<!-- EXPORT MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="exportPurchaseModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          <i class="bi bi-box-arrow-up"></i>
          Ready to Export
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">

        <div class="mb-3">
          <label class="form-label">
            Requisitioned By
          </label>

          <input
            type="text"
            class="form-control"
            placeholder="Enter requisitioned by"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">
            Checked By
          </label>

          <input
            type="text"
            class="form-control"
            placeholder="Enter checked by"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">
            Order ID
          </label>

          <input
            type="text"
            class="form-control"
            value="ORD-2026-0001"
          />
        </div>

      </div>

      <div class="modal-footer">

        <button class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i>
          Export Excel
        </button>

        <button class="btn btn-danger">
          <i class="bi bi-file-earmark-pdf"></i>
          Export PDF
        </button>

      </div>

    </div>
  </div>
</div>